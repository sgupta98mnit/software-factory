+              {copy.pipeline.stages[stage]}
+            </span>
+            <span className="text-xs tabular-nums text-muted">
+              {/* A passed lane with nothing in it stays quiet. */}
+              {i >= 2 &&
+              run.workOrders.length > 0 &&
+              (count > 0 || here || live)
+                ? copy.pipeline.stageCount(count)
+                : " "}
+            </span>
+          </li>
+        );
+      })}
+    </ol>
+  );
+}
+
+function WorkOrderCard({
