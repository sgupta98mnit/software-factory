+import React from "react";
+import { TriangleAlert } from "lucide-react";
+import { ModalBackdrop } from "#/components/shared/modals/modal-backdrop";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { displaySuccessToast } from "#/utils/custom-toast-handlers";
+import { cn } from "#/utils/utils";
+import type { WorkOrder } from "../api";
+import { useFactoryCopy } from "../copy";
+import { useSetWorkOrderStatus } from "../hooks";
+import { factoryFieldClassName } from "./start-agent-modal";
+import { FactoryError } from "./factory-page";
+
+interface ApproveModalProps {
+  workOrder: WorkOrder;
+  finalStatus: string;
+  /** Work orders this one depends on that aren't approved yet. */
+  openDependencies?: string[];
+  onClose: () => void;
+}
+
+/** A person's approval: moves the work order to the final status and records who and why. */
+export function ApproveModal({
+  workOrder,
+  finalStatus,
+  openDependencies = [],
+  onClose,
+}: ApproveModalProps) {
+  const copy = useFactoryCopy();
+  const setStatus = useSetWorkOrderStatus();
+  const [note, setNote] = React.useState("");
+  const unmet = workOrder.acceptanceCriteria.filter((ac) => !ac.done).length;
+  const busy = setStatus.isPending;
+
+  const approve = () =>
+    setStatus.mutate(
+      {
+        id: workOrder.id,
+        status: finalStatus,
+        approve: true,
+        note: note.trim() || undefined,
+      },
+      {
+        onSuccess: () => {
+          displaySuccessToast(copy.approve.approved(workOrder.id));
+          onClose();
+        },
+      },
+    );
+
+  return (
+    <ModalBackdrop
+      onClose={busy ? undefined : onClose}
+      closeOnEscape={!busy}
+      aria-label={copy.approve.title(workOrder.id)}
+    >
+      <div
+        data-testid="factory-approve-modal"
+        className="flex w-full max-w-lg flex-col gap-4 rounded-xl border border-border bg-base-secondary p-5"
+      >
+        <h2 className="text-base font-semibold text-foreground">
+          {copy.approve.title(workOrder.id)}
+        </h2>
+        <p className="text-sm text-muted">{copy.approve.body(finalStatus)}</p>
+        {unmet > 0 ? <Warning text={copy.approve.unmet(unmet)} /> : null}
+        {openDependencies.length ? (
+          <Warning
+            text={copy.approve.openDependencies(
+              openDependencies.join(", "),
+              finalStatus,
+            )}
+          />
+        ) : null}
+        <div className="flex flex-col gap-1.5">
+          <label
+            htmlFor="factory-approve-note"
+            className="text-sm font-medium text-foreground"
+          >
+            {copy.approve.noteLabel}
+          </label>
+          <textarea
+            id="factory-approve-note"
+            className={cn(factoryFieldClassName, "min-h-20")}
+            placeholder={copy.approve.notePlaceholder}
+            value={note}
+            onChange={(e) => setNote(e.target.value)}
+            disabled={busy}
+          />
+        </div>
+        <FactoryError error={setStatus.error} />
+        <div className="flex justify-end gap-2">
+          <BrandButton
+            type="button"
+            variant="secondary"
+            onClick={onClose}
+            isDisabled={busy}
+          >
+            {copy.common.cancel}
+          </BrandButton>
+          <BrandButton
+            testId="factory-approve-confirm"
+            type="button"
+            variant="primary"
+            onClick={approve}
+            isDisabled={busy}
+            aria-busy={busy}
+          >
+            {busy ? copy.approve.approving : copy.approve.confirm}
+          </BrandButton>
+        </div>
+      </div>
+    </ModalBackdrop>
+  );
+}
+
+function Warning({ text }: { text: string }) {
+  return (
+    <p className="flex items-start gap-2 rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm text-foreground">
+      <TriangleAlert
+        className="mt-0.5 size-4 shrink-0 text-warning"
+        aria-hidden
+      />
+      {text}
+    </p>
+  );
+}
diff --git a/src/factory/components/autopilot-badges.tsx b/src/factory/components/autopilot-badges.tsx
new file mode 100644
index 0000000..c9bc963
--- /dev/null
+++ b/src/factory/components/autopilot-badges.tsx
@@ -0,0 +1,151 @@
+import { cn } from "#/utils/utils";
+import type { AutopilotWorkOrderState, RunState } from "../api";
+import { useFactoryCopy } from "../copy";
+
+type Tone = "active" | "waiting" | "good" | "bad" | "quiet";
+
+const DOT: Record<Tone, string> = {
+  active: "bg-primary",
+  waiting: "bg-warning",
+  good: "bg-success",
+  bad: "bg-danger",
+  quiet: "bg-muted",
+};
+
+const RUN_TONE: Record<RunState, Tone> = {
+  spec: "active",
+  critic: "active",
+  awaiting_spec_approval: "waiting",
+  awaiting_answers: "waiting",
+  awaiting_plan_approval: "waiting",
+  building: "active",
+  done: "good",
+  releasing: "active",
+  released: "good",
+  paused: "waiting",
+  failed: "bad",
+  cancelled: "quiet",
+};
+
+const WORK_ORDER_TONE: Record<AutopilotWorkOrderState, Tone> = {
+  pending: "quiet",
+  building: "active",
+  verifying: "active",
+  reviewing: "active",
+  ready: "active",
+  awaiting_merge_approval: "waiting",
+  merging: "active",
+  merged: "good",
+  needs_attention: "bad",
+  skipped: "quiet",
+  cancelled: "quiet",
+};
+
+/** Run states a person has to act on. */
+export const WAITING_RUN_STATES = new Set<RunState>([
+  "awaiting_spec_approval",
+  "awaiting_answers",
+  "awaiting_plan_approval",
+  "paused",
+]);
+export const FINISHED_RUN_STATES = new Set<RunState>([
+  "done",
+  "released",
+  "failed",
+  "cancelled",
+]);
+
+function Pill({
+  tone,
+  label,
+  testId,
+}: {
+  tone: Tone;
+  label: string;
+  testId?: string;
+}) {
+  return (
+    <span
+      data-testid={testId}
+      className="inline-flex shrink-0 items-center gap-1.5 text-xs"
+    >
+      <span
+        aria-hidden
+        className={cn(
+          "size-2 rounded-full",
+          DOT[tone],
+          tone === "active" && "animate-pulse",
+        )}
+      />
+      <span className="text-foreground">{label}</span>
+    </span>
+  );
+}
+
+export function RunStatePill({ state }: { state: RunState }) {
+  const copy = useFactoryCopy();
+  return (
+    <Pill
+      tone={RUN_TONE[state] ?? "quiet"}
+      label={copy.autopilot.runStates[state] ?? state}
+      testId="autopilot-run-state"
+    />
+  );
+}
+
+export function WorkOrderStatePill({
+  state,
+}: {
+  state: AutopilotWorkOrderState;
+}) {
+  const copy = useFactoryCopy();
+  return (
+    <Pill
+      tone={WORK_ORDER_TONE[state] ?? "quiet"}
+      label={copy.autopilot.workOrderStates[state] ?? state}
+    />
+  );
+}
+
+export function RiskChip({ risk }: { risk: "low" | "medium" | "high" }) {
+  const copy = useFactoryCopy();
+  return (
+    <span
+      className={cn(
+        "inline-flex items-center rounded-md border px-1.5 py-0.5 text-xs",
+        risk === "high"
+          ? "border-warning text-foreground"
+          : "border-border-subtle text-muted",
+      )}
+    >
+      {copy.autopilot.risk[risk] ?? risk}
+    </span>
+  );
+}
+
+/** Dollars: two decimals, and "<$0.01" for a cost that isn't zero but rounds to it. */
+export function formatMoney(usd: number, language: string) {
+  const format = new Intl.NumberFormat(language, {
+    style: "currency",
+    currency: "USD",
+  });
+  if (usd > 0 && usd < 0.01) return `<${format.format(0.01)}`;
+  return format.format(usd);
+}
+
+/** A rough, readable duration: "0.3 s", "40 s", "3 min", "1 h 20 min". */
+export function formatDuration(ms: number) {
+  if (ms < 10_000) return `${(Math.max(0, ms) / 1000).toFixed(1)} s`;
+  const s = Math.round(ms / 1000);
+  if (s < 60) return `${s} s`;
+  const min = Math.round(s / 60);
+  if (min < 60) return `${min} min`;
+  const h = Math.floor(min / 60);
+  const rest = min % 60;
+  return rest ? `${h} h ${rest} min` : `${h} h`;
+}
+
+/** "user:sumit" -> "sumit"; "policy@abc123" stays, since it names the exact rules. */
+export function approverName(actor: string) {
+  return actor.replace(/^user:/, "");
+}
diff --git a/src/factory/components/decision-card.tsx b/src/factory/components/decision-card.tsx
new file mode 100644
index 0000000..6fc67af
--- /dev/null
+++ b/src/factory/components/decision-card.tsx
@@ -0,0 +1,179 @@
+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Link } from "react-router";
+import { CircleCheck, Inbox } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { displaySuccessToast } from "#/utils/custom-toast-handlers";
+import { cn } from "#/utils/utils";
+import type { InboxItem, InboxOption } from "../api";
+import { useFactoryCopy } from "../copy";
+import { useDecide } from "../hooks";
+import { formatWhen } from "./factory-badges";
+import { approverName } from "./autopilot-badges";
+import { FactoryError } from "./factory-page";
+import { FactoryMarkdown } from "./factory-markdown";
+import { factoryFieldClassName } from "./start-agent-modal";
+
+const variantOf = (o: InboxOption) =>
+  o.tone === "primary"
+    ? "primary"
+    : o.tone === "danger"
+      ? "ghost-danger"
+      : "secondary";
+
+/**
+ * One inbox item: what the factory needs decided, why, and the choices. A
+ * choice that needs a note waits for one; a dangerous one (cancel) asks to
+ * confirm. Decided items show who chose what.
+ */
+export function DecisionCard({
+  item,
+  showRun = true,
+}: {
+  item: InboxItem;
+  /** Link to the run's pipeline (on the Inbox page; not on the pipeline itself). */
+  showRun?: boolean;
+}) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const decide = useDecide();
+  const [note, setNote] = React.useState("");
+  const [confirming, setConfirming] = React.useState<string | null>(null);
+  const [missingNote, setMissingNote] = React.useState<string | null>(null);
+  // The same item can be on the page twice (Inbox and a panel); ids stay unique.
+  const uid = React.useId();
+  const noteId = `factory-inbox-note-${uid}`;
+  const titleId = `factory-inbox-title-${uid}`;
+  const noteRef = React.useRef<HTMLTextAreaElement>(null);
+  const open = item.state === "open";
+  const busy = decide.isPending;
+  const wantsNote = item.options.some((o) => o.needsNote);
+
+  const choose = (option: InboxOption) => {
+    if (option.needsNote && !note.trim()) {
+      setMissingNote(option.label);
+      noteRef.current?.focus();
+      return;
+    }
+    if (option.tone === "danger" && confirming !== option.id) {
+      setConfirming(option.id);
+      return;
+    }
+    decide.mutate(
+      { id: item.id, choice: option.id, note: note.trim() || undefined },
+      { onSuccess: () => displaySuccessToast(copy.inbox.decidedToast) },
+    );
+  };
+
+  const chosen = item.options.find((o) => o.id === item.decision);
+
+  return (
+    <article
+      data-testid={`factory-inbox-item-${item.id}`}
+      aria-labelledby={titleId}
+      className={cn(
+        "flex flex-col gap-3 rounded-xl border bg-surface px-4 py-3.5",
+        open ? "border-warning" : "border-border-subtle",
+      )}
+    >
+      <header className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
+        <span className="inline-flex items-center gap-1.5 font-medium text-foreground">
+          <Inbox className="size-3.5" aria-hidden />
+          {copy.inbox.kinds[item.kind] ?? item.kind}
+        </span>
+        {item.workOrderKey ? (
+          <span className="font-mono">{item.workOrderKey}</span>
+        ) : null}
+        {showRun && item.change ? (
+          <Link
+            to={`/autopilot/runs/${item.runId}`}
+            className="font-mono text-link hover:underline"
+          >
+            {item.change}
+          </Link>
+        ) : null}
+        <span>{formatWhen(item.createdAt, i18n.language)}</span>
+      </header>
+      <h3 id={titleId} className="text-sm font-semibold text-foreground">
+        {item.title}
+      </h3>
+      {open ? (
+        // A long body (a plan, a diff summary) scrolls, so the choices stay in view.
+        <div className="max-h-96 min-w-0 overflow-y-auto custom-scrollbar">
+          <FactoryMarkdown text={item.body} headings />
+        </div>
+      ) : (
+        <details className="min-w-0 text-sm">
+          <summary className="cursor-pointer text-muted hover:text-foreground">
+            {copy.inbox.whatWasAsked}
+          </summary>
+          <div className="mt-2 max-h-96 overflow-y-auto custom-scrollbar">
+            <FactoryMarkdown text={item.body} headings />
+          </div>
+        </details>
+      )}
+
+      {open ? (
+        <>
+          {wantsNote ? (
+            <div className="flex flex-col gap-1.5">
+              <label
+                htmlFor={noteId}
+                className="text-sm font-medium text-foreground"
+              >
+                {copy.inbox.noteLabel}
+              </label>
+              <textarea
+                id={noteId}
+                ref={noteRef}
+                className={cn(factoryFieldClassName, "min-h-20")}
+                value={note}
+                onChange={(e) => {
+                  setNote(e.target.value);
+                  setMissingNote(null);
+                }}
+                disabled={busy}
+                aria-describedby={`${noteId}-help`}
+              />
+              <p id={`${noteId}-help`} className="text-xs text-muted">
+                {missingNote
+                  ? copy.inbox.noteRequired(missingNote)
+                  : copy.inbox.noteHelp}
+              </p>
+            </div>
+          ) : null}
+          <div className="flex flex-wrap gap-2">
+            {item.options.map((option) => (
+              <BrandButton
+                key={option.id}
+                testId={`factory-inbox-${item.id}-${option.id}`}
+                type="button"
+                variant={variantOf(option)}
+                onClick={() => choose(option)}
+                isDisabled={busy}
+              >
+                {confirming === option.id
+                  ? copy.inbox.confirm(option.label)
+                  : option.label}
+              </BrandButton>
+            ))}
+          </div>
+          <FactoryError error={decide.error} />
+        </>
+      ) : (
+        <p className="flex items-center gap-2 text-sm text-muted">
+          <CircleCheck className="size-4 text-success" aria-hidden />
+          {item.state === "dismissed"
+            ? copy.inbox.dismissed
+            : `${copy.inbox.decidedBy(
+                approverName(item.decidedBy ?? ""),
+                chosen?.label ?? item.decision ?? "",
+              )}${item.decidedAt ? ` · ${formatWhen(item.decidedAt, i18n.language)}` : ""}`}
+          {item.note ? (
+            <span className="text-foreground">{`“${item.note}”`}</span>
+          ) : null}
+        </p>
+      )}
+    </article>
+  );
+}
