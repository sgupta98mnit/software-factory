+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Link, useNavigate } from "react-router";
+import {
+  BellRing,
+  CircleAlert,
+  CircleCheck,
+  GitBranch,
+  Inbox,
+  Rocket,
+  Server,
+  ShieldCheck,
+} from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import {
+  AUTONOMY_LEVELS,
+  type Autonomy,
+  type AutopilotStatus,
+  type RunSummary,
+} from "../api";
+import { useFactoryCopy } from "../copy";
+import {
+  useAutopilotStatus,
+  useCreateRun,
+  useFactoryHealth,
+  useRuns,
+} from "../hooks";
+import {
+  FactoryError,
+  FactoryLoading,
+  FactoryPage,
+} from "../components/factory-page";
+import { formatWhen } from "../components/factory-badges";
+import {
+  RunStatePill,
+  WAITING_RUN_STATES,
+  formatMoney,
+} from "../components/autopilot-badges";
+import { factoryFieldClassName } from "../components/start-agent-modal";
+
+export default function FactoryAutopilotRoute() {
+  const copy = useFactoryCopy();
+  const health = useFactoryHealth();
+  const status = useAutopilotStatus();
+  const runs = useRuns();
+
+  return (
+    <FactoryPage
+      testId="factory-autopilot"
+      title={copy.autopilot.title}
+      subtitle={
+        health.data
+          ? copy.autopilot.subtitle(health.data.workspace.name)
+          : undefined
+      }
+      error={runs.error ?? status.error}
+      onRetry={() => {
+        void runs.refetch();
+        void status.refetch();
+      }}
+    >
+      <div className="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-6">
+        <div className="grid gap-6 lg:grid-cols-3">
+          <div className="min-w-0 lg:col-span-2">
+            <GoalForm status={status.data} />
+          </div>
+          <SetupStatus status={status.data} />
+        </div>
+        <section aria-labelledby="factory-runs-heading">
+          <h2
+            id="factory-runs-heading"
+            className="mb-2 text-sm font-semibold text-foreground"
+          >
+            {copy.autopilot.runs}
+          </h2>
+          {runs.isLoading ? <FactoryLoading /> : null}
+          {runs.data?.length === 0 ? (
+            <p className="text-sm text-muted">{copy.autopilot.noRuns}</p>
+          ) : null}
+          <ul className="flex flex-col gap-2">
+            {(runs.data ?? []).map((run) => (
+              <li key={run.id}>
+                <RunRow run={run} />
+              </li>
+            ))}
+          </ul>
+        </section>
+      </div>
+    </FactoryPage>
+  );
+}
+
+function GoalForm({ status }: { status: AutopilotStatus | undefined }) {
+  const copy = useFactoryCopy();
+  const navigate = useNavigate();
+  const create = useCreateRun();
+  const [goal, setGoal] = React.useState("");
+  const [budget, setBudget] = React.useState("");
+  const [picked, setPicked] = React.useState<Autonomy | null>(null);
+  const caps = status?.policy.autonomy;
+  const autonomy = picked ?? caps?.default ?? "supervised";
+  const max = caps ? AUTONOMY_LEVELS.indexOf(caps.max) : 2;
+  const blocked = Boolean(status?.policy.error);
+  const budgetUsd = budget.trim() ? Number(budget) : null;
+  const budgetInvalid =
+    budgetUsd !== null && !(Number.isFinite(budgetUsd) && budgetUsd > 0);
+
+  const submit = (event: React.FormEvent) => {
+    event.preventDefault();
+    if (!goal.trim() || budgetInvalid) return;
+    create.mutate(
+      { goal: goal.trim(), autonomy, budgetUsd },
+      { onSuccess: (run) => navigate(`/autopilot/runs/${run.id}`) },
+    );
+  };
+
+  return (
+    <form
+      onSubmit={submit}
+      className="flex flex-col gap-4"
+      aria-label={copy.autopilot.goalLabel}
+    >
+      <div className="flex flex-col gap-1.5">
+        <label
+          htmlFor="factory-goal"
+          className="text-base font-semibold text-foreground"
+        >
+          {copy.autopilot.goalLabel}
+        </label>
+        <textarea
+          id="factory-goal"
+          data-testid="factory-goal"
+          className={cn(factoryFieldClassName, "min-h-28 text-base")}
+          placeholder={copy.autopilot.goalPlaceholder}
+          value={goal}
+          maxLength={4000}
+          onChange={(e) => setGoal(e.target.value)}
+          aria-describedby="factory-goal-help"
+          disabled={create.isPending}
+        />
+        <p id="factory-goal-help" className="text-xs text-muted">
+          {copy.autopilot.goalHelp}
+        </p>
+      </div>
+
+      <fieldset className="flex flex-col gap-2">
+        <legend className="mb-1.5 text-sm font-medium text-foreground">
+          {copy.autopilot.autonomyLabel}
+        </legend>
+        <div className="grid gap-2 sm:grid-cols-3">
+          {AUTONOMY_LEVELS.map((level, i) => {
+            const text = copy.autopilot.autonomy[level];
+            const disabled = i > max;
+            return (
+              <label
+                key={level}
+                className={cn(
+                  "flex cursor-pointer flex-col gap-1 rounded-xl border px-3 py-2.5",
+                  autonomy === level
+                    ? "border-primary bg-interactive-selected"
+                    : "border-border-subtle bg-surface hover:bg-surface-raised",
+                  disabled && "cursor-not-allowed opacity-50",
+                )}
+              >
+                <span className="flex items-center gap-2 text-sm font-medium text-foreground">
+                  <input
+                    type="radio"
+                    name="factory-autonomy"
+                    value={level}
+                    checked={autonomy === level}
+                    disabled={disabled || create.isPending}
+                    onChange={() => setPicked(level)}
+                    className="accent-primary"
+                  />
+                  {text?.label ?? level}
+                </span>
+                <span className="text-xs text-muted">{text?.help}</span>
+              </label>
+            );
+          })}
+        </div>
+        {caps && max < 2 ? (
+          <p className="text-xs text-muted">
+            {copy.autopilot.autonomyCapped(
+              copy.autopilot.autonomy[caps.max]?.label ?? caps.max,
+            )}
+          </p>
+        ) : null}
+      </fieldset>
+
+      <div className="flex flex-wrap items-end gap-4">
+        <div className="flex w-48 flex-col gap-1.5">
+          <label
+            htmlFor="factory-budget"
+            className="text-sm font-medium text-foreground"
+          >
+            {copy.autopilot.budgetLabel}
+          </label>
+          <input
+            id="factory-budget"
+            data-testid="factory-budget"
+            type="number"
+            min="0.01"
+            step="any"
+            inputMode="decimal"
+            className={factoryFieldClassName}
+            value={budget}
+            onChange={(e) => setBudget(e.target.value)}
+            aria-invalid={budgetInvalid || undefined}
+            aria-describedby="factory-budget-help"
+            disabled={create.isPending}
+          />
+        </div>
+        <p id="factory-budget-help" className="pb-2 text-xs text-muted">
+          {copy.autopilot.budgetHelp(
+            status?.policy.budget
+              ? `$${status.policy.budget.perChangeUsd.toFixed(2)}`
+              : null,
+          )}
+        </p>
+        <BrandButton
+          testId="factory-start-run"
+          type="submit"
+          variant="primary"
+          className="ml-auto"
+          isDisabled={
+            !goal.trim() || budgetInvalid || blocked || create.isPending
+          }
+          startContent={<Rocket className="size-4" aria-hidden />}
+        >
+          {create.isPending ? copy.autopilot.starting : copy.autopilot.start}
+        </BrandButton>
+      </div>
+      <FactoryError error={create.error} />
+    </form>
+  );
+}
+
+function SetupStatus({ status }: { status: AutopilotStatus | undefined }) {
+  const copy = useFactoryCopy();
+  if (!status) return null;
+  const { agentServer, workspace, policy, notifications } = status;
+  return (
+    <aside
+      aria-label={copy.autopilot.setup}
+      className="flex flex-col gap-3 self-start rounded-xl border border-border-subtle bg-surface px-4 py-3.5 text-sm"
+    >
+      <h2 className="text-xs font-medium text-muted">{copy.autopilot.setup}</h2>
+      <SetupLine
+        ok={agentServer.reachable}
+        icon={<Server className="size-4" aria-hidden />}
+        text={
+          agentServer.reachable
+            ? copy.autopilot.agentServerOk(agentServer.profiles.length)
+            : copy.autopilot.agentServerDown
+        }
+        hint={
+          agentServer.reachable
+            ? undefined
+            : `${copy.autopilot.agentServerHint} (${agentServer.url})`
+        }
+      />
+      <SetupLine
+        ok
+        icon={<GitBranch className="size-4" aria-hidden />}
+        text={
+          workspace.isRepo && workspace.branch
+            ? copy.autopilot.workspaceRepo(workspace.branch)
+            : copy.autopilot.workspaceNotRepo
+        }
+        hint={workspace.path}
+      />
+      <SetupLine
+        ok={!policy.error}
+        icon={<ShieldCheck className="size-4" aria-hidden />}
+        text={
+          policy.error
+            ? copy.autopilot.policyError
+            : policy.source === "defaults"
+              ? copy.autopilot.policyDefaults(policy.hash)
+              : copy.autopilot.policyFile(policy.source, policy.hash)
+        }
+        hint={policy.error ?? undefined}
+      />
+      <SetupLine
+        ok
+        icon={<BellRing className="size-4" aria-hidden />}
+        text={
+          notifications.channel
+            ? copy.autopilot.alertsOn(
+                copy.autopilot.channels[notifications.channel] ??
+                  notifications.channel,
+                notifications.digestHour,
+              )
+            : copy.autopilot.alertsOff
+        }
+      />
+    </aside>
+  );
+}
+
+function SetupLine({
+  ok,
+  icon,
+  text,
+  hint,
+}: {
+  ok: boolean;
+  icon: React.ReactNode;
+  text: string;
+  hint?: string;
+}) {
+  return (
+    <div className="flex items-start gap-2">
+      <span className={cn("mt-0.5", ok ? "text-muted" : "text-warning")}>
+        {ok ? icon : <CircleAlert className="size-4" aria-hidden />}
+      </span>
+      <div className="min-w-0">
+        <p className="text-foreground">{text}</p>
+        {hint ? (
+          <p className="break-all font-mono text-xs text-muted">{hint}</p>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+function RunRow({ run }: { run: RunSummary }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const money = (usd: number) => formatMoney(usd, i18n.language);
+  const waiting = WAITING_RUN_STATES.has(run.state) || run.openInbox > 0;
+  return (
+    <Link
+      to={`/autopilot/runs/${run.id}`}
+      data-testid={`factory-run-${run.id}`}
+      className={cn(
+        "flex flex-col gap-1.5 rounded-xl border bg-surface px-4 py-3 hover:bg-surface-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-focus",
+        waiting ? "border-warning" : "border-border-subtle",
+      )}
+    >
+      <span className="flex flex-wrap items-baseline gap-x-3 gap-y-1">
+        <span className="min-w-0 flex-1 text-sm font-medium text-foreground">
+          {run.goal}
+        </span>
+        <RunStatePill state={run.state} />
+      </span>
+      <span className="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
+        <span className="font-mono">{run.change}</span>
+        {run.counts.total ? (
+          <span className="inline-flex items-center gap-1 tabular-nums">
+            <CircleCheck className="size-3.5" aria-hidden />
+            {copy.autopilot.progress(run.counts.merged, run.counts.total)}
+          </span>
+        ) : null}
+        <span className="tabular-nums">
+          {copy.autopilot.cost(money(run.costUsd), money(run.budgetUsd))}
+        </span>
+        {run.openInbox ? (
+          <span className="inline-flex items-center gap-1 text-foreground">
+            <Inbox className="size-3.5 text-warning" aria-hidden />
+            {copy.autopilot.needsYou(run.openInbox)}
+          </span>
+        ) : null}
+        <span className="ml-auto">
+          {formatWhen(run.createdAt, i18n.language)}
+        </span>
+      </span>
+    </Link>
+  );
+}
diff --git a/src/factory/routes/inbox.tsx b/src/factory/routes/inbox.tsx
