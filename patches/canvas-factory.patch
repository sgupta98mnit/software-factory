+import {
+  FileText,
+  Inbox,
+  Rocket,
+  ShieldCheck,
+  SquareKanban,
+} from "lucide-react";
+import { SidebarNavLink } from "#/components/features/sidebar/sidebar-nav-link";
+import { cn } from "#/utils/utils";
+import { useFactoryCopy } from "./copy";
+import { useFactoryLiveUpdates, useInboxCount } from "./hooks";
+
+const ICON_SIZE = 18;
+
+/** The Software Factory's entries in the Canvas sidebar. */
+export function FactoryNavLinks({ collapsed }: { collapsed: boolean }) {
+  const copy = useFactoryCopy();
+  // The sidebar is always there, so the Inbox badge stays current on every page.
+  useFactoryLiveUpdates();
+  const open = useInboxCount().data?.open ?? 0;
+  return (
+    <>
+      <SidebarNavLink
+        to="/autopilot"
+        label={copy.nav.autopilot}
+        testId="sidebar-factory-autopilot-link"
+        collapsed={collapsed}
+        icon={<Rocket width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <div className="relative">
+        <SidebarNavLink
+          to="/inbox"
+          label={copy.nav.inbox}
+          testId="sidebar-factory-inbox-link"
+          collapsed={collapsed}
+          icon={<Inbox width={ICON_SIZE} height={ICON_SIZE} />}
+        />
+        {open ? (
+          <span
+            data-testid="sidebar-factory-inbox-badge"
+            title={copy.nav.inboxCount(open)}
+            className={cn(
+              "pointer-events-none absolute flex min-w-4 items-center justify-center rounded-full bg-warning px-1 text-xs font-semibold leading-4 text-canvas-base",
+              collapsed
+                ? "right-1 top-0.5"
+                : "right-2 top-1/2 -translate-y-1/2",
+            )}
+          >
+            <span aria-hidden>{open > 99 ? "99+" : open}</span>
+            <span className="sr-only">{copy.nav.inboxCount(open)}</span>
+          </span>
+        ) : null}
+      </div>
+      <SidebarNavLink
+        to="/requirements"
+        label={copy.nav.requirements}
+        testId="sidebar-factory-requirements-link"
+        collapsed={collapsed}
+        icon={<FileText width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <SidebarNavLink
+        to="/work-orders"
+        label={copy.nav.workOrders}
+        testId="sidebar-factory-work-orders-link"
+        collapsed={collapsed}
+        icon={<SquareKanban width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <SidebarNavLink
+        to="/audit-log"
+        label={copy.nav.audit}
+        testId="sidebar-factory-audit-link"
+        collapsed={collapsed}
+        icon={<ShieldCheck width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+    </>
+  );
+}
