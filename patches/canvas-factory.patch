+import {
+  FINISHED_RUN_STATES,
+  RiskChip,
+  RunStatePill,
+  WorkOrderStatePill,
+  approverName,
+  formatDuration,
+  formatMoney,
+} from "../components/autopilot-badges";
+import { DecisionCard } from "../components/decision-card";
+import { FactoryMarkdown } from "../components/factory-markdown";
+
+type Stage = "spec" | "plan" | "build" | "verify" | "integrate" | "done";
+const STAGES: Stage[] = [
+  "spec",
+  "plan",
+  "build",
+  "verify",
+  "integrate",
+  "done",
+];
+
+/** Which lane each work-order state sits in. */
+const LANE: Record<string, Stage | undefined> = {
+  building: "build",
+  verifying: "verify",
+  reviewing: "verify",
+  ready: "integrate",
+  awaiting_merge_approval: "integrate",
+  merging: "integrate",
+  merged: "done",
+  skipped: "done",
+};
+
+/** How far the run has come: the stage it's in (or stopped in). */
+function currentStage(run: RunDetail): Stage {
+  switch (run.state) {
+    case "spec":
+    case "critic":
+    case "awaiting_spec_approval":
+    case "awaiting_answers":
+      return "spec";
+    case "awaiting_plan_approval":
+      return "plan";
+    case "done":
+    case "releasing":
+    case "released":
+      return "done";
+    case "building":
+      return "build";
+    default:
+      // Stopped (paused, failed, cancelled) somewhere along the way. Cancelling
+      // marks pending work orders cancelled, which isn't progress.
+      if (
+        run.workOrders.some((w) => !["pending", "cancelled"].includes(w.state))
+      )
+        return "build";
+      return run.workOrders.length ? "plan" : "spec";
+  }
+}
+
+export default function FactoryAutopilotRunRoute() {
+  const copy = useFactoryCopy();
+  const { runId, workOrderKey } = useParams();
+  const navigate = useNavigate();
+  const run = useRun(runId);
+  const data = run.data;
+  const selected = data?.workOrders.find(
+    (w) => w.key.toLowerCase() === workOrderKey?.toLowerCase(),
+  );
+  const base = `/autopilot/runs/${runId}`;
+
+  return (
+    <FactoryPage
+      testId="factory-pipeline"
+      title={data?.goal ?? copy.autopilot.title}
+      subtitle={data ? <RunSubtitle run={data} /> : undefined}
+      error={run.error}
+      onRetry={() => void run.refetch()}
+      actions={data ? <RunActions run={data} /> : null}
+      fill
+    >
+      <div className="min-w-0 flex-1 overflow-y-auto custom-scrollbar-always">
+        <div className="flex flex-col gap-6 px-6 py-5">
+          <Link
+            to="/autopilot"
+            className="inline-flex items-center gap-1.5 self-start text-sm text-link hover:underline"
+          >
+            <ArrowLeft className="size-4" aria-hidden />
+            {copy.pipeline.back}
+          </Link>
+          {run.isLoading ? <FactoryLoading /> : null}
+          {isNotFound(run.error) ? (
+            <p className="text-sm text-muted">{copy.pipeline.notFound}</p>
+          ) : null}
+          {run.error && !data && !isNotFound(run.error) ? (
+            <FactoryError error={run.error} />
+          ) : null}
+          {data ? <RunBody run={data} base={base} selected={selected} /> : null}
+        </div>
+      </div>
+      {selected && data ? (
+        <WorkOrderPanel
+          key={selected.id}
+          run={data}
+          wo={selected}
+          onClose={() => navigate(base)}
+        />
+      ) : null}
+    </FactoryPage>
+  );
+}
+
+function RunSubtitle({ run }: { run: RunDetail }) {
+  const copy = useFactoryCopy();
+  return (
+    <span className="flex flex-wrap items-center gap-x-3 gap-y-1">
+      <span className="font-mono">{run.change}</span>
+      <span>
+        {copy.autopilot.autonomy[run.autonomy]?.label ?? run.autonomy}
+      </span>
+      <span className="inline-flex items-center gap-1 font-mono">
+        <GitBranch className="size-3.5" aria-hidden />
+        {run.integrationBranch}
+      </span>
+    </span>
+  );
+}
+
+function RunActions({ run }: { run: RunDetail }) {
+  const copy = useFactoryCopy();
+  const action = useRunAction();
+  const release = useRelease();
+  const [confirmCancel, setConfirmCancel] = React.useState(false);
+  if (run.state === "done") {
+    return (
+      <>
+        <BrandButton
+          testId="factory-run-release"
+          type="button"
+          variant="primary"
+          onClick={() => release.mutate(run.id)}
+          isDisabled={release.isPending}
+          startContent={<GitMerge className="size-4" aria-hidden />}
+        >
+          {copy.pipeline.release(run.baseBranch)}
+        </BrandButton>
+        {release.error ? (
+          <span className="basis-full">
+            <FactoryError error={release.error} />
+          </span>
+        ) : null}
+      </>
+    );
+  }
+  if (FINISHED_RUN_STATES.has(run.state) || run.state === "releasing")
+    return null;
+  const busy = action.isPending;
+  const act = (a: "pause" | "resume" | "cancel") =>
+    action.mutate(
+      { id: run.id, action: a },
+      { onSettled: () => setConfirmCancel(false) },
+    );
+  return (
+    <>
+      {run.state === "paused" ? (
+        <BrandButton
+          testId="factory-run-resume"
+          type="button"
+          variant="primary"
+          onClick={() => act("resume")}
+          isDisabled={busy}
+          startContent={<Play className="size-4" aria-hidden />}
+        >
+          {copy.pipeline.resume}
+        </BrandButton>
+      ) : (
+        <BrandButton
+          testId="factory-run-pause"
+          type="button"
+          variant="secondary"
+          onClick={() => act("pause")}
+          isDisabled={busy}
+          startContent={<Pause className="size-4" aria-hidden />}
+        >
+          {copy.pipeline.pause}
+        </BrandButton>
+      )}
+      <span title={copy.pipeline.cancelHelp}>
+        <BrandButton
+          testId="factory-run-cancel"
+          type="button"
+          variant="ghost-danger"
+          onClick={() =>
+            confirmCancel ? act("cancel") : setConfirmCancel(true)
+          }
+          isDisabled={busy}
+        >
+          {confirmCancel ? copy.pipeline.confirmCancel : copy.pipeline.cancel}
+        </BrandButton>
+      </span>
+      {action.error ? (
+        <span className="basis-full">
+          <FactoryError error={action.error} />
+        </span>
+      ) : null}
+    </>
+  );
+}
+
+function RunBody({
+  run,
+  base,
+  selected,
+}: {
+  run: RunDetail;
+  base: string;
+  selected?: AutopilotWorkOrder;
+}) {
+  const copy = useFactoryCopy();
