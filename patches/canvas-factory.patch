@@ -0,0 +1,144 @@
+import React from "react";
+import {
+  useMutation,
+  useQuery,
+  useQueryClient,
+  type QueryClient,
+} from "@tanstack/react-query";
+import { FACTORY_API_BASE, FactoryApi, FactoryOfflineError } from "./api";
+
+export const FACTORY_QUERY_KEYS = {
+  all: ["factory"] as const,
+  health: ["factory", "health"] as const,
+  specs: ["factory", "specs"] as const,
+  change: (id: string) => ["factory", "specs", "change", id] as const,
+  plan: (id: string) => ["factory", "specs", "plan", id] as const,
+  workOrders: ["factory", "work-orders"] as const,
+  audit: ["factory", "audit"] as const,
+};
+
+// Don't hammer a server that isn't running; the offline card has a retry button.
+const retry = (count: number, error: unknown) =>
+  !(error instanceof FactoryOfflineError) && count < 2;
+
+export const useFactoryHealth = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.health,
+    queryFn: FactoryApi.health,
+    retry,
+    staleTime: 60_000,
+    meta: { disableToast: true },
+  });
+
+export const useSpecsOverview = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.specs,
+    queryFn: FactoryApi.specs,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useChangeDetail = (id: string | undefined) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.change(id ?? ""),
+    queryFn: () => FactoryApi.change(id ?? ""),
+    enabled: Boolean(id),
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrderPlan = (id: string, enabled: boolean) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.plan(id),
+    queryFn: () => FactoryApi.workOrderPlan(id),
+    enabled,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrders = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.workOrders,
+    queryFn: FactoryApi.workOrders,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useAuditLog = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.audit,
+    queryFn: FactoryApi.audit,
+    retry,
+    meta: { disableToast: true },
+  });
+
+function invalidateFactory(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({ queryKey: FACTORY_QUERY_KEYS.all });
+}
+
+export function useValidateSpecs() {
+  return useMutation({
+    mutationFn: FactoryApi.validate,
+    meta: { disableToast: true },
+  });
+}
+
+export function useCreateWorkOrders() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (change: string) => FactoryApi.createWorkOrders(change),
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useSetWorkOrderStatus() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: {
+      id: string;
+      status: string;
+      approve?: boolean;
+      note?: string;
+    }) => {
+      const { id, ...body } = variables;
+      return FactoryApi.setStatus(id, body);
+    },
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+/**
+ * Keep factory data fresh while a factory page is open. The API sends an
+ * event whenever an agent (or anyone) edits a work order or spec file, or the
+ * audit log grows, and we refetch what changed.
+ */
+export function useFactoryLiveUpdates() {
+  const queryClient = useQueryClient();
+  React.useEffect(() => {
+    if (typeof EventSource === "undefined") return undefined;
+    const source = new EventSource(`${FACTORY_API_BASE}/events`);
+    const refetch = (key: readonly string[]) => () =>
+      queryClient.invalidateQueries({ queryKey: key });
+    source.addEventListener(
+      "workorders.changed",
+      refetch(FACTORY_QUERY_KEYS.workOrders),
+    );
+    source.addEventListener("specs.changed", refetch(FACTORY_QUERY_KEYS.specs));
+    source.addEventListener("audit.appended", () => {
+      queryClient.invalidateQueries({ queryKey: FACTORY_QUERY_KEYS.audit });
+      queryClient.invalidateQueries({
+        queryKey: FACTORY_QUERY_KEYS.workOrders,
+      });
+    });
+    // After a reconnect (say the API restarted), pick up anything that changed
+    // while it was down. The first hello is just the initial connection.
+    let connectedBefore = false;
+    source.addEventListener("hello", () => {
+      if (connectedBefore) invalidateFactory(queryClient);
+      connectedBefore = true;
+    });
+    return () => source.close();
+  }, [queryClient]);
+}
