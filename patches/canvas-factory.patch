+/**
+ * Client for the Software Factory API (apps/server in the software-factory
+ * repo). It is not part of the OpenHands agent server: Vite proxies `/sf-api`
+ * to it (see `vite.config.ts`), so these are same-origin requests.
+ */
+
+export const FACTORY_API_BASE = "/sf-api";
+
+export interface FactoryHealth {
+  /** `agentPath` is the same folder as the agent server sees it (differs only in a Docker sandbox). */
+  workspace: { name: string; path: string; agentPath: string; exists: boolean };
+  user: string;
+  versions: { openspec: string; backlog: string };
+}
+
+export interface ChangeSummary {
+  name: string;
+  completedTasks: number;
+  totalTasks: number;
+  lastModified: string;
+  status: string;
+}
+
+export interface SpecsOverview {
+  changes: { changes: ChangeSummary[] };
+  specs: { specs: { id: string; requirementCount: number }[] };
+}
+
+export interface Requirement {
+  name?: string;
+  text: string;
+  scenarios: { name?: string; rawText: string }[];
+}
+
+export interface ChangeDetail {
+  id: string;
+  show: {
+    id: string;
+    title: string;
+    deltaCount: number;
+    deltas: {
+      spec: string;
+      operation: string;
+      description: string;
+      requirement?: Requirement;
+    }[];
+  };
+  status: {
+    isComplete?: boolean;
+    artifacts: { id: string; status: string }[];
+  };
+  files: {
+    proposal: string | null;
+    design: string | null;
+    tasks: string | null;
+    specs: { path: string; markdown: string }[];
+  };
+}
+
+export interface ValidationResult {
+  items: {
+    id: string;
+    type: string;
+    valid: boolean;
+    issues: { level: string; path: string; message: string }[];
+  }[];
+  summary: { totals: { items: number; passed: number; failed: number } };
+}
+
+export interface PlannedWorkOrder {
+  title: string;
+  description: string;
+  acceptanceCriteria: string[];
+  controls: string[];
+  labels: string[];
+  dependsOn: number | null;
+}
+
+export interface WorkOrderPlan {
+  change: string;
+  source: string;
+  workOrders: PlannedWorkOrder[];
+  existing: { id: string; title: string; status: string }[];
+}
+
+export interface WorkOrderConversation {
+  id: string;
+  agent: string;
+  by: string;
+  at: string;
+}
+
+export interface WorkOrder {
+  id: string;
+  title: string;
+  status: string;
+  assignee: string[];
+  labels: string[];
+  dependencies: string[];
+  priority?: string;
+  createdDate?: string;
+  updatedDate?: string;
+  description: string;
+  acceptanceCriteria: { index: number; text: string; done: boolean }[];
+  plan?: string;
+  notes?: string;
+  finalSummary?: string;
+  file: string;
+  approval?: { by: string; at: string };
+  doneWithoutApproval: boolean;
+  conversations: WorkOrderConversation[];
+}
+
+export interface WorkOrderList {
+  initialized: boolean;
+  statuses: string[];
+  finalStatus: string;
+  workOrders: WorkOrder[];
+}
+
+export interface AuditEvent {
+  seq: number;
+  at: string;
+  actor: string;
+  action: string;
+  subject: string;
+  data: Record<string, unknown>;
+  prevHash: string;
+  hash: string;
+}
+
+export interface AuditVerification {
+  ok: boolean;
+  checked: number;
+  brokenAt?: number;
+  reason?: string;
+}
+
+// ---- Autopilot (/sf-api/autopilot): shapes from apps/server/src/autopilot/routes.ts ----
+
+export type Autonomy = "suggest" | "supervised" | "autonomous";
+export const AUTONOMY_LEVELS: Autonomy[] = [
+  "suggest",
+  "supervised",
+  "autonomous",
+];
+
+export type RunState =
+  | "spec"
+  | "critic"
+  | "awaiting_spec_approval"
+  | "awaiting_answers"
+  | "awaiting_plan_approval"
+  | "building"
+  | "done"
+  | "releasing"
+  | "released"
+  | "paused"
+  | "failed"
+  | "cancelled";
+
+export type AutopilotWorkOrderState =
+  | "pending"
+  | "building"
+  | "verifying"
+  | "reviewing"
+  | "ready"
+  | "awaiting_merge_approval"
+  | "merging"
+  | "merged"
+  | "needs_attention"
+  | "skipped"
+  | "cancelled";
+
+export type Severity = "critical" | "high" | "medium" | "low";
+
+export interface Finding {
+  source: "gate" | "review" | "hidden" | "integration" | "critic" | "agent";
+  severity: Severity;
+  title: string;
+  detail: string;
+  file?: string | null;
+  criterion?: number | null;
+  scenario?: string | null;
+}
+
+export interface RunSummary {
+  id: string;
+  goal: string;
+  change: string;
+  autonomy: Autonomy;
+  state: RunState;
+  pausedReason: string | null;
+  baseBranch: string;
+  integrationBranch: string;
+  costUsd: number;
+  /** The budget that applies: the run's own, or the policy's per change (budgetSource). */
+  budgetUsd: number;
+  budgetSource: "run" | "policy";
+  policyHash: string | null;
+  /** Who released it into the base branch (while releasing: who asked), and the release merge. */
+  releasedBy: string | null;
+  releasedSha: string | null;
+  releasedAt: string | null;
+  createdBy: string;
+  createdAt: string;
+  updatedAt: string;
+  counts: {
+    total: number;
+    merged: number;
+    active: number;
+    failed: number;
+    pending: number;
+  };
+  openInbox: number;
+}
+
+export interface AutopilotWorkOrder {
+  id: string;
+  runId: string;
+  seq: number;
+  key: string;
+  title: string;
+  acceptance: string[];
+  controls: string[];
+  dependsOn: number[];
+  wave: number;
+  risk: "low" | "medium" | "high";
+  state: AutopilotWorkOrderState;
+  branch: string | null;
+  costUsd: number;
+  /** What it may spend: the policy's per work order, plus what people added. */
+  budgetUsd: number;
+  /** Builder conversations so far. */
+  attempts: number;
+  /** Messages sent to the latest builder (1 = the brief, 2+ = repairs). */
+  round: number;
+  /** The latest builder's conversation, openable in Canvas. */
+  conversationId: string | null;
+  findings: Finding[] | null;
+  mergedBy: string | null;
+  updatedAt: string;
+}
+
+export type AttemptRole =
+  | "spec"
+  | "critic"
+  | "builder"
+  | "reviewer"
+  | "validator";
+
+export interface Attempt {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  role: AttemptRole;
+  conversationId: string;
+  agentProfile: string | null;
+  state:
+    | "starting"
+    | "running"
+    | "finished"
+    | "error"
+    | "stuck"
+    | "paused"
+    | "cancelled";
+  turns: number;
+  costUsd: number;
+  result: unknown;
+  startedAt: string;
+  finishedAt: string | null;
+}
+
+export interface Check {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  stage: "spec" | "build" | "integrate";
+  name: string;
+  ok: boolean;
+  exitCode: number | null;
+  durationMs: number | null;
+  output: string;
+  at: string;
+}
+
+export interface InboxOption {
+  id: string;
+  label: string;
+  tone?: "primary" | "danger" | "default";
+  needsNote?: boolean;
+}
+
+export type InboxKind =
+  | "spec_approval"
+  | "plan_approval"
+  | "questions"
+  | "spec_failed"
+  | "merge_approval"
+  | "work_order_failed"
+  | "budget_reached"
+  | "run_paused"
+  | "error"
+  | "integration_moved"
+  | "release";
+
+export interface InboxItem {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  kind: InboxKind;
+  title: string;
+  /** Markdown. */
+  body: string;
+  options: InboxOption[];
+  state: "open" | "decided" | "dismissed";
+  decision: string | null;
+  note: string | null;
+  decidedBy: string | null;
+  decidedAt: string | null;
+  createdAt: string;
+  /** The run's OpenSpec change, and "WO-N" when the item is about a work order. */
+  change: string | null;
+  workOrderKey: string | null;
+}
+
+/** A hidden acceptance test the run's validator wrote, and how it last ran. */
+export interface HiddenTestView {
+  file: string;
+  scenario: string;
+  requirement: string | null;
+  requires: number[];
+  sha256: string;
+  runs: number;
+  lastOk: boolean | null;
+  lastAt: string | null;
+}
+
+export interface RunDetail extends RunSummary {
+  workOrders: AutopilotWorkOrder[];
+  attempts: Attempt[];
+  checks: Check[];
+  inbox: InboxItem[];
+  hiddenTests: HiddenTestView[];
+  /** null until a work order has merged. */
+  etaMs: number | null;
+  /** Spent so far plus the merged average for each work order left; null until one has merged. */
+  projectedCostUsd: number | null;
+}
+
+export interface AgentProfileSummary {
+  id: string;
+  name: string;
+  kind: string;
+  server: string | null;
+}
+
+export interface AutopilotStatus {
+  agentServer: {
+    url: string;
+    reachable: boolean;
+    error: string | null;
+    profiles: AgentProfileSummary[];
+    activeProfileId: string | null;
+  };
+  workspace: { path: string; isRepo: boolean; branch: string | null };
+  /** `autonomy`: what to preselect, and the most a run may use; null when the policy file is invalid. */
+  policy: {
+    source: string;
+    hash: string;
+    error: string | null;
+    autonomy: { default: Autonomy; max: Autonomy } | null;
+    budget: { perChangeUsd: number; perWorkOrderUsd: number } | null;
+  };
+  /** Where alerts go (SF_NOTIFY_WEBHOOK), and the hour of the daily digest. */
+  notifications: {
+    channel: "slack" | "teams" | "json" | null;
+    digestHour: number;
+  };
+  openInbox: number;
+  activeRuns: number;
+}
+
+/** An error answer from the factory API, with its HTTP status. */
+export class FactoryHttpError extends Error {
+  constructor(
+    message: string,
+    readonly status: number,
+  ) {
+    super(message);
+    this.name = "FactoryHttpError";
+  }
+}
+
+export const isNotFound = (error: unknown) =>
+  error instanceof FactoryHttpError && error.status === 404;
+
+/** Thrown when the factory API can't be reached at all (server not running). */
+export class FactoryOfflineError extends Error {
+  constructor() {
+    super("The Software Factory API isn't running.");
+    this.name = "FactoryOfflineError";
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${FACTORY_API_BASE}${path}`, {
+      ...init,
+      headers: init?.body
+        ? { "Content-Type": "application/json", ...init.headers }
+        : init?.headers,
+    });
+  } catch {
+    throw new FactoryOfflineError();
+  }
+  // The dev proxy answers 502/504 (or Vite's HTML fallback) when nothing is listening.
+  const isJson = (response.headers.get("content-type") ?? "").includes(
+    "application/json",
+  );
+  if (!isJson && (response.status >= 500 || response.status === 404)) {
+    throw new FactoryOfflineError();
+  }
+  const data = isJson ? await response.json() : null;
+  if (!response.ok) {
+    throw new FactoryHttpError(
+      (data as { error?: string } | null)?.error ??
+        `${response.status} ${response.statusText}`,
+      response.status,
+    );
+  }
+  return data as T;
+}
+
+const post = <T>(path: string, body: unknown = {}) =>
+  request<T>(path, { method: "POST", body: JSON.stringify(body) });
+
+export const FactoryApi = {
+  health: () => request<FactoryHealth>("/health"),
+  specs: () => request<SpecsOverview>("/specs"),
+  change: (id: string) =>
+    request<ChangeDetail>(`/specs/changes/${encodeURIComponent(id)}`),
+  validate: () => post<ValidationResult>("/specs/validate"),
+  changeBrief: (id: string, purpose: "review" | "plan") =>
+    request<{ text: string }>(
+      `/specs/changes/${encodeURIComponent(id)}/brief/${purpose}`,
+    ),
+  workOrderPlan: (id: string) =>
+    request<WorkOrderPlan>(
+      `/specs/changes/${encodeURIComponent(id)}/work-order-plan`,
+    ),
+  createWorkOrders: (id: string) =>
+    post<{ change: string; created: { id: string; title: string }[] }>(
+      `/specs/changes/${encodeURIComponent(id)}/work-orders`,
+    ),
+  workOrders: () => request<WorkOrderList>("/workorders"),
+  workOrderBrief: (id: string) =>
+    request<{ workOrder: string; text: string }>(
+      `/workorders/${encodeURIComponent(id)}/brief`,
+    ),
+  setStatus: (
+    id: string,
+    body: { status: string; approve?: boolean; note?: string },
+  ) => post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/status`, body),
+  linkConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/conversations`, {
+      conversationId,
+      agent,
+    }),
+  linkChangeConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(
+      `/specs/changes/${encodeURIComponent(id)}/conversations`,
+      { conversationId, agent },
+    ),
+  audit: () => request<AuditEvent[]>("/audit"),
+  verifyAudit: () => request<AuditVerification>("/audit/verify"),
+
+  autopilotStatus: () => request<AutopilotStatus>("/autopilot/status"),
+  runs: () => request<RunSummary[]>("/autopilot/runs"),
+  run: (id: string) =>
+    request<RunDetail>(`/autopilot/runs/${encodeURIComponent(id)}`),
+  createRun: (body: {
+    goal: string;
+    autonomy?: Autonomy;
+    budgetUsd?: number | null;
+  }) => post<RunSummary>("/autopilot/runs", body),
+  runAction: (
+    id: string,
+    action: "pause" | "resume" | "cancel",
+    note?: string,
+  ) =>
+    post<RunSummary>(
+      `/autopilot/runs/${encodeURIComponent(id)}/${action}`,
+      note ? { note } : {},
+    ),
+  release: (id: string) =>
+    post<RunSummary>(`/autopilot/runs/${encodeURIComponent(id)}/release`),
+  inbox: (state: "open" | "decided" | "all" = "open") =>
+    request<InboxItem[]>(`/autopilot/inbox?state=${state}`),
+  inboxCount: () => request<{ open: number }>("/autopilot/inbox/count"),
+  decide: (id: number, body: { choice: string; note?: string }) =>
+    post<InboxItem>(`/autopilot/inbox/${id}/decide`, body),
+};
