+  route("autopilot", "factory/routes/autopilot.tsx"),
+  route(
+    "autopilot/runs/:runId/:workOrderKey?",
+    "factory/routes/autopilot-run.tsx",
+  ),
+  route("inbox", "factory/routes/inbox.tsx"),
+  route("requirements/:changeId?", "factory/routes/requirements.tsx"),
+  route("work-orders/:workOrderId?", "factory/routes/work-orders.tsx"),
