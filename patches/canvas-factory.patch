+}
+
+function RunBanner({ run }: { run: RunDetail }) {
+  const copy = useFactoryCopy();
+  let text: string | null = null;
+  let tone: "warning" | "error" | "success" = "warning";
+  if (run.state === "paused" && run.pausedReason) {
+    text = copy.pipeline.pausedBecause(run.pausedReason);
+  } else if (run.state === "failed") {
+    text = copy.pipeline.failedHelp;
+    tone = "error";
+  } else if (run.state === "done") {
+    text = copy.pipeline.doneHelp(run.integrationBranch, run.baseBranch);
+    tone = "success";
+  } else if (run.state === "releasing") {
+    text = copy.pipeline.releasingHelp(run.baseBranch);
+  } else if (run.state === "released") {
+    text = copy.pipeline.releasedHelp(
+      run.baseBranch,
+      approverName(run.releasedBy ?? ""),
+      (run.releasedSha ?? "").slice(0, 10),
+    );
+    tone = "success";
+  }
+  if (!text) return null;
+  return (
+    <p
+      role="status"
+      data-testid="factory-run-banner"
+      className={cn(
+        "rounded-lg border bg-surface px-3 py-2 text-sm text-foreground",
+        tone === "warning" && "border-warning",
+        tone === "error" && "border-feedback-error",
+        tone === "success" && "border-success",
+      )}
+    >
+      {text}
+    </p>
+  );
+}
+
+function StageLanes({ run }: { run: RunDetail }) {
+  const copy = useFactoryCopy();
+  const current = STAGES.indexOf(currentStage(run));
+  const inLane = (stage: Stage) =>
+    run.workOrders.filter((w) => LANE[w.state] === stage).length;
+  const waiting =
+    run.state === "awaiting_spec_approval" ||
+    run.state === "awaiting_answers" ||
+    run.state === "awaiting_plan_approval" ||
+    run.state === "paused";
+
+  return (
+    <ol
+      aria-label={copy.pipeline.labels.pipeline}
+      className="grid grid-cols-3 gap-2 md:grid-cols-6"
+    >
+      {STAGES.map((stage, i) => {
+        const count = i >= 2 ? inLane(stage) : 0;
+        const passed =
+          i < current ||
+          (stage === "done" &&
+            (run.state === "done" || run.state === "released"));
+        const here =
+          i === current &&
+          run.state !== "done" &&
+          !FINISHED_RUN_STATES.has(run.state);
+        // During the build, every work-order lane with work in it is live.
+        const live = run.state === "building" && i >= 2 && i <= 4 && count > 0;
+        return (
+          <li
+            key={stage}
+            aria-current={here ? "step" : undefined}
+            className={cn(
+              "flex flex-col gap-1 rounded-lg border px-3 py-2",
