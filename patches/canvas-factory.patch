+          <dt className="sr-only">{copy.pipeline.labels.state}</dt>
+          <dd>
+            <RunStatePill state={run.state} />
+          </dd>
+        </div>
+        <div>
+          <dt className="sr-only">{copy.pipeline.labels.cost}</dt>
+          <dd
+            className="tabular-nums text-foreground"
+            data-testid="factory-run-cost"
+          >
+            {copy.autopilot.cost(
+              money(run.costUsd),
+              `${money(run.budgetUsd)}${run.budgetSource === "policy" ? ` (${copy.autopilot.policyBudget})` : ""}`,
+            )}
+          </dd>
+        </div>
+        {run.counts.total ? (
+          <div>
+            <dt className="sr-only">{copy.pipeline.labels.progress}</dt>
+            <dd className="tabular-nums text-foreground">
+              {copy.autopilot.progress(run.counts.merged, run.counts.total)}
+            </dd>
+          </div>
+        ) : null}
+        {run.projectedCostUsd !== null ? (
