+            className="flex min-w-56 max-w-80 flex-1 basis-0 flex-col gap-2"
+          >
+            <h2 className="flex items-center gap-2 px-1 text-xs font-medium text-muted">
+              <StatusPill status={status} statuses={list.statuses} />
+              <span className="tabular-nums">{column.length}</span>
