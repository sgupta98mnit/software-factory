+import React from "react";
+import { Link, NavLink, useNavigate, useParams } from "react-router";
+import { Bot, CircleCheck, CircleDashed, ListChecks } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import {
+  FactoryApi,
+  type ChangeDetail,
+  type Requirement,
+  type ValidationResult,
+} from "../api";
+import { useFactoryCopy } from "../copy";
+import {
+  useChangeDetail,
+  useFactoryHealth,
+  useSpecsOverview,
+  useValidateSpecs,
+  useWorkOrders,
+} from "../hooks";
+import {
+  FactoryError,
+  FactoryLoading,
+  FactoryPage,
+} from "../components/factory-page";
+import { FactoryMarkdown } from "../components/factory-markdown";
+import { StartAgentModal } from "../components/start-agent-modal";
+import { WorkOrderPlanModal } from "../components/work-order-plan-modal";
+
+type Tab = "requirements" | "proposal" | "design" | "tasks";
+const TABS: Tab[] = ["requirements", "proposal", "design", "tasks"];
+
+export default function FactoryRequirementsRoute() {
+  const copy = useFactoryCopy();
+  const { changeId } = useParams();
+  const navigate = useNavigate();
+  const overview = useSpecsOverview();
+  const health = useFactoryHealth();
+  const changes = overview.data?.changes.changes ?? [];
+  const specs = overview.data?.specs.specs ?? [];
+
+  // Open the first change when none is picked.
+  React.useEffect(() => {
+    if (!changeId && changes[0]) {
+      navigate(`/requirements/${changes[0].name}`, { replace: true });
+    }
+  }, [changeId, changes, navigate]);
+
+  return (
+    <FactoryPage
+      testId="factory-requirements"
+      title={copy.requirements.title}
+      subtitle={
+        health.data
+          ? copy.requirements.subtitle(health.data.workspace.name)
+          : undefined
+      }
+      error={overview.error}
+      onRetry={() => void overview.refetch()}
+      fill
+    >
+      <aside className="w-72 shrink-0 overflow-y-auto border-r border-border-subtle px-3 py-4 custom-scrollbar">
+        <h2 className="px-2 text-xs font-medium text-muted">
+          {copy.requirements.changes}
+        </h2>
+        <ul className="mt-1 flex flex-col gap-0.5">
+          {changes.map((c) => (
+            <li key={c.name}>
+              <NavLink
+                to={`/requirements/${c.name}`}
+                className={({ isActive }) =>
+                  cn(
+                    "block rounded-lg px-2 py-2 hover:bg-surface-raised",
+                    isActive && "bg-interactive-selected",
+                  )
+                }
+              >
+                <span className="block truncate font-mono text-sm text-foreground">
+                  {c.name}
+                </span>
+                <span className="mt-1.5 flex items-center gap-2">
+                  <span
+                    className="h-1 flex-1 overflow-hidden rounded-full bg-surface-raised"
+                    aria-hidden
+                  >
+                    <span
+                      className="block h-full w-(--factory-progress) bg-success"
+                      style={
+                        {
+                          "--factory-progress": `${c.totalTasks ? (100 * c.completedTasks) / c.totalTasks : 0}%`,
+                        } as React.CSSProperties
+                      }
+                    />
+                  </span>
+                  <span className="text-xs tabular-nums text-muted">
+                    {copy.requirements.tasks(c.completedTasks, c.totalTasks)}
+                  </span>
+                </span>
+              </NavLink>
+            </li>
+          ))}
+          {overview.data && changes.length === 0 ? (
+            <li className="px-2 py-2 text-sm text-muted">
+              {copy.requirements.noChanges}
+            </li>
+          ) : null}
+        </ul>
+
+        <h2 className="mt-6 px-2 text-xs font-medium text-muted">
+          {copy.requirements.specs}
+        </h2>
+        <ul className="mt-1">
+          {specs.map((s) => (
+            <li key={s.id} className="px-2 py-1 text-sm">
+              <span className="font-mono text-foreground">{s.id}</span>{" "}
+              <span className="text-muted">
+                {copy.requirements.requirementCount(s.requirementCount)}
+              </span>
+            </li>
+          ))}
+          {overview.data && specs.length === 0 ? (
