+          <p className="flex items-center gap-2 text-sm text-foreground">
+            <ShieldCheck className="size-4 text-success" aria-hidden />
+            {`${copy.workOrders.approvedBy(actorName(wo.approval.by))} · ${formatWhen(wo.approval.at, i18n.language)}`}
+          </p>
+        ) : null}
+        {wo.doneWithoutApproval ? (
+          <div
+            role="alert"
+            className="flex flex-col gap-2 rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
+          >
+            <p className="flex items-center gap-2 font-medium text-foreground">
+              <TriangleAlert className="size-4 text-warning" aria-hidden />
+              {copy.workOrders.notApproved}
+            </p>
+            <p className="text-muted">{copy.workOrders.notApprovedHelp}</p>
+          </div>
+        ) : null}
+
+        <div className="flex flex-wrap gap-2">
+          {/* Not started: the next step is an agent. Started: the next step is your approval. */}
+          {canApprove ? (
+            <BrandButton
+              testId="factory-approve"
+              type="button"
+              variant="primary"
+              onClick={() => setApproveOpen(true)}
+              startContent={<ShieldCheck className="size-4" aria-hidden />}
+            >
+              {copy.workOrders.approve}
+            </BrandButton>
+          ) : null}
+          {!isFinal ? (
+            <BrandButton
+              testId="factory-start-agent"
+              type="button"
+              variant={canApprove ? "secondary" : "primary"}
+              onClick={() => setAgentOpen(true)}
+              startContent={<Bot className="size-4" aria-hidden />}
+            >
+              {copy.workOrders.startAgent}
+            </BrandButton>
+          ) : null}
+          {moves.map((status) => (
+            <BrandButton
+              key={status}
+              type="button"
+              variant="tertiary"
+              onClick={() => setStatus.mutate({ id: wo.id, status })}
+              isDisabled={setStatus.isPending}
+            >
+              {isFinal && status === reviewStatus
+                ? copy.workOrders.reopen(status)
+                : copy.workOrders.moveTo(status)}
+            </BrandButton>
+          ))}
+        </div>
+        <FactoryError error={setStatus.error} />
+
+        {wo.description ? (
+          <DetailSection title={copy.workOrders.description}>
+            <FactoryMarkdown text={wo.description} />
+          </DetailSection>
+        ) : null}
+
+        {wo.acceptanceCriteria.length ? (
+          <DetailSection title={copy.workOrders.criteria}>
+            <ul className="flex flex-col gap-1.5">
+              {wo.acceptanceCriteria.map((ac) => (
+                <li key={ac.index} className="flex items-start gap-2 text-sm">
+                  {ac.done ? (
+                    <CircleCheck
+                      className="mt-0.5 size-4 shrink-0 text-success"
+                      aria-label={copy.requirements.artifactDone}
+                    />
+                  ) : (
+                    <Circle
+                      className="mt-0.5 size-4 shrink-0 text-muted"
+                      aria-hidden
+                    />
+                  )}
+                  <FactoryMarkdown text={ac.text} className="min-w-0" />
+                </li>
+              ))}
+            </ul>
+          </DetailSection>
+        ) : null}
+
+        {wo.finalSummary ? (
+          <DetailSection title={copy.workOrders.finalSummary}>
+            <FactoryMarkdown text={wo.finalSummary} />
+          </DetailSection>
+        ) : null}
+        {wo.notes ? (
+          <DetailSection title={copy.workOrders.notes}>
+            <FactoryMarkdown text={wo.notes} />
+          </DetailSection>
+        ) : null}
+        {wo.plan ? (
+          <DetailSection title={copy.workOrders.plan}>
+            <FactoryMarkdown text={wo.plan} />
+          </DetailSection>
+        ) : null}
+
+        <DetailSection title={copy.workOrders.agentConversations}>
+          {wo.conversations.length ? (
+            <ul className="flex flex-col gap-1">
+              {wo.conversations.map((c) => (
+                <li key={c.id} className="text-sm">
+                  <Link
+                    to={`/conversations/${c.id}`}
+                    className="inline-flex items-center gap-1.5 text-link hover:underline"
+                  >
+                    <MessageSquare className="size-3.5" aria-hidden />
+                    {c.agent || copy.workOrders.openConversation}
+                  </Link>{" "}
+                  <span className="text-muted">
+                    {`${actorName(c.by)} · ${formatWhen(c.at, i18n.language)}`}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <p className="text-sm text-muted">
+              {copy.workOrders.noConversations}
+            </p>
+          )}
+        </DetailSection>
+
+        {wo.dependencies.length ? (
+          <DetailSection title={copy.workOrders.dependencies}>
+            <ul className="flex flex-wrap gap-2">
+              {wo.dependencies.map((d) => (
+                <li key={d}>
+                  <Link
+                    to={hrefFor(d)}
+                    className="font-mono text-sm text-link hover:underline"
+                  >
+                    {d}
+                  </Link>
+                </li>
+              ))}
+            </ul>
+          </DetailSection>
+        ) : null}
+
+        {wo.labels.length ? (
+          <DetailSection title={copy.workOrders.labels}>
+            <div className="flex flex-wrap gap-1">
+              {wo.labels.map((l) => (
+                <LabelChip key={l} label={l} />
+              ))}
+            </div>
+          </DetailSection>
+        ) : null}
+
+        <DetailSection title={copy.workOrders.file}>
+          <code className="break-all font-mono text-xs text-muted">
+            {wo.file}
+          </code>
+        </DetailSection>
+
+        <Link
+          to={`/audit-log?q=${encodeURIComponent(wo.id)}`}
+          className="inline-flex items-center gap-1.5 text-sm text-link hover:underline"
+        >
+          <History className="size-4" aria-hidden />
+          {copy.workOrders.history}
+        </Link>
+      </div>
+
+      {agentOpen ? (
+        <StartAgentModal
+          subject={wo.id}
+          loadBrief={async () => (await FactoryApi.workOrderBrief(wo.id)).text}
+          onStarted={(conversationId, agent) =>
+            FactoryApi.linkConversation(wo.id, conversationId, agent).then(
+              () => undefined,
+            )
+          }
+          onClose={() => setAgentOpen(false)}
+        />
+      ) : null}
+      {approveOpen ? (
+        <ApproveModal
+          workOrder={wo}
+          finalStatus={finalStatus}
+          openDependencies={openDependencies}
+          onClose={() => setApproveOpen(false)}
+        />
+      ) : null}
+    </aside>
+  );
+}
+
+function DetailSection({
+  title,
+  children,
+}: {
+  title: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <section className="flex flex-col gap-1.5">
+      <h3 className="text-xs font-medium text-muted">{title}</h3>
+      {children}
+    </section>
+  );
+}
