+      </span>
+      <span className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
+        {wo.attempts ? (
+          <span>{copy.pipeline.attempt(wo.attempts, wo.round)}</span>
+        ) : null}
+        {wo.costUsd ? (
+          <span
+            className={cn(
+              "tabular-nums",
+              wo.costUsd >= wo.budgetUsd && "text-warning",
+            )}
+          >
+            {copy.autopilot.cost(
+              formatMoney(wo.costUsd, i18n.language),
+              formatMoney(wo.budgetUsd, i18n.language),
+            )}
+          </span>
+        ) : null}
+        {wo.dependsOn.length && wo.state === "pending" ? (
+          <span>
