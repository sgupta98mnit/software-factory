+  LabelChip,
+  StatusPill,
+  actorName,
+  formatWhen,
+} from "../components/factory-badges";
+import { FactoryMarkdown } from "../components/factory-markdown";
+import { ApproveModal } from "../components/approve-modal";
+import {
+  StartAgentModal,
+  factoryFieldClassName,
+} from "../components/start-agent-modal";
+
+const changeOf = (wo: WorkOrder) =>
+  wo.labels.find((l) => l.startsWith("change:"))?.slice("change:".length);
+
+export default function FactoryWorkOrdersRoute() {
+  const copy = useFactoryCopy();
+  const { workOrderId } = useParams();
+  const [searchParams, setSearchParams] = useSearchParams();
+  const navigate = useNavigate();
+  const health = useFactoryHealth();
+  const list = useWorkOrders();
+  const changeFilter = searchParams.get("change") ?? "";
+
+  const all = list.data?.workOrders ?? [];
+  const changes = [...new Set(all.map(changeOf).filter(Boolean))] as string[];
+  const shown = changeFilter
+    ? all.filter((w) => changeOf(w) === changeFilter)
+    : all;
+  const selected = workOrderId
+    ? all.find((w) => w.id.toLowerCase() === workOrderId.toLowerCase())
+    : undefined;
+  const query = searchParams.toString();
+  const hrefFor = (id?: string) =>
+    `/work-orders${id ? `/${id}` : ""}${query ? `?${query}` : ""}`;
+
+  return (
+    <FactoryPage
+      testId="factory-work-orders"
+      title={copy.workOrders.title}
+      subtitle={
+        health.data
+          ? copy.workOrders.subtitle(health.data.workspace.name)
+          : undefined
+      }
+      error={list.error}
+      onRetry={() => void list.refetch()}
+      fill
+      actions={
+        changes.length > 0 ? (
+          <label className="flex items-center gap-2 text-sm text-muted">
+            {copy.workOrders.filterLabel}
+            <select
+              data-testid="factory-change-filter"
+              className={cn(factoryFieldClassName, "h-9 w-auto py-0")}
+              value={changeFilter}
+              onChange={(e) => {
+                const next = new URLSearchParams(searchParams);
+                if (e.target.value) next.set("change", e.target.value);
+                else next.delete("change");
+                setSearchParams(next);
+              }}
+            >
+              <option value="">{copy.workOrders.allChanges}</option>
+              {changes.map((c) => (
+                <option key={c} value={c}>
+                  {c}
+                </option>
+              ))}
+            </select>
+          </label>
+        ) : null
+      }
+    >
+      <div className="min-w-0 flex-1 overflow-auto custom-scrollbar-always">
+        {list.isLoading ? <FactoryLoading /> : null}
+        {list.data && !list.data.initialized ? (
+          <p className="px-6 py-6 text-sm text-muted">
+            {copy.workOrders.notInitialized}
+          </p>
+        ) : null}
+        {list.data?.initialized && all.length === 0 ? (
+          <p className="px-6 py-6 text-sm text-muted">
+            {copy.workOrders.empty}{" "}
+            <Link to="/requirements" className="text-link underline">
+              {copy.nav.requirements}
+            </Link>
+          </p>
+        ) : null}
+        {list.data && all.length > 0 ? (
+          <Board
+            list={list.data}
+            workOrders={shown}
+            selectedId={selected?.id}
