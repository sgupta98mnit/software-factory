@@ -0,0 +1,105 @@
+import React from "react";
+import { PlugZap } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import { FactoryOfflineError } from "../api";
+import { useFactoryCopy } from "../copy";
+import { useFactoryLiveUpdates } from "../hooks";
+
+interface FactoryPageProps {
+  testId: string;
+  title: string;
+  subtitle?: React.ReactNode;
+  actions?: React.ReactNode;
+  /** A query error from the page's data; the offline card replaces the page when the API is down. */
+  error?: unknown;
+  onRetry?: () => void;
+  /** Body fills the remaining height (for side-by-side panes) instead of scrolling as one column. */
+  fill?: boolean;
+  children: React.ReactNode;
+}
+
+/** Common frame for the factory pages: header, live updates, and the "API isn't running" state. */
+export function FactoryPage({
+  testId,
+  title,
+  subtitle,
+  actions,
+  error,
+  onRetry,
+  fill = false,
+  children,
+}: FactoryPageProps) {
+  useFactoryLiveUpdates();
+  const offline = error instanceof FactoryOfflineError;
+
+  return (
+    <div data-testid={testId} className="flex h-full min-h-0 flex-col">
+      <header className="flex shrink-0 flex-wrap items-start gap-3 border-b border-border-subtle px-6 py-5">
+        <div className="min-w-0 flex-1">
+          <h1 className="text-lg font-semibold text-foreground">{title}</h1>
+          {subtitle ? (
+            <p className="mt-1 text-sm text-muted">{subtitle}</p>
+          ) : null}
+        </div>
+        {actions && !offline ? (
+          <div className="flex shrink-0 flex-wrap items-center gap-2">
+            {actions}
+          </div>
+        ) : null}
+      </header>
+      <div
+        className={cn(
+          "min-h-0 flex-1",
+          fill ? "flex" : "overflow-y-auto custom-scrollbar-always",
+        )}
+      >
+        {offline ? <FactoryOffline onRetry={onRetry} /> : children}
+      </div>
+    </div>
+  );
+}
+
+export function FactoryOffline({ onRetry }: { onRetry?: () => void }) {
+  const copy = useFactoryCopy();
+  return (
+    <div
+      data-testid="factory-offline"
+      className="mx-auto flex max-w-xl flex-col items-start gap-3 px-6 py-16"
+    >
+      <PlugZap className="size-8 text-muted" aria-hidden />
+      <h2 className="text-base font-semibold text-foreground">
+        {copy.offline.title}
+      </h2>
+      <p className="text-sm text-muted">{copy.offline.body}</p>
+      <code className="rounded-md border border-border-subtle bg-surface px-3 py-2 font-mono text-sm text-foreground">
+        {copy.offline.command}
+      </code>
+      <p className="text-sm text-muted">{copy.offline.hint}</p>
+      {onRetry ? (
+        <BrandButton type="button" variant="secondary" onClick={onRetry}>
+          {copy.common.retry}
+        </BrandButton>
+      ) : null}
+    </div>
+  );
+}
+
+/** A plain error line for anything that isn't "the API is down". */
+export function FactoryError({ error }: { error: unknown }) {
+  if (!error || error instanceof FactoryOfflineError) return null;
+  return (
+    <p role="alert" className="text-sm text-feedback-error">
+      {error instanceof Error ? error.message : String(error)}
+    </p>
+  );
+}
+
+export function FactoryLoading() {
+  const copy = useFactoryCopy();
+  return (
+    <p className="px-6 py-6 text-sm text-muted" aria-live="polite">
+      {copy.common.loading}
+    </p>
+  );
+}
diff --git a/src/factory/components/start-agent-modal.tsx b/src/factory/components/start-agent-modal.tsx
new file mode 100644
index 0000000..1b70afb
--- /dev/null
+++ b/src/factory/components/start-agent-modal.tsx
@@ -0,0 +1,204 @@
+import React from "react";
+import { useNavigate } from "react-router";
+import { ModalBackdrop } from "#/components/shared/modals/modal-backdrop";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { useAgentProfiles } from "#/hooks/query/use-agent-profiles";
+import { useCreateConversation } from "#/hooks/mutation/use-create-conversation";
+import { cn } from "#/utils/utils";
+import { useFactoryCopy } from "../copy";
+import { useFactoryHealth } from "../hooks";
+
+export const factoryFieldClassName =
+  "w-full rounded-lg border border-border bg-base-secondary px-3 py-2 text-sm text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-focus";
+
+interface StartAgentModalProps {
+  /** What the agent works on, for the title: "WO-1" or a change name. */
+  subject: string;
+  /** Loads the first message (the brief) from the factory API. */
+  loadBrief: () => Promise<string>;
+  /** Called with the new conversation before we navigate to it, to link it in the audit log. */
+  onStarted?: (conversationId: string, agentName: string) => Promise<void>;
+  onClose: () => void;
+}
+
+/**
+ * Starts a normal Canvas conversation in the factory workspace, with the
+ * agent profile you pick (Claude Code, Codex, OpenHands...) and a brief
+ * written from the work order. Then it opens that conversation.
+ */
+export function StartAgentModal({
+  subject,
+  loadBrief,
+  onStarted,
+  onClose,
+}: StartAgentModalProps) {
+  const copy = useFactoryCopy();
+  const navigate = useNavigate();
+  const { data: health } = useFactoryHealth();
+  const { data: profileList } = useAgentProfiles();
+  const createConversation = useCreateConversation({ disableToast: true });
+
+  const [message, setMessage] = React.useState("");
+  const [loadingBrief, setLoadingBrief] = React.useState(true);
+  const [error, setError] = React.useState<string | null>(null);
+  const [profileId, setProfileId] = React.useState("");
+
+  React.useEffect(() => {
+    let cancelled = false;
+    loadBrief()
+      .then((text) => !cancelled && setMessage(text))
+      .catch((e: Error) => !cancelled && setError(e.message))
+      .finally(() => !cancelled && setLoadingBrief(false));
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const profiles = (profileList?.profiles ?? []).filter((p) => p.id);
+  const activeId = profileList?.active_agent_profile_id ?? null;
+  const active = profiles.find((p) => p.id === activeId);
+  const workspace = health?.workspace;
+  const busy = createConversation.isPending;
+  const canStart =
+    Boolean(workspace?.exists) && message.trim().length > 0 && !busy;
+
+  const start = async () => {
+    if (!workspace) return;
+    setError(null);
+    const chosen = profiles.find((p) => p.id === profileId) ?? active;
+    try {
+      const result = await createConversation.mutateAsync({
+        query: message,
+        workingDir: workspace.agentPath || workspace.path,
+        agentProfileId: profileId || undefined,
+        entryPoint: "software-factory",
+      });
+      await onStarted?.(result.conversation_id, chosen?.name ?? "");
+      onClose();
+      navigate(`/conversations/${result.conversation_id}`);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    }
+  };
+
+  const profileLabel = (name: string, kind: string) =>
+    `${name} (${copy.agent.kinds[kind] ?? kind})`;
+
+  return (
+    <ModalBackdrop
+      onClose={busy ? undefined : onClose}
+      closeOnEscape={!busy}
+      aria-label={copy.agent.title(subject)}
+    >
+      <div
+        data-testid="factory-start-agent-modal"
+        className="flex max-h-screen w-full max-w-2xl flex-col gap-4 overflow-y-auto rounded-xl border border-border bg-base-secondary p-5"
+      >
+        <h2 className="text-base font-semibold text-foreground">
+          {copy.agent.title(subject)}
+        </h2>
+
+        <div className="flex flex-col gap-1.5">
+          {profiles.length ? (
+            <label
+              htmlFor="factory-agent-profile"
+              className="text-sm font-medium text-foreground"
+            >
+              {copy.agent.agentLabel}
+            </label>
+          ) : (
+            <span className="text-sm font-medium text-foreground">
+              {copy.agent.agentLabel}
+            </span>
+          )}
+          {profiles.length ? (
+            <select
+              id="factory-agent-profile"
+              data-testid="factory-agent-profile"
+              className={cn(factoryFieldClassName, "h-9 py-0")}
+              value={profileId}
+              onChange={(e) => setProfileId(e.target.value)}
+              disabled={busy}
+            >
+              <option value="">
+                {active
+                  ? `${copy.agent.activeProfile}: ${profileLabel(active.name, active.agent_kind)}`
+                  : copy.agent.activeProfile}
+              </option>
+              {profiles
+                .filter((p) => p.id !== activeId)
+                .map((p) => (
+                  <option key={p.id} value={p.id ?? ""}>
+                    {profileLabel(p.name, p.agent_kind)}
+                  </option>
+                ))}
+            </select>
+          ) : (
+            <p className="text-sm text-muted">{copy.agent.noProfiles}</p>
+          )}
+        </div>
+
+        <div className="flex flex-col gap-1.5">
+          <span className="text-sm font-medium text-foreground">
+            {copy.agent.folderLabel}
+          </span>
+          <code className="break-all rounded-lg border border-border-subtle bg-surface px-3 py-2 font-mono text-xs text-muted">
+            {workspace
+              ? workspace.agentPath || workspace.path
+              : copy.common.loading}
+          </code>
+          {workspace && !workspace.exists ? (
+            <p role="alert" className="text-sm text-feedback-error">
+              {copy.agent.workspaceMissing(workspace.path)}
+            </p>
+          ) : null}
+        </div>
+
+        <div className="flex flex-col gap-1.5">
+          <label
+            htmlFor="factory-agent-message"
+            className="text-sm font-medium text-foreground"
+          >
+            {copy.agent.messageLabel}
+          </label>
+          <p className="text-xs text-muted">{copy.agent.messageHelp}</p>
+          <textarea
+            id="factory-agent-message"
+            data-testid="factory-agent-message"
+            className={cn(factoryFieldClassName, "min-h-64 font-mono text-xs")}
+            value={loadingBrief ? copy.common.loading : message}
+            onChange={(e) => setMessage(e.target.value)}
+            disabled={loadingBrief || busy}
+          />
+        </div>
+
+        {error ? (
+          <p role="alert" className="text-sm text-feedback-error">
+            {error}
+          </p>
+        ) : null}
+
+        <div className="flex justify-end gap-2">
+          <BrandButton
+            type="button"
+            variant="secondary"
+            onClick={onClose}
+            isDisabled={busy}
+          >
+            {copy.common.cancel}
+          </BrandButton>
+          <BrandButton
+            testId="factory-start-agent-confirm"
+            type="button"
+            variant="primary"
+            onClick={() => void start()}
+            isDisabled={!canStart}
+            aria-busy={busy}
+          >
+            {busy ? copy.agent.starting : copy.agent.start}
+          </BrandButton>
+        </div>
+      </div>
+    </ModalBackdrop>
+  );
+}
