index 0000000..febecfb
--- /dev/null
+++ b/src/factory/routes/inbox.tsx
@@ -0,0 +1,383 @@
+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Link, useSearchParams } from "react-router";
+import { History, Inbox as InboxIcon } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { displaySuccessToast } from "#/utils/custom-toast-handlers";
+import { cn } from "#/utils/utils";
+import type { InboxItemView, InboxOption, RunSummary } from "../api";
+import { useFactoryCopy } from "../copy";
+import {
+  useAutopilotInbox,
+  useAutopilotInboxCount,
+  useAutopilotRuns,
+  useDecideInbox,
+} from "../hooks";
+import {
+  FactoryError,
+  FactoryLoading,
+  FactoryPage,
+} from "../components/factory-page";
+import {
+  INBOX_TONE,
+  StateChip,
+  actorName,
+  formatWhen,
+  labelFor,
+} from "../components/factory-badges";
+import { FactoryMarkdown } from "../components/factory-markdown";
+import { ConfirmModal } from "../components/confirm-modal";
+import { factoryFieldClassName } from "../components/start-agent-modal";
+
+type View = "open" | "history";
+const VIEW_PARAM = "view";
+const RUN_PARAM = "run";
+// Options the server doesn't give a tone still read as dangerous when they end something.
+const DANGER_OPTION = /^(cancel|skip)/;
+
+const toneOf = (option: InboxOption) =>
+  option.tone ?? (DANGER_OPTION.test(option.id) ? "danger" : "default");
+
+/** "ap-1a2b3c4d/WO-3" -> "WO-3" */
+const workOrderKey = (workOrderId: string | null) =>
+  workOrderId?.split("/").pop() ?? null;
+
+export default function AutopilotInboxRoute() {
+  const copy = useFactoryCopy();
+  const [searchParams, setSearchParams] = useSearchParams();
+  const view: View =
+    searchParams.get(VIEW_PARAM) === "history" ? "history" : "open";
+  const runFilter = searchParams.get(RUN_PARAM) ?? "";
+  // History includes items dismissed when a run was cancelled, so ask for all.
+  const inbox = useAutopilotInbox(view === "open" ? "open" : "all");
+  const count = useAutopilotInboxCount();
+  const runs = useAutopilotRuns();
+  const runById = new Map(runs.data?.map((run) => [run.id, run]));
+
+  const items = (inbox.data ?? []).filter(
+    (item) =>
+      (view === "open" ? item.state === "open" : item.state !== "open") &&
+      (!runFilter || item.runId === runFilter),
+  );
+
+  const setParam = (key: string, value: string | null) => {
+    const next = new URLSearchParams(searchParams);
+    if (value) next.set(key, value);
+    else next.delete(key);
+    setSearchParams(next, { replace: true });
+  };
+
+  const openCount = count.data?.open;
+  const views: { id: View; label: string; icon: React.ReactNode }[] = [
+    {
+      id: "open",
+      label:
+        openCount !== undefined && openCount > 0
+          ? `${copy.inbox.open} (${openCount})`
+          : copy.inbox.open,
+      icon: <InboxIcon className="size-4" aria-hidden />,
+    },
+    {
+      id: "history",
+      label: copy.inbox.history,
+      icon: <History className="size-4" aria-hidden />,
+    },
+  ];
+
+  return (
+    <FactoryPage
+      testId="factory-inbox"
+      title={copy.inbox.title}
+      subtitle={copy.inbox.subtitle}
+      error={inbox.error}
+      onRetry={() => void inbox.refetch()}
+      actions={
+        <div
+          role="group"
+          aria-label={copy.inbox.viewLabel}
+          className="inline-flex rounded-lg border border-border bg-base-secondary p-0.5"
+        >
+          {views.map((v) => (
+            <button
+              key={v.id}
+              type="button"
+              data-testid={`inbox-view-${v.id}`}
+              aria-pressed={view === v.id}
+              onClick={() =>
+                setParam(VIEW_PARAM, v.id === "open" ? null : v.id)
+              }
+              className={cn(
+                "inline-flex h-8 items-center gap-1.5 rounded-md px-3 text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-focus",
+                view === v.id
+                  ? "bg-interactive-selected font-medium text-foreground"
+                  : "text-muted hover:text-foreground",
+              )}
+            >
+              {v.icon}
+              {v.label}
+            </button>
+          ))}
+        </div>
+      }
+    >
+      <div className="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 py-5 sm:px-6">
+        {runFilter ? (
+          <p
+            role="status"
+            className="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted"
+          >
+            {copy.inbox.forRun(runById.get(runFilter)?.change ?? runFilter)}
+            <button
+              type="button"
+              onClick={() => setParam(RUN_PARAM, null)}
+              className="rounded-md text-link hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-focus"
+            >
+              {copy.inbox.showAll}
+            </button>
+          </p>
+        ) : null}
+
+        {inbox.isLoading ? <FactoryLoading /> : null}
+        <FactoryError error={inbox.error} />
+
+        {inbox.data && items.length === 0 ? (
+          <div className="flex flex-col items-start gap-2 py-8">
+            <InboxIcon className="size-8 text-muted" aria-hidden />
+            <p className="text-sm text-muted">
+              {view === "open" ? copy.inbox.empty : copy.inbox.emptyHistory}
+            </p>
+            {view === "open" ? (
+              <Link
+                to="/autopilot"
+                className="rounded-md text-sm text-link hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-focus"
+              >
+                {copy.nav.autopilot}
+              </Link>
+            ) : null}
+          </div>
+        ) : null}
+
+        {items.length > 0 ? (
+          <ul className="flex flex-col gap-3">
+            {items.map((item) => (
+              <li key={item.id}>
+                {view === "open" ? (
+                  <OpenItem item={item} run={runById.get(item.runId)} />
+                ) : (
+                  <DecidedItem item={item} run={runById.get(item.runId)} />
+                )}
+              </li>
+            ))}
+          </ul>
+        ) : null}
+      </div>
+    </FactoryPage>
+  );
+}
+
+/** Kind, run and work order: the line above every item's title. */
+function ItemContext({ item, run }: { item: InboxItemView; run?: RunSummary }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const woKey = workOrderKey(item.workOrderId);
+  return (
+    <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
+      <StateChip
+        tone={INBOX_TONE[item.kind]}
+        label={labelFor(copy.inbox.kind, item.kind)}
+      />
+      <Link
+        to={`/autopilot/runs/${item.runId}`}
+        className="rounded-md font-mono text-link hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-focus"
+      >
+        {run?.change ?? item.runId}
+      </Link>
+      {woKey ? <span className="font-mono">{woKey}</span> : null}
+      <time dateTime={item.createdAt}>
+        {formatWhen(item.createdAt, i18n.language)}
+      </time>
+    </div>
+  );
+}
+
+function OpenItem({ item, run }: { item: InboxItemView; run?: RunSummary }) {
+  const copy = useFactoryCopy();
+  const decide = useDecideInbox();
+  const [note, setNote] = React.useState("");
+  const [noteError, setNoteError] = React.useState<string | null>(null);
+  const [confirming, setConfirming] = React.useState<InboxOption | null>(null);
+  const noteRef = React.useRef<HTMLTextAreaElement>(null);
+  const noteOptions = item.options.filter((o) => o.needsNote);
+  const busy = decide.isPending;
+  const ids = {
+    title: `inbox-${item.id}-title`,
+    note: `inbox-${item.id}-note`,
+    noteHelp: `inbox-${item.id}-note-help`,
+    noteError: `inbox-${item.id}-note-error`,
+  };
+
+  const submit = (option: InboxOption) =>
+    decide.mutate(
+      { id: item.id, choice: option.id, note: note.trim() || undefined },
+      {
+        onSuccess: () => {
+          setConfirming(null);
+          displaySuccessToast(copy.inbox.recorded(option.label));
+        },
+      },
+    );
+
+  const choose = (option: InboxOption) => {
+    if (option.needsNote && !note.trim()) {
+      setNoteError(copy.inbox.noteRequired(option.label));
+      noteRef.current?.focus();
+      return;
+    }
+    setNoteError(null);
+    if (toneOf(option) === "danger") setConfirming(option);
+    else submit(option);
+  };
+
+  return (
+    <article
+      aria-labelledby={ids.title}
+      data-testid={`inbox-item-${item.id}`}
+      className="flex flex-col gap-3 rounded-xl border border-border-subtle bg-surface px-4 py-4"
+    >
+      <ItemContext item={item} run={run} />
+      <div>
+        <h2 id={ids.title} className="text-base font-semibold text-foreground">
+          {item.title}
+        </h2>
+        {run ? (
+          <p className="mt-0.5 line-clamp-2 text-sm text-muted">{run.goal}</p>
+        ) : null}
+      </div>
+
+      {item.body ? (
+        <div className="overflow-x-auto custom-scrollbar">
+          <FactoryMarkdown text={item.body} headings />
+        </div>
+      ) : null}
+
+      {noteOptions.length ? (
+        <div className="flex flex-col gap-1.5">
+          <label
+            htmlFor={ids.note}
+            className="text-sm font-medium text-foreground"
+          >
+            {copy.inbox.noteLabel}
+          </label>
+          <p id={ids.noteHelp} className="text-xs text-muted">
+            {copy.inbox.noteHelp(noteOptions.map((o) => o.label).join(", "))}
+          </p>
+          <textarea
+            ref={noteRef}
+            id={ids.note}
+            data-testid={`inbox-item-${item.id}-note`}
+            className={cn(factoryFieldClassName, "min-h-24")}
+            placeholder={copy.inbox.notePlaceholder}
+            aria-describedby={
+              noteError ? `${ids.noteHelp} ${ids.noteError}` : ids.noteHelp
+            }
+            aria-invalid={noteError ? true : undefined}
+            value={note}
+            onChange={(e) => {
+              setNote(e.target.value);
+              if (e.target.value.trim()) setNoteError(null);
+            }}
+            disabled={busy}
+          />
+          {noteError ? (
+            <p
+              id={ids.noteError}
+              role="alert"
+              className="text-sm text-feedback-error"
+            >
+              {noteError}
+            </p>
+          ) : null}
+        </div>
+      ) : null}
+
+      {confirming ? null : <FactoryError error={decide.error} />}
+
+      <div className="flex flex-wrap gap-2">
+        {item.options.map((option) => {
+          const tone = toneOf(option);
+          let variant: "primary" | "secondary" | "danger" = "secondary";
+          if (tone === "primary") variant = "primary";
+          if (tone === "danger") variant = "danger";
+          return (
+            <BrandButton
+              key={option.id}
+              testId={`inbox-item-${item.id}-${option.id}`}
+              type="button"
+              variant={variant}
+              onClick={() => choose(option)}
+              isDisabled={busy}
+              aria-busy={busy}
+            >
+              {option.label}
+            </BrandButton>
+          );
+        })}
+      </div>
+
+      {confirming ? (
+        <ConfirmModal
+          title={copy.inbox.confirmTitle(confirming.label)}
+          body={copy.inbox.confirmBody}
+          confirmLabel={confirming.label}
+          cancelLabel={copy.inbox.goBack}
+          busy={busy}
+          error={decide.error}
+          onConfirm={() => submit(confirming)}
+          onClose={() => setConfirming(null)}
+        />
+      ) : null}
+    </article>
+  );
+}
+
+function DecidedItem({ item, run }: { item: InboxItemView; run?: RunSummary }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const choice =
+    item.options.find((o) => o.id === item.decision)?.label ??
+    item.decision ??
+    "";
+  return (
+    <article
+      aria-label={item.title}
+      className="flex flex-col gap-2 rounded-xl border border-border-subtle px-4 py-3"
+    >
+      <ItemContext item={item} run={run} />
+      <h2 className="text-sm font-medium text-foreground">{item.title}</h2>
+      <p className="text-sm text-foreground">
+        {item.state === "dismissed"
+          ? copy.inbox.dismissed
+          : copy.inbox.decided(
+              choice,
+              actorName(item.decidedBy ?? ""),
+              item.decidedAt ? formatWhen(item.decidedAt, i18n.language) : "",
+            )}
+      </p>
+      {item.note ? (
+        <blockquote className="whitespace-pre-wrap break-words border-l-2 border-border-subtle pl-3 text-sm text-muted">
+          {item.note}
+        </blockquote>
+      ) : null}
+      {item.body ? (
+        <details>
+          <summary className="cursor-pointer rounded-md text-xs text-muted hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-focus">
+            {copy.inbox.asked}
+          </summary>
+          <div className="mt-2 overflow-x-auto custom-scrollbar">
+            <FactoryMarkdown text={item.body} headings />
+          </div>
+        </details>
+      ) : null}
+    </article>
+  );
+}
