+++ b/src/factory/hooks.ts
@@ -0,0 +1,296 @@
+import React from "react";
+import {
+  useMutation,
+  useQuery,
+  useQueryClient,
+  type QueryClient,
+} from "@tanstack/react-query";
+import {
+  FACTORY_API_BASE,
+  FactoryApi,
+  FactoryOfflineError,
+  isNotFound,
+  type Autonomy,
+} from "./api";
+
+export const FACTORY_QUERY_KEYS = {
+  all: ["factory"] as const,
+  health: ["factory", "health"] as const,
+  specs: ["factory", "specs"] as const,
+  change: (id: string) => ["factory", "specs", "change", id] as const,
+  plan: (id: string) => ["factory", "specs", "plan", id] as const,
+  workOrders: ["factory", "work-orders"] as const,
+  audit: ["factory", "audit"] as const,
+  autopilot: ["factory", "autopilot"] as const,
+  autopilotStatus: ["factory", "autopilot", "status"] as const,
+  runs: ["factory", "autopilot", "runs"] as const,
+  run: (id: string) => ["factory", "autopilot", "runs", id] as const,
+  inbox: (state: string) => ["factory", "autopilot", "inbox", state] as const,
+  inboxCount: ["factory", "autopilot", "inbox-count"] as const,
+};
+
+// Don't hammer a server that isn't running (the offline card has a retry
+// button), and don't ask again for something that isn't there.
+const retry = (count: number, error: unknown) =>
+  !(error instanceof FactoryOfflineError) && !isNotFound(error) && count < 2;
+
+export const useFactoryHealth = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.health,
+    queryFn: FactoryApi.health,
+    retry,
+    staleTime: 60_000,
+    meta: { disableToast: true },
+  });
+
+export const useSpecsOverview = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.specs,
+    queryFn: FactoryApi.specs,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useChangeDetail = (id: string | undefined) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.change(id ?? ""),
+    queryFn: () => FactoryApi.change(id ?? ""),
+    enabled: Boolean(id),
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrderPlan = (id: string, enabled: boolean) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.plan(id),
+    queryFn: () => FactoryApi.workOrderPlan(id),
+    enabled,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrders = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.workOrders,
+    queryFn: FactoryApi.workOrders,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useAuditLog = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.audit,
+    queryFn: FactoryApi.audit,
+    retry,
+    meta: { disableToast: true },
+  });
+
+function invalidateFactory(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({ queryKey: FACTORY_QUERY_KEYS.all });
+}
+
+export function useValidateSpecs() {
+  return useMutation({
+    mutationFn: FactoryApi.validate,
+    meta: { disableToast: true },
+  });
+}
+
+export function useCreateWorkOrders() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (change: string) => FactoryApi.createWorkOrders(change),
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useSetWorkOrderStatus() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: {
+      id: string;
+      status: string;
+      approve?: boolean;
+      note?: string;
+    }) => {
+      const { id, ...body } = variables;
+      return FactoryApi.setStatus(id, body);
+    },
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+// ---- Autopilot ----
+
+export const useAutopilotStatus = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.autopilotStatus,
+    queryFn: FactoryApi.autopilotStatus,
+    retry,
+    // Nothing pushes agent-server reachability, so look again now and then.
+    refetchInterval: 30_000,
+    meta: { disableToast: true },
+  });
+
+export const useRuns = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.runs,
+    queryFn: FactoryApi.runs,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useRun = (id: string | undefined) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.run(id ?? ""),
+    queryFn: () => FactoryApi.run(id ?? ""),
+    enabled: Boolean(id),
+    retry,
+    // The ETA and agent costs move between events; a slow poll keeps them honest.
+    refetchInterval: (query) =>
+      isNotFound(query.state.error) ? false : 15_000,
+    meta: { disableToast: true },
+  });
+
+export const useInbox = (state: "open" | "decided" | "all") =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.inbox(state),
+    queryFn: () => FactoryApi.inbox(state),
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useInboxCount = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.inboxCount,
+    queryFn: FactoryApi.inboxCount,
+    retry: false,
+    refetchInterval: 30_000,
+    meta: { disableToast: true },
+  });
+
+function invalidateAutopilot(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({
+    queryKey: FACTORY_QUERY_KEYS.autopilot,
+  });
+}
+
+export function useCreateRun() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (body: {
+      goal: string;
+      autonomy?: Autonomy;
+      budgetUsd?: number | null;
+    }) => FactoryApi.createRun(body),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useRunAction() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (v: {
+      id: string;
+      action: "pause" | "resume" | "cancel";
+      note?: string;
+    }) => FactoryApi.runAction(v.id, v.action, v.note),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useRelease() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (id: string) => FactoryApi.release(id),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useDecide() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (v: { id: number; choice: string; note?: string }) =>
+      FactoryApi.decide(v.id, { choice: v.choice, note: v.note }),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+// ---- live updates ----
+
+type Refetch = (type: string) => void;
+const subscribers = new Set<Refetch>();
+let source: EventSource | null = null;
+let reconnect: ReturnType<typeof setTimeout> | undefined;
+const EVENTS = [
+  "hello",
+  "workorders.changed",
+  "specs.changed",
+  "audit.appended",
+  "autopilot.changed",
+];
+
+/** One EventSource for the whole tab, however many components listen. */
+function connect() {
+  if (source || typeof EventSource === "undefined") return;
+  const es = new EventSource(`${FACTORY_API_BASE}/events`);
+  source = es;
+  for (const type of EVENTS) {
+    es.addEventListener(type, () => subscribers.forEach((fn) => fn(type)));
+  }
+  // A 502 from the dev proxy (API not running) closes the stream for good;
+  // try again later so the pages come back on their own when it starts.
+  es.addEventListener("error", () => {
+    if (es.readyState !== EventSource.CLOSED) return;
+    source = null;
+    clearTimeout(reconnect);
+    reconnect = setTimeout(() => subscribers.size && connect(), 10_000);
+  });
+}
+
+function disconnect() {
+  clearTimeout(reconnect);
+  source?.close();
+  source = null;
+}
+
+/**
+ * Keep factory data fresh while a factory page (or the sidebar) is open. The
+ * API sends an event whenever an agent (or anyone) edits a work order or spec
+ * file, Autopilot moves, or the audit log grows, and we refetch what changed.
+ */
+export function useFactoryLiveUpdates() {
+  const queryClient = useQueryClient();
+  React.useEffect(() => {
+    // After a reconnect (say the API restarted), pick up anything that changed
+    // while it was down. The first hello is just the initial connection.
+    let connectedBefore = false;
+    const onEvent: Refetch = (type) => {
+      const refetch = (key: readonly string[]) =>
+        queryClient.invalidateQueries({ queryKey: key });
+      if (type === "workorders.changed") refetch(FACTORY_QUERY_KEYS.workOrders);
+      else if (type === "specs.changed") refetch(FACTORY_QUERY_KEYS.specs);
+      else if (type === "autopilot.changed")
+        refetch(FACTORY_QUERY_KEYS.autopilot);
+      else if (type === "audit.appended") {
+        refetch(FACTORY_QUERY_KEYS.audit);
+        refetch(FACTORY_QUERY_KEYS.workOrders);
+      } else if (type === "hello") {
+        if (connectedBefore) invalidateFactory(queryClient);
+        connectedBefore = true;
+      }
+    };
+    subscribers.add(onEvent);
+    connect();
+    return () => {
+      subscribers.delete(onEvent);
+      if (!subscribers.size) disconnect();
+    };
+  }, [queryClient]);
+}
