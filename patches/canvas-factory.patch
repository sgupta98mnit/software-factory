+  const waves = [...new Set(run.workOrders.map((w) => w.wave))].sort(
+    (a, b) => a - b,
+  );
+
+  return (
+    <>
+      <dl className="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
