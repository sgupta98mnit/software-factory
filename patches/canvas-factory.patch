+import React from "react";
+import { TriangleAlert } from "lucide-react";
+import { ModalBackdrop } from "#/components/shared/modals/modal-backdrop";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { displaySuccessToast } from "#/utils/custom-toast-handlers";
+import { cn } from "#/utils/utils";
+import type { WorkOrder } from "../api";
+import { useFactoryCopy } from "../copy";
+import { useSetWorkOrderStatus } from "../hooks";
+import { factoryFieldClassName } from "./start-agent-modal";
+import { FactoryError } from "./factory-page";
+
+interface ApproveModalProps {
+  workOrder: WorkOrder;
+  finalStatus: string;
+  /** Work orders this one depends on that aren't approved yet. */
+  openDependencies?: string[];
+  onClose: () => void;
+}
+
+/** A person's approval: moves the work order to the final status and records who and why. */
+export function ApproveModal({
+  workOrder,
+  finalStatus,
+  openDependencies = [],
+  onClose,
+}: ApproveModalProps) {
+  const copy = useFactoryCopy();
+  const setStatus = useSetWorkOrderStatus();
+  const [note, setNote] = React.useState("");
+  const unmet = workOrder.acceptanceCriteria.filter((ac) => !ac.done).length;
+  const busy = setStatus.isPending;
+
+  const approve = () =>
+    setStatus.mutate(
+      {
+        id: workOrder.id,
+        status: finalStatus,
+        approve: true,
+        note: note.trim() || undefined,
+      },
+      {
+        onSuccess: () => {
+          displaySuccessToast(copy.approve.approved(workOrder.id));
+          onClose();
+        },
+      },
+    );
+
+  return (
+    <ModalBackdrop
+      onClose={busy ? undefined : onClose}
+      closeOnEscape={!busy}
+      aria-label={copy.approve.title(workOrder.id)}
+    >
+      <div
+        data-testid="factory-approve-modal"
+        className="flex w-full max-w-lg flex-col gap-4 rounded-xl border border-border bg-base-secondary p-5"
+      >
+        <h2 className="text-base font-semibold text-foreground">
+          {copy.approve.title(workOrder.id)}
+        </h2>
+        <p className="text-sm text-muted">{copy.approve.body(finalStatus)}</p>
+        {unmet > 0 ? <Warning text={copy.approve.unmet(unmet)} /> : null}
+        {openDependencies.length ? (
+          <Warning
+            text={copy.approve.openDependencies(
+              openDependencies.join(", "),
+              finalStatus,
+            )}
+          />
+        ) : null}
+        <div className="flex flex-col gap-1.5">
+          <label
+            htmlFor="factory-approve-note"
+            className="text-sm font-medium text-foreground"
+          >
+            {copy.approve.noteLabel}
+          </label>
+          <textarea
+            id="factory-approve-note"
+            className={cn(factoryFieldClassName, "min-h-20")}
+            placeholder={copy.approve.notePlaceholder}
+            value={note}
+            onChange={(e) => setNote(e.target.value)}
+            disabled={busy}
+          />
+        </div>
+        <FactoryError error={setStatus.error} />
+        <div className="flex justify-end gap-2">
+          <BrandButton
+            type="button"
+            variant="secondary"
+            onClick={onClose}
+            isDisabled={busy}
+          >
+            {copy.common.cancel}
+          </BrandButton>
+          <BrandButton
+            testId="factory-approve-confirm"
+            type="button"
+            variant="primary"
+            onClick={approve}
+            isDisabled={busy}
+            aria-busy={busy}
+          >
+            {busy ? copy.approve.approving : copy.approve.confirm}
+          </BrandButton>
+        </div>
+      </div>
+    </ModalBackdrop>
+  );
+}
+
+function Warning({ text }: { text: string }) {
+  return (
+    <p className="flex items-start gap-2 rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm text-foreground">
+      <TriangleAlert
+        className="mt-0.5 size-4 shrink-0 text-warning"
+        aria-hidden
+      />
+      {text}
+    </p>
+  );
+}
