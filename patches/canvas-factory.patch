+            {copy.pipeline.waves}
+          </h2>
+          <p className="text-xs text-muted">
+            {run.workOrders.length
+              ? copy.pipeline.waveHelp
+              : copy.pipeline.noWorkOrders}
+          </p>
+        </div>
+        {waves.map((wave) => (
+          <div key={wave} className="flex flex-col gap-2">
