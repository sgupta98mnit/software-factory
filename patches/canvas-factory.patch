+describe("Autopilot inbox", () => {
+  it("names the open count in the sidebar Inbox link", async () => {
+    serveInbox();
+    renderWithProviders(<FactoryNavLinks collapsed={false} />);
+    expect(
+      await screen.findByRole("link", { name: "Inbox, 2 need you" }),
+    ).toHaveAttribute("href", "/inbox");
+  });
+
+  it("asks for a note before Revise, and for confirmation before Cancel", async () => {
+    const user = userEvent.setup();
+    const decisions = serveInbox();
+    renderWithProviders(
+      <MemoryRouter initialEntries={["/inbox"]}>
+        <AutopilotInboxRoute />
+      </MemoryRouter>,
+    );
+    const card = await screen.findByTestId("inbox-item-7");
+
+    await user.click(within(card).getByRole("button", { name: "Revise" }));
+    expect(within(card).getByRole("alert")).toHaveTextContent(
+      "Add a note to choose “Revise”.",
+    );
+    expect(within(card).getByLabelText("Note")).toHaveFocus();
+
+    await user.click(within(card).getByRole("button", { name: "Cancel run" }));
+    expect(
+      screen.getByRole("dialog", { name: "Cancel run?" }),
+    ).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Go back" }));
+    expect(decisions).toEqual([]);
+
+    await user.type(within(card).getByLabelText("Note"), "Split WO-2");
+    await user.click(within(card).getByRole("button", { name: "Revise" }));
+    await waitFor(() =>
+      expect(decisions).toEqual([{ choice: "revise", note: "Split WO-2" }]),
+    );
+  });
