@@ -0,0 +1,53 @@
+import { useMutation } from "@tanstack/react-query";
+import { Download } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { FactoryApi } from "../api";
+import { useFactoryCopy } from "../copy";
+
+export function EvidenceDownload({ runId }: { runId: string }) {
+  const copy = useFactoryCopy();
+  const download = useMutation({
+    mutationFn: async () => {
+      const evidence = await FactoryApi.runEvidence(runId);
+      const blob = new Blob([`${JSON.stringify(evidence, null, 2)}\n`], {
+        type: "application/json",
+      });
+      const url = URL.createObjectURL(blob);
+      const anchor = document.createElement("a");
+      try {
+        anchor.href = url;
+        anchor.download = `${runId}-evidence.json`;
+        document.body.appendChild(anchor);
+        anchor.click();
+      } finally {
+        anchor.remove();
+        // Let the browser start consuming the download before releasing it.
+        window.setTimeout(() => URL.revokeObjectURL(url), 0);
+      }
+    },
+    retry: false,
+    meta: { disableToast: true },
+  });
+
+  return (
+    <div className="flex max-w-sm flex-col items-end gap-2">
+      <BrandButton
+        type="button"
+        variant="secondary"
+        onClick={() => download.mutate()}
+        isDisabled={download.isPending}
+        aria-busy={download.isPending}
+        startContent={<Download className="size-4" aria-hidden />}
+      >
+        {download.isPending
+          ? copy.pipeline.evidencePreparing
+          : copy.pipeline.evidenceDownload}
+      </BrandButton>
+      {download.error ? (
+        <p role="alert" className="text-sm text-feedback-error">
+          {copy.pipeline.evidenceError(download.error.message)}
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/factory/components/factory-badges.tsx b/src/factory/components/factory-badges.tsx
new file mode 100644
index 0000000..2c291de
--- /dev/null
+++ b/src/factory/components/factory-badges.tsx
@@ -0,0 +1,201 @@
+import {
+  Circle,
+  CircleCheck,
+  CircleDot,
+  CirclePause,
+  CircleX,
+  Shield,
+  TriangleAlert,
+} from "lucide-react";
+import { cn } from "#/utils/utils";
+import type { AttemptState, InboxKind, RunState, WorkOrderState } from "../api";
+
+/** Status with a colored dot: first status muted, last status green, anything between in the accent color. */
+export function StatusPill({
+  status,
+  statuses,
+}: {
+  status: string;
+  statuses: string[];
+}) {
+  const index = statuses.indexOf(status);
+  const isFinal = index === statuses.length - 1;
+  const isFirst = index <= 0;
+  return (
+    <span className="inline-flex items-center gap-1.5 text-xs text-muted">
+      <span
+        aria-hidden
+        className={cn(
+          "size-2 rounded-full",
+          isFinal && "bg-success",
+          isFirst && !isFinal && "bg-muted",
+          !isFirst && !isFinal && "bg-primary",
+        )}
+      />
+      <span className="text-foreground">{status}</span>
+    </span>
+  );
+}
+
+/**
+ * Backlog.md labels. `control:SI-10` shows as a control chip, `change:x` as
+ * the change name; anything else as-is.
+ */
+export function LabelChip({ label }: { label: string }) {
+  if (label.startsWith("control:")) {
+    return (
+      <span className="inline-flex items-center gap-1 rounded-md border border-border-subtle px-1.5 py-0.5 font-mono text-xs text-foreground">
+        <Shield className="size-3 text-muted" aria-hidden />
+        {label.slice("control:".length)}
+      </span>
+    );
+  }
+  const text = label.startsWith("change:")
+    ? label.slice("change:".length)
+    : label;
+  return (
+    <span className="inline-flex max-w-full items-center truncate rounded-md bg-surface-raised px-1.5 py-0.5 font-mono text-xs text-muted">
+      {text}
+    </span>
+  );
+}
+
+/** "user:sumit" -> "sumit", "filesystem" -> "filesystem" */
+export function actorName(actor: string) {
+  return actor.replace(/^user:/, "");
+}
+
+export function formatWhen(iso: string, language: string) {
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return iso;
+  return new Intl.DateTimeFormat(language, {
+    dateStyle: "medium",
+    timeStyle: "short",
+  }).format(date);
+}
+
+/** How a state reads at a glance. The chip always shows the state's name too, so colour is never the only cue. */
+export type Tone =
+  | "idle"
+  | "active"
+  | "attention"
+  | "done"
+  | "stopped"
+  | "failed";
+
+const TONE_ICON = {
+  idle: Circle,
+  active: CircleDot,
+  attention: TriangleAlert,
+  done: CircleCheck,
+  stopped: CirclePause,
+  failed: CircleX,
+} as const;
+
+const TONE_CLASS: Record<Tone, string> = {
+  idle: "text-muted",
+  active: "text-primary",
+  attention: "text-warning",
+  done: "text-success",
+  stopped: "text-muted",
+  failed: "text-feedback-error",
+};
+
+export const RUN_TONE: Record<RunState, Tone> = {
+  spec: "active",
+  critic: "active",
+  awaiting_spec_approval: "attention",
+  awaiting_answers: "attention",
+  awaiting_plan_approval: "attention",
+  building: "active",
+  done: "done",
+  paused: "stopped",
+  failed: "failed",
+  cancelled: "stopped",
+};
+
+export const WORK_ORDER_TONE: Record<WorkOrderState, Tone> = {
+  pending: "idle",
+  building: "active",
+  verifying: "active",
+  reviewing: "active",
+  ready: "active",
+  awaiting_merge_approval: "attention",
+  merging: "active",
+  merged: "done",
+  needs_attention: "attention",
+  skipped: "stopped",
+  cancelled: "stopped",
+};
+
+export const ATTEMPT_TONE: Record<AttemptState, Tone> = {
+  starting: "active",
+  running: "active",
+  finished: "done",
+  error: "failed",
+  stuck: "failed",
+  paused: "stopped",
+  cancelled: "stopped",
+};
+
+export const INBOX_TONE: Record<InboxKind, Tone> = {
+  spec_approval: "attention",
+  plan_approval: "attention",
+  questions: "attention",
+  spec_failed: "failed",
+  merge_approval: "attention",
+  work_order_failed: "failed",
+  budget_reached: "attention",
+  run_paused: "stopped",
+  error: "failed",
+  release: "done",
+};
+
+export function StateChip({
+  tone = "idle",
+  label,
+}: {
+  tone?: Tone;
+  label: string;
+}) {
+  const Icon = TONE_ICON[tone];
+  return (
+    <span className="inline-flex max-w-full items-center gap-1 rounded-full border border-border-subtle bg-base-secondary px-2 py-0.5 text-xs text-foreground">
+      <Icon className={cn("size-3.5 shrink-0", TONE_CLASS[tone])} aria-hidden />
+      <span className="truncate">{label}</span>
+    </span>
+  );
+}
+
+/** The label for a value the server sent, or the raw value if this UI doesn't know it yet. */
+export const labelFor = (labels: Record<string, string>, value: string) =>
+  labels[value] ?? value;
+
+export function formatUsd(amount: number, language: string) {
+  return new Intl.NumberFormat(language, {
+    style: "currency",
+    currency: "USD",
+  }).format(amount);
+}
+
+/** "in 25 minutes", "en 2 horas" */
+export function formatEta(ms: number, language: string) {
+  const minutes = Math.max(1, Math.round(ms / 60_000));
+  const format = new Intl.RelativeTimeFormat(language, { numeric: "auto" });
+  return minutes < 90
+    ? format.format(minutes, "minute")
+    : format.format(Math.round(minutes / 60), "hour");
+}
+
+/** "4.2 sec", "3 min" */
+export function formatDuration(ms: number, language: string) {
+  const seconds = ms / 1000;
+  const [value, unit] =
+    seconds < 90 ? [seconds, "second"] : [seconds / 60, "minute"];
+  return new Intl.NumberFormat(language, {
+    style: "unit",
+    unit,
+    unitDisplay: "short",
+    maximumFractionDigits: 1,
+  }).format(value);
+}
