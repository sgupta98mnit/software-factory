+
+type TimelineEntry =
+  | { at: string; attempt: AttemptView }
+  | { at: string; check: CheckView };
+
+/** Agent conversations and gate checks, oldest first. */
+function Timeline({
+  attempts,
+  checks,
+}: {
+  attempts: AttemptView[];
+  checks: CheckView[];
+}) {
+  const entries: TimelineEntry[] = [
+    ...attempts.map((attempt) => ({ at: attempt.startedAt, attempt })),
+    ...checks.map((check) => ({ at: check.at, check })),
+  ].sort((a, b) => a.at.localeCompare(b.at));
+  return (
+    <ol className="flex flex-col gap-2.5">
+      {entries.map((entry) =>
+        "attempt" in entry ? (
+          <AttemptEntry key={`a${entry.attempt.id}`} attempt={entry.attempt} />
+        ) : (
+          <CheckEntry key={`c${entry.check.id}`} check={entry.check} />
+        ),
+      )}
+    </ol>
+  );
+}
+
+function AttemptEntry({ attempt }: { attempt: AttemptView }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const verdict = readVerdict(attempt.result);
+  // The ledger keeps the profile id; show its name when the agent server lists it.
+  const profile = useAutopilotStatus().data?.agentServer.profiles.find(
+    (p) => p.id === attempt.agentProfile,
+  );
+  const isolated = attempt.execution?.provider === "container";
+  return (
+    <li className="flex min-w-0 flex-col gap-1 text-xs">
+      <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+        <span className="text-sm font-medium text-foreground">
+          {labelFor(copy.autopilot.role, attempt.role)}
+        </span>
+        <StateChip
+          tone={ATTEMPT_TONE[attempt.state]}
+          label={labelFor(copy.autopilot.attemptState, attempt.state)}
+        />
+        {isolated ? (
+          <span className="inline-flex items-center gap-1 rounded-md bg-surface-raised px-1.5 py-0.5 text-xs text-muted">
+            <ShieldCheck className="size-3 text-success" aria-hidden />
+            {copy.pipeline.isolatedAttempt}
+          </span>
+        ) : null}
+      </div>
+      <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-muted">
+        {profile ? <span>{profile.name}</span> : null}
+        <span>{copy.pipeline.turns(attempt.turns)}</span>
+        <span className="tabular-nums">
+          {formatUsd(attempt.costUsd, i18n.language)}
+        </span>
+        <time dateTime={attempt.startedAt}>
+          {formatWhen(attempt.startedAt, i18n.language)}
+        </time>
+        {isolated ? null : (
+          <Link
+            to={`/conversations/${attempt.conversationId}`}
+            className="inline-flex items-center gap-1 rounded-md text-link hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-focus"
+          >
+            <MessageSquare className="size-3.5" aria-hidden />
+            {copy.pipeline.openConversation}
+          </Link>
+        )}
+      </div>
+      {isolated ? (
+        <p className="text-muted">{copy.pipeline.isolatedTranscript}</p>
+      ) : null}
+      {verdict ? (
+        <div className="mt-1 rounded-lg border border-border-subtle bg-base-secondary px-2.5 py-2">
+          <p className="font-medium text-foreground">
+            {copy.pipeline.verdict(
+              labelFor(copy.pipeline.verdicts, verdict.verdict),
+            )}
+          </p>
+          {verdict.findings.length ? (
+            <FindingList findings={verdict.findings} />
+          ) : null}
+        </div>
+      ) : null}
+    </li>
+  );
+}
+
+function CheckEntry({ check }: { check: CheckView }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const Icon = check.ok ? CircleCheck : CircleX;
+  return (
+    <li className="flex min-w-0 flex-col gap-1 text-xs">
+      <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+        <Icon
+          className={cn(
+            "size-4 shrink-0",
+            check.ok ? "text-success" : "text-feedback-error",
+          )}
+          aria-hidden
+        />
+        <span className="break-all font-mono text-sm text-foreground">
+          {check.name}
+        </span>
+        <span
+          className={cn(
+            "font-medium",
+            check.ok ? "text-foreground" : "text-feedback-error",
+          )}
+        >
+          {check.ok ? copy.pipeline.checkPassed : copy.pipeline.checkFailed}
+        </span>
+      </div>
+      <div className="flex flex-wrap items-center gap-x-3 gap-y-1 pl-6 text-muted">
+        <span>{labelFor(copy.autopilot.checkStage, check.stage)}</span>
+        {check.durationMs !== null ? (
+          <span className="tabular-nums">
+            {formatDuration(check.durationMs, i18n.language)}
+          </span>
+        ) : null}
+        {check.exitCode !== null && !check.ok ? (
+          <span className="tabular-nums">
+            {copy.pipeline.exitCode(check.exitCode)}
+          </span>
+        ) : null}
+        {check.sha ? (
+          <span className="font-mono">
+            {copy.pipeline.checkedCommit(check.sha.slice(0, 12))}
+          </span>
+        ) : null}
+        {typeof check.meta?.version === "string" ? (
+          <span>
+            {copy.pipeline.scannerUsed(
+              check.meta.version,
+              String(check.meta.dbUpdatedAt ?? "").slice(0, 10),
+            )}
+          </span>
+        ) : null}
+        <time dateTime={check.at}>{formatWhen(check.at, i18n.language)}</time>
+      </div>
+      {check.output ? (
+        <details className="pl-6">
+          <summary className="cursor-pointer rounded-md text-muted hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-focus">
+            {copy.pipeline.output}
+          </summary>
+          <pre className="mt-1 max-h-72 overflow-auto whitespace-pre rounded-lg border border-border-subtle bg-base-secondary p-2 font-mono text-xs text-foreground custom-scrollbar">
+            {check.output}
+          </pre>
+        </details>
+      ) : null}
+    </li>
+  );
+}
+
+function FindingList({ findings }: { findings: Finding[] }) {
+  const copy = useFactoryCopy();
+  return (
+    <ul className="mt-1 flex flex-col gap-1.5 text-xs">
+      {findings.map((finding, i) => (
+        <li key={i} className="min-w-0">
+          <SeverityTag severity={finding.severity} />{" "}
+          {finding.scenario ? (
+            <span className="text-muted">
+              {`${copy.pipeline.scenario(finding.scenario)}: `}
+            </span>
+          ) : null}
+          {!finding.scenario && finding.criterion ? (
+            <span className="text-muted">
+              {`${copy.pipeline.criterion(finding.criterion)}: `}
+            </span>
+          ) : null}
+          <span className="font-medium text-foreground">{finding.title}</span>
+          {finding.file ? (
+            <span className="block break-all font-mono text-muted">
+              {finding.file}
+            </span>
+          ) : null}
+          {finding.detail ? (
+            <span className="block whitespace-pre-wrap break-words text-muted">
+              {finding.detail}
+            </span>
+          ) : null}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function SeverityTag({ severity }: { severity: string }) {
+  const copy = useFactoryCopy();
+  const serious = severity === "critical" || severity === "high";
+  return (
+    <span
+      className={cn(
+        "inline-flex rounded-md border px-1.5 text-xs",
+        serious
+          ? "border-feedback-error text-feedback-error"
+          : "border-border-subtle text-muted",
+      )}
+    >
+      {labelFor(copy.autopilot.severity, severity)}
+    </span>
+  );
+}
+
+/**
+ * The critic's or reviewer's verdict, if the attempt's result carries one.
+ * The server stores both as { verdict, findings: Finding[] }; other roles'
+ * results (outcome, sha, error) have no verdict.
+ */
+function readVerdict(
+  result: unknown,
+): { verdict: string; findings: Finding[] } | null {
+  const r = result as { verdict?: unknown; findings?: unknown } | null;
+  if (!r || typeof r.verdict !== "string") return null;
+  return {
+    verdict: r.verdict,
+    findings: Array.isArray(r.findings) ? (r.findings as Finding[]) : [],
+  };
+}
diff --git a/src/factory/routes/inbox.tsx b/src/factory/routes/inbox.tsx
