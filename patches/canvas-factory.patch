+              {copy.autopilot.projected(money(run.projectedCostUsd))}
+            </dd>
+          </div>
+        ) : null}
+        {run.state === "building" && run.etaMs ? (
+          <div>
+            <dt className="sr-only">{copy.pipeline.labels.eta}</dt>
+            <dd className="text-muted">
+              {copy.autopilot.eta(formatDuration(run.etaMs))}
+            </dd>
+          </div>
+        ) : null}
+        <div className="text-xs text-muted">
+          <dt className="sr-only">{copy.pipeline.labels.started}</dt>
+          <dd>
+            {`${formatWhen(run.createdAt, i18n.language)} · ${copy.autopilot.by(approverName(run.createdBy))}${run.policyHash ? ` · policy@${run.policyHash}` : ""}`}
+          </dd>
+        </div>
+      </dl>
+
+      <RunBanner run={run} />
+      <StageLanes run={run} />
+
+      {open.length ? (
+        <section
+          aria-labelledby="factory-needs-you"
+          className="flex flex-col gap-3"
+        >
+          <h2
+            id="factory-needs-you"
+            className="text-sm font-semibold text-foreground"
+          >
+            {copy.pipeline.needsYou}
+          </h2>
+          {open.map((item) => (
+            <DecisionCard key={item.id} item={item} showRun={false} />
