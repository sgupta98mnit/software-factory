+import { useSearchParams } from "react-router";
+import { cn } from "#/utils/utils";
+import { useFactoryCopy } from "../copy";
+import { useInbox } from "../hooks";
+import { FactoryLoading, FactoryPage } from "../components/factory-page";
+import { DecisionCard } from "../components/decision-card";
+
+type Tab = "open" | "decided";
+const TABS: Tab[] = ["open", "decided"];
+
+export default function FactoryInboxRoute() {
+  const copy = useFactoryCopy();
+  const [searchParams, setSearchParams] = useSearchParams();
+  const tab: Tab = searchParams.get("show") === "decided" ? "decided" : "open";
+  // "all" for the decided tab: it includes items closed by a cancelled run.
+  const inbox = useInbox(tab === "open" ? "open" : "all");
+  // Waiting items oldest first (the API sends newest first); decided ones by when they were decided, latest first.
+  const items =
+    tab === "open"
+      ? (inbox.data ?? []).filter((i) => i.state === "open").reverse()
+      : (inbox.data ?? [])
+          .filter((i) => i.state !== "open")
+          .sort((a, b) =>
+            (b.decidedAt ?? b.createdAt).localeCompare(
+              a.decidedAt ?? a.createdAt,
+            ),
+          );
+
+  return (
+    <FactoryPage
+      testId="factory-inbox"
+      title={copy.inbox.title}
+      subtitle={copy.inbox.subtitle}
+      error={inbox.error}
+      onRetry={() => void inbox.refetch()}
+    >
+      <div className="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-5">
+        <div
+          role="tablist"
+          className="flex gap-1 self-start rounded-lg border border-border-subtle p-0.5"
+        >
+          {TABS.map((t) => (
+            <button
+              key={t}
+              type="button"
+              role="tab"
+              aria-selected={tab === t}
+              data-testid={`factory-inbox-tab-${t}`}
+              onClick={() => setSearchParams(t === "open" ? {} : { show: t })}
+              className={cn(
+                "rounded-md px-3 py-1 text-sm",
+                tab === t
+                  ? "bg-interactive-selected text-foreground"
+                  : "text-muted hover:text-foreground",
+              )}
+            >
+              {t === "open" ? copy.inbox.open : copy.inbox.decided}
+            </button>
+          ))}
+        </div>
+        {inbox.isLoading ? <FactoryLoading /> : null}
+        {inbox.data && items.length === 0 ? (
+          <p className="text-sm text-muted" data-testid="factory-inbox-empty">
+            {tab === "open" ? copy.inbox.empty : copy.inbox.emptyDecided}
+          </p>
+        ) : null}
+        {items.map((item) => (
+          <DecisionCard key={item.id} item={item} />
+        ))}
+      </div>
+    </FactoryPage>
+  );
+}
