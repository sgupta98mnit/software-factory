+import React from "react";
+import { ModalBackdrop } from "#/components/shared/modals/modal-backdrop";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import { factoryFieldClassName } from "./start-agent-modal";
+import { FactoryError } from "./factory-page";
+
+interface ConfirmModalProps {
+  title: string;
+  body: string;
+  confirmLabel: string;
+  busyLabel?: string;
+  cancelLabel: string;
+  /** Shows an optional note field and passes its text to onConfirm. */
+  noteLabel?: string;
+  busy: boolean;
+  error?: unknown;
+  onConfirm: (note: string | undefined) => void;
+  onClose: () => void;
+}
+
+/** "Are you sure?" for choices that can't be undone (cancel a run, skip a work order). */
+export function ConfirmModal({
+  title,
+  body,
+  confirmLabel,
+  busyLabel,
+  cancelLabel,
+  noteLabel,
+  busy,
+  error,
+  onConfirm,
+  onClose,
+}: ConfirmModalProps) {
+  const [note, setNote] = React.useState("");
+  const noteId = React.useId();
+  return (
+    <ModalBackdrop
+      onClose={busy ? undefined : onClose}
+      closeOnEscape={!busy}
+      aria-label={title}
+    >
+      <div
+        data-testid="factory-confirm-modal"
+        className="flex w-full max-w-md flex-col gap-4 rounded-xl border border-border bg-base-secondary p-5"
+      >
+        <h2 className="text-base font-semibold text-foreground">{title}</h2>
+        <p className="text-sm text-muted">{body}</p>
+        {noteLabel ? (
+          <div className="flex flex-col gap-1.5">
+            <label
+              htmlFor={noteId}
+              className="text-sm font-medium text-foreground"
+            >
+              {noteLabel}
+            </label>
+            <textarea
+              id={noteId}
+              className={cn(factoryFieldClassName, "min-h-20")}
+              value={note}
+              onChange={(e) => setNote(e.target.value)}
+              disabled={busy}
+            />
+          </div>
+        ) : null}
+        <FactoryError error={error} />
+        <div className="flex flex-wrap justify-end gap-2">
+          <BrandButton
+            type="button"
+            variant="secondary"
+            onClick={onClose}
+            isDisabled={busy}
+          >
+            {cancelLabel}
+          </BrandButton>
+          <BrandButton
+            testId="factory-confirm"
+            type="button"
+            variant="danger"
+            onClick={() => onConfirm(note.trim() || undefined)}
+            isDisabled={busy}
+            aria-busy={busy}
+          >
+            {busy && busyLabel ? busyLabel : confirmLabel}
+          </BrandButton>
+        </div>
+      </div>
+    </ModalBackdrop>
+  );
+}
