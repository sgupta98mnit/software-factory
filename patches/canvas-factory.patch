+}
+
+function Board({
+  list,
+  workOrders,
+  selectedId,
+  hrefFor,
+}: {
+  list: WorkOrderList;
+  workOrders: WorkOrder[];
+  selectedId?: string;
+  hrefFor: (id?: string) => string;
