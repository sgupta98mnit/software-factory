@@ -0,0 +1,128 @@
+import { useNavigate } from "react-router";
+import { ModalBackdrop } from "#/components/shared/modals/modal-backdrop";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { displaySuccessToast } from "#/utils/custom-toast-handlers";
+import { useFactoryCopy } from "../copy";
+import { useCreateWorkOrders, useWorkOrderPlan } from "../hooks";
+import { FactoryMarkdown } from "./factory-markdown";
+import { FactoryError } from "./factory-page";
+
+interface WorkOrderPlanModalProps {
+  change: string;
+  onClose: () => void;
+}
+
+/**
+ * Shows the work orders the factory would create from a change's tasks.md,
+ * and creates them when you confirm. Your confirmation is the audit record.
+ */
+export function WorkOrderPlanModal({
+  change,
+  onClose,
+}: WorkOrderPlanModalProps) {
+  const copy = useFactoryCopy();
+  const navigate = useNavigate();
+  const plan = useWorkOrderPlan(change, true);
+  const create = useCreateWorkOrders();
+  const busy = create.isPending;
+  const workOrders = plan.data?.workOrders ?? [];
+  const existing = plan.data?.existing ?? [];
+
+  const confirm = () =>
+    create.mutate(change, {
+      onSuccess: (result) => {
+        displaySuccessToast(copy.plan.created(result.created.map((c) => c.id)));
+        onClose();
+        navigate(`/work-orders?change=${encodeURIComponent(change)}`);
+      },
+    });
+
+  return (
+    <ModalBackdrop
+      onClose={busy ? undefined : onClose}
+      closeOnEscape={!busy}
+      aria-label={copy.plan.title(change)}
+    >
+      <div
+        data-testid="factory-plan-modal"
+        className="flex max-h-screen w-full max-w-2xl flex-col gap-4 overflow-y-auto rounded-xl border border-border bg-base-secondary p-5"
+      >
+        <div>
+          <h2 className="text-base font-semibold text-foreground">
+            {copy.plan.title(change)}
+          </h2>
+          <p className="mt-1 text-sm text-muted">{copy.plan.subtitle}</p>
+        </div>
+
+        {plan.isLoading ? (
+          <p className="text-sm text-muted">{copy.common.loading}</p>
+        ) : null}
+        <FactoryError error={plan.error} />
+        {existing.length ? (
+          <p role="status" className="text-sm text-foreground">
+            {copy.plan.existing(existing.map((w) => w.id))}
+          </p>
+        ) : null}
+
+        <ol className="flex flex-col gap-2">
+          {workOrders.map((wo, i) => (
+            <li
+              key={wo.title}
+              className="rounded-lg border border-border-subtle bg-surface px-4 py-3"
+            >
+              <div className="flex flex-wrap items-baseline gap-x-2">
+                <span className="font-mono text-xs text-muted">{`#${i + 1}`}</span>
+                <span className="text-sm font-medium text-foreground">
+                  {wo.title}
+                </span>
+                {wo.dependsOn !== null ? (
+                  <span className="text-xs text-muted">
+                    {copy.plan.after(wo.dependsOn + 1)}
+                  </span>
+                ) : null}
+              </div>
+              <p className="mt-1 text-xs text-muted">
+                {copy.plan.criteria(wo.acceptanceCriteria.length)}
+              </p>
+              <FactoryMarkdown
+                className="mt-1"
+                text={wo.acceptanceCriteria.map((ac) => `- ${ac}`).join("\n")}
+              />
+              {wo.controls.length ? (
+                <p className="mt-2 text-xs text-muted">
+                  {`${copy.plan.controls}: `}
+                  <span className="font-mono text-foreground">
+                    {wo.controls.join(", ")}
+                  </span>
+                </p>
+              ) : null}
+            </li>
+          ))}
+        </ol>
+
+        <FactoryError error={create.error} />
+
+        <div className="flex justify-end gap-2">
+          <BrandButton
+            type="button"
+            variant="secondary"
+            onClick={onClose}
+            isDisabled={busy}
+          >
+            {copy.common.cancel}
+          </BrandButton>
+          <BrandButton
+            testId="factory-plan-confirm"
+            type="button"
+            variant="primary"
+            onClick={confirm}
+            isDisabled={busy || !workOrders.length || existing.length > 0}
+            aria-busy={busy}
+          >
+            {busy ? copy.plan.creating : copy.plan.create(workOrders.length)}
+          </BrandButton>
+        </div>
+      </div>
+    </ModalBackdrop>
+  );
+}
