+}
+
+function ValidationMessage({
+  id,
+  result,
+  error,
+}: {
+  id: string;
+  result?: ValidationResult;
+  error: Error | null;
+}) {
+  const copy = useFactoryCopy();
+  if (error) {
+    return (
+      <p role="alert" className="mt-3 text-sm text-feedback-error">
+        {error.message}
+      </p>
+    );
+  }
+  if (!result) return null;
+  const mine = result.items.find((item) => item.id === id);
+  if (!mine || mine.valid) {
+    return (
+      <p
+        role="status"
+        className="mt-3 inline-flex items-center gap-1.5 text-sm text-foreground"
+      >
+        <CircleCheck className="size-4 text-success" aria-hidden />
+        {copy.requirements.valid}
+      </p>
+    );
+  }
+  return (
+    <div role="alert" className="mt-3 text-sm text-foreground">
+      <p>{copy.requirements.invalid(mine.issues.length)}</p>
+      <ul className="mt-1 list-disc pl-5 text-muted">
+        {mine.issues.map((issue, i) => (
+          <li key={i}>
+            <span className="font-mono">{issue.path}</span>
+            {": "}
+            {issue.message}
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
+
+function RequirementBlock({
+  requirement,
+  operation,
+  spec,
+}: {
+  requirement: Requirement;
+  operation: string;
+  spec: string;
+}) {
+  const copy = useFactoryCopy();
+  return (
+    <article className="border-b border-border-subtle py-4 last:border-b-0">
+      <header className="flex flex-wrap items-baseline gap-x-2">
+        <h3 className="text-sm font-semibold text-foreground">
+          {requirement.name ?? requirement.text}
+        </h3>
+        <span className="text-xs text-success">
+          {copy.requirements.operation[operation] ?? operation.toLowerCase()}
+        </span>
+        <span className="font-mono text-xs text-muted">{spec}</span>
+      </header>
+      {requirement.name ? (
+        <FactoryMarkdown text={requirement.text} className="mt-1" />
+      ) : null}
+      <div className="mt-2 flex flex-col gap-2">
+        {requirement.scenarios.map((scenario, i) => (
+          <div
+            key={scenario.name ?? i}
+            className="border-l-2 border-border-subtle pl-3"
+          >
+            {scenario.name ? (
+              <div className="text-xs font-medium text-muted">
+                {scenario.name}
+              </div>
+            ) : null}
+            <FactoryMarkdown text={scenario.rawText} />
+          </div>
+        ))}
+      </div>
+    </article>
+  );
+}
