+import {
+  FileText,
+  Inbox,
+  ShieldCheck,
+  SquareKanban,
+  Workflow,
+} from "lucide-react";
+import { SidebarNavLink } from "#/components/features/sidebar/sidebar-nav-link";
+import { useFactoryCopy } from "./copy";
+import { useAutopilotInboxCount } from "./hooks";
+
+const ICON_SIZE = 18;
+const BADGE_MAX = 99;
+
+/** The Software Factory's entries in the Canvas sidebar. */
+export function FactoryNavLinks({ collapsed }: { collapsed: boolean }) {
+  const copy = useFactoryCopy();
+  // No badge while the factory API is down: the query just errors quietly.
+  const open = useAutopilotInboxCount().data?.open ?? 0;
+  const badge = open > BADGE_MAX ? `${BADGE_MAX}+` : String(open);
+  return (
+    <>
+      <SidebarNavLink
+        to="/autopilot"
+        label={copy.nav.autopilot}
+        testId="sidebar-factory-autopilot-link"
+        collapsed={collapsed}
+        icon={<Workflow width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <SidebarNavLink
+        to="/inbox"
+        label={copy.nav.inbox}
+        ariaLabel={open > 0 ? copy.nav.inboxNeedsYou(open) : undefined}
+        testId="sidebar-factory-inbox-link"
+        collapsed={collapsed}
+        icon={
+          <span className="relative inline-flex">
+            <Inbox width={ICON_SIZE} height={ICON_SIZE} />
+            {open > 0 ? (
+              <span
+                aria-hidden
+                data-testid="sidebar-factory-inbox-badge"
+                className="absolute -right-1.5 -top-1.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-primary px-1 text-xs font-semibold leading-none tabular-nums text-on-primary"
+              >
+                {badge}
+              </span>
+            ) : null}
+          </span>
+        }
+      />
+      <SidebarNavLink
+        to="/requirements"
+        label={copy.nav.requirements}
+        testId="sidebar-factory-requirements-link"
+        collapsed={collapsed}
+        icon={<FileText width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <SidebarNavLink
+        to="/work-orders"
+        label={copy.nav.workOrders}
+        testId="sidebar-factory-work-orders-link"
+        collapsed={collapsed}
+        icon={<SquareKanban width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+      <SidebarNavLink
+        to="/audit-log"
+        label={copy.nav.audit}
+        testId="sidebar-factory-audit-link"
+        collapsed={collapsed}
+        icon={<ShieldCheck width={ICON_SIZE} height={ICON_SIZE} />}
+      />
+    </>
+  );
+}
diff --git a/src/factory/hooks.ts b/src/factory/hooks.ts
new file mode 100644
index 0000000..332b6c0
--- /dev/null
+++ b/src/factory/hooks.ts
@@ -0,0 +1,272 @@
+import React from "react";
+import {
+  useMutation,
+  useQuery,
+  useQueryClient,
+  type QueryClient,
+} from "@tanstack/react-query";
+import {
+  FACTORY_API_BASE,
+  FactoryApi,
+  FactoryOfflineError,
+  type Autonomy,
+  type InboxFilter,
+  type RunAction,
+  type RunState,
+} from "./api";
+
+export const FACTORY_QUERY_KEYS = {
+  all: ["factory"] as const,
+  health: ["factory", "health"] as const,
+  specs: ["factory", "specs"] as const,
+  change: (id: string) => ["factory", "specs", "change", id] as const,
+  plan: (id: string) => ["factory", "specs", "plan", id] as const,
+  workOrders: ["factory", "work-orders"] as const,
+  audit: ["factory", "audit"] as const,
+  autopilot: ["factory", "autopilot"] as const,
+  autopilotStatus: ["factory", "autopilot", "status"] as const,
+  runs: ["factory", "autopilot", "runs"] as const,
+  run: (id: string) => ["factory", "autopilot", "runs", id] as const,
+  inbox: (state: InboxFilter) =>
+    ["factory", "autopilot", "inbox", state] as const,
+  inboxCount: ["factory", "autopilot", "inbox-count"] as const,
+};
+
+// Don't hammer a server that isn't running; the offline card has a retry button.
+const retry = (count: number, error: unknown) =>
+  !(error instanceof FactoryOfflineError) && count < 2;
+
+export const useFactoryHealth = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.health,
+    queryFn: FactoryApi.health,
+    retry,
+    staleTime: 60_000,
+    meta: { disableToast: true },
+  });
+
+export const useSpecsOverview = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.specs,
+    queryFn: FactoryApi.specs,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useChangeDetail = (id: string | undefined) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.change(id ?? ""),
+    queryFn: () => FactoryApi.change(id ?? ""),
+    enabled: Boolean(id),
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrderPlan = (id: string, enabled: boolean) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.plan(id),
+    queryFn: () => FactoryApi.workOrderPlan(id),
+    enabled,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useWorkOrders = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.workOrders,
+    queryFn: FactoryApi.workOrders,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useAuditLog = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.audit,
+    queryFn: FactoryApi.audit,
+    retry,
+    meta: { disableToast: true },
+  });
+
+export const useAutopilotStatus = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.autopilotStatus,
+    queryFn: FactoryApi.autopilotStatus,
+    retry,
+    // The agent server may come up after the page opens (pnpm dev).
+    refetchInterval: 30_000,
+    meta: { disableToast: true },
+  });
+
+export const useAutopilotRuns = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.runs,
+    queryFn: FactoryApi.runs,
+    retry,
+    meta: { disableToast: true },
+  });
+
+const FINISHED_RUN_STATES: RunState[] = ["done", "failed", "cancelled"];
+export const isRunFinished = (state: RunState) =>
+  FINISHED_RUN_STATES.includes(state);
+
+export const useAutopilotRun = (id: string | undefined) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.run(id ?? ""),
+    queryFn: () => FactoryApi.run(id ?? ""),
+    enabled: Boolean(id),
+    retry,
+    // State changes arrive over SSE; costs and the ETA move between them.
+    refetchInterval: (query) =>
+      query.state.data && !isRunFinished(query.state.data.state)
+        ? 15_000
+        : false,
+    meta: { disableToast: true },
+  });
+
+export const useAutopilotInbox = (state: InboxFilter) =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.inbox(state),
+    queryFn: () => FactoryApi.inbox(state),
+    retry,
+    meta: { disableToast: true },
+  });
+
+/** Open inbox items, for the sidebar badge. Polls because the sidebar shows on every page. */
+export const useAutopilotInboxCount = () =>
+  useQuery({
+    queryKey: FACTORY_QUERY_KEYS.inboxCount,
+    queryFn: FactoryApi.inboxCount,
+    retry: false,
+    refetchInterval: 15_000,
+    meta: { disableToast: true },
+  });
+
+function invalidateFactory(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({ queryKey: FACTORY_QUERY_KEYS.all });
+}
+
+export function useValidateSpecs() {
+  return useMutation({
+    mutationFn: FactoryApi.validate,
+    meta: { disableToast: true },
+  });
+}
+
+export function useCreateWorkOrders() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (change: string) => FactoryApi.createWorkOrders(change),
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useSetWorkOrderStatus() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: {
+      id: string;
+      status: string;
+      approve?: boolean;
+      note?: string;
+    }) => {
+      const { id, ...body } = variables;
+      return FactoryApi.setStatus(id, body);
+    },
+    onSettled: () => invalidateFactory(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+function invalidateAutopilot(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({
+    queryKey: FACTORY_QUERY_KEYS.autopilot,
+  });
+}
+
+export function useCreateRun() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (body: {
+      goal: string;
+      autonomy?: Autonomy;
+      budgetUsd?: number;
+    }) => FactoryApi.createRun(body),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+/** Runs the execution checks a new run would face (a probe container when isolated). */
+export function useCheckExecution() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: FactoryApi.checkExecution,
+    onSettled: () =>
+      queryClient.invalidateQueries({
+        queryKey: FACTORY_QUERY_KEYS.autopilotStatus,
+      }),
+    meta: { disableToast: true },
+  });
+}
+
+export function useRunAction() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { id: string; action: RunAction; note?: string }) =>
+      FactoryApi.runAction(variables.id, variables.action, variables.note),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+export function useDecideInbox() {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { id: number; choice: string; note?: string }) =>
+      FactoryApi.decide(variables.id, {
+        choice: variables.choice,
+        note: variables.note,
+      }),
+    onSettled: () => invalidateAutopilot(queryClient),
+    meta: { disableToast: true },
+  });
+}
+
+/**
+ * Keep factory data fresh while a factory page is open. The API sends an
+ * event whenever an agent (or anyone) edits a work order or spec file, or the
+ * audit log grows, and we refetch what changed.
+ */
+export function useFactoryLiveUpdates() {
+  const queryClient = useQueryClient();
+  React.useEffect(() => {
+    if (typeof EventSource === "undefined") return undefined;
+    const source = new EventSource(`${FACTORY_API_BASE}/events`);
+    const refetch = (key: readonly string[]) => () =>
+      queryClient.invalidateQueries({ queryKey: key });
+    source.addEventListener(
+      "workorders.changed",
+      refetch(FACTORY_QUERY_KEYS.workOrders),
+    );
+    source.addEventListener("specs.changed", refetch(FACTORY_QUERY_KEYS.specs));
+    source.addEventListener(
+      "autopilot.changed",
+      refetch(FACTORY_QUERY_KEYS.autopilot),
+    );
+    source.addEventListener("audit.appended", () => {
+      queryClient.invalidateQueries({ queryKey: FACTORY_QUERY_KEYS.audit });
+      queryClient.invalidateQueries({
+        queryKey: FACTORY_QUERY_KEYS.workOrders,
+      });
+    });
+    // After a reconnect (say the API restarted), pick up anything that changed
+    // while it was down. The first hello is just the initial connection.
+    let connectedBefore = false;
+    source.addEventListener("hello", () => {
+      if (connectedBefore) invalidateFactory(queryClient);
+      connectedBefore = true;
+    });
+    return () => source.close();
+  }, [queryClient]);
+}
