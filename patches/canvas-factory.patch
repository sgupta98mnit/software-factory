+        <p className="text-xs text-muted">{copy.pipeline.hiddenHelp}</p>
+      </div>
+      <ul className="flex flex-col gap-1">
+        {run.hiddenTests.map((t) => (
+          <li
+            key={t.file}
+            className="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
+          >
+            {t.lastOk === null ? (
+              <CircleDashed
+                className="size-4 shrink-0 text-muted"
+                aria-label={copy.pipeline.hiddenNotRun}
+              />
+            ) : t.lastOk ? (
+              <CircleCheck
+                className="size-4 shrink-0 text-success"
+                aria-label={copy.pipeline.labels.passed}
+              />
+            ) : (
+              <CircleX
+                className="size-4 shrink-0 text-feedback-error"
+                aria-label={copy.pipeline.labels.failed}
+              />
+            )}
+            <span className="text-foreground">{t.scenario}</span>
+            <span className="text-xs text-muted">
+              {copy.pipeline.hiddenNeeds(
+                t.requires.map((r) => `WO-${r}`).join(", "),
+              )}
+            </span>
+            <span className="text-xs text-muted">
+              {t.runs
+                ? copy.pipeline.hiddenRuns(t.runs)
+                : copy.pipeline.hiddenNotRun}
+            </span>
+            <span className="font-mono text-xs text-muted">{t.file}</span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+function AttemptList({ attempts }: { attempts: Attempt[] }) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  // Which agent profile each ran on (the policy routes builders by risk).
+  const profiles = useAutopilotStatus().data?.agentServer.profiles ?? [];
+  const profileName = (id: string | null) =>
+    profiles.find((p) => p.id === id)?.name ?? null;
+  const n = new Map<string, number>();
+  return (
+    <ul className="flex flex-col gap-1">
+      {attempts.map((a) => {
+        const index = (n.get(a.role) ?? 0) + 1;
+        n.set(a.role, index);
+        return (
+          <li
+            key={a.id}
+            className="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
+          >
+            <span className="text-foreground">
+              {`${copy.pipeline.roles[a.role] ?? a.role} ${index}`}
+            </span>
+            {profileName(a.agentProfile) ? (
+              <span className="text-xs text-muted">
+                {profileName(a.agentProfile)}
+              </span>
+            ) : null}
+            <span className="text-xs text-muted">
+              {copy.pipeline.attemptStates[a.state] ?? a.state}
+            </span>
+            <span className="text-xs text-muted">
+              {copy.pipeline.turns(a.turns)}
+            </span>
+            <span className="text-xs tabular-nums text-muted">
+              {formatMoney(a.costUsd, i18n.language)}
+            </span>
+            <Link
+              to={`/conversations/${a.conversationId}`}
+              className="inline-flex items-center gap-1 text-xs text-link hover:underline"
+            >
+              <MessageSquare className="size-3.5" aria-hidden />
+              {copy.pipeline.detail.openConversation}
+            </Link>
+          </li>
+        );
+      })}
+    </ul>
+  );
+}
+
+function CheckList({ checks }: { checks: Check[] }) {
+  const copy = useFactoryCopy();
+  return (
+    <ul className="flex flex-col gap-1">
+      {checks.map((c) => (
+        <li key={c.id} className="text-sm">
+          <details className="group">
+            <summary className="flex cursor-pointer list-none flex-wrap items-center gap-x-2 gap-y-1 [&::-webkit-details-marker]:hidden">
+              <ChevronRight
+                className="size-3.5 shrink-0 text-muted transition-transform group-open:rotate-90"
+                aria-hidden
+              />
+              {c.ok ? (
+                <CircleCheck
+                  className="size-4 shrink-0 text-success"
+                  aria-label={copy.pipeline.labels.passed}
+                />
+              ) : (
+                <CircleX
+                  className="size-4 shrink-0 text-feedback-error"
+                  aria-label={copy.pipeline.labels.failed}
+                />
+              )}
+              <span className="font-mono text-foreground">{c.name}</span>
+              <span className="text-xs text-muted">
+                {copy.pipeline.stagesOfCheck[c.stage] ?? c.stage}
+              </span>
+              {c.durationMs !== null ? (
+                <span className="text-xs tabular-nums text-muted">
+                  {formatDuration(c.durationMs)}
+                </span>
+              ) : null}
+            </summary>
+            {c.output ? (
+              <pre className="mt-1 max-h-72 overflow-auto whitespace-pre-wrap rounded-lg border border-border-subtle bg-surface-deep px-3 py-2 font-mono text-xs text-foreground custom-scrollbar">
+                {c.output}
+              </pre>
+            ) : null}
+          </details>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function WorkOrderPanel({
+  run,
+  wo,
+  onClose,
+}: {
+  run: RunDetail;
+  wo: AutopilotWorkOrder;
+  onClose: () => void;
+}) {
+  const copy = useFactoryCopy();
+  const attempts = run.attempts.filter((a) => a.workOrderId === wo.id);
+  const checks = run.checks.filter((c) => c.workOrderId === wo.id);
+  const items = run.inbox.filter((i) => i.workOrderId === wo.id);
+  const showFindings =
+    wo.findings?.length &&
+    !["merged", "skipped", "cancelled"].includes(wo.state);
+
+  return (
+    <aside
+      data-testid="factory-pipeline-detail"
+      aria-label={`${wo.key} ${wo.title}`}
+      className="flex w-104 shrink-0 flex-col overflow-y-auto border-l border-border-subtle bg-base-secondary custom-scrollbar"
+    >
+      <div className="flex items-center gap-3 border-b border-border-subtle px-5 py-3">
+        <span className="font-mono text-sm text-muted">{wo.key}</span>
+        <WorkOrderStatePill state={wo.state} />
+        <button
+          type="button"
+          onClick={onClose}
+          aria-label={copy.pipeline.detail.close}
+          className="ml-auto inline-flex size-8 items-center justify-center rounded-md text-muted hover:bg-interactive-hover hover:text-contrast"
+        >
+          <X className="size-4" aria-hidden />
+        </button>
+      </div>
+      <div className="flex flex-col gap-5 px-5 py-4">
+        <div className="flex flex-col gap-2">
+          <h2 className="text-base font-semibold text-foreground">
+            {wo.title}
+          </h2>
+          <span className="flex flex-wrap items-center gap-2">
+            <RiskChip risk={wo.risk} />
+            {wo.mergedBy ? (
+              <span className="text-xs text-success">
+                {copy.pipeline.mergedBy(approverName(wo.mergedBy))}
+              </span>
+            ) : null}
+          </span>
+        </div>
+
+        {items
+          .filter((i) => i.state === "open")
+          .map((item) => (
+            <DecisionCard key={item.id} item={item} showRun={false} />
+          ))}
+
+        {showFindings ? (
+          <Section title={copy.pipeline.detail.findings}>
+            <ul className="flex flex-col gap-2">
+              {wo.findings!.map((f, i) => (
+                <li
+                  key={`${f.title}-${i}`}
+                  className="rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm"
+                >
+                  <p className="text-foreground">
+                    <span className="mr-1.5 text-xs uppercase text-muted">
+                      {f.severity}
+                    </span>
+                    {f.title}
+                  </p>
+                  {f.detail ? (
+                    <pre className="mt-1 max-h-48 overflow-auto whitespace-pre-wrap font-mono text-xs text-muted custom-scrollbar">
+                      {f.detail}
+                    </pre>
+                  ) : null}
+                </li>
+              ))}
+            </ul>
+          </Section>
+        ) : null}
+
+        <Section title={copy.pipeline.detail.acceptance}>
+          <ol className="flex list-decimal flex-col gap-1 pl-5 text-sm">
+            {wo.acceptance.map((a) => (
+              <li key={a}>
+                <FactoryMarkdown text={a} className="min-w-0" />
+              </li>
+            ))}
+          </ol>
+        </Section>
+
+        {wo.controls.length ? (
+          <Section title={copy.pipeline.detail.controls}>
+            <span className="flex flex-wrap gap-1">
+              {wo.controls.map((c) => (
+                <span
+                  key={c}
+                  className="inline-flex items-center gap-1 rounded-md border border-border-subtle px-1.5 py-0.5 font-mono text-xs text-foreground"
+                >
+                  <Shield className="size-3 text-muted" aria-hidden />
+                  {c}
+                </span>
+              ))}
+            </span>
+          </Section>
+        ) : null}
+
+        <Section title={copy.pipeline.detail.agents}>
+          {attempts.length ? (
+            <AttemptList attempts={attempts} />
+          ) : (
+            <p className="text-sm text-muted">{copy.pipeline.noAgents}</p>
+          )}
+        </Section>
+
+        <Section title={copy.pipeline.detail.checks}>
+          {checks.length ? (
+            <CheckList checks={checks} />
+          ) : (
+            <p className="text-sm text-muted">
+              {copy.pipeline.detail.noChecks}
+            </p>
+          )}
+        </Section>
+
+        {wo.branch ? (
+          <Section title={copy.pipeline.detail.branch}>
+            <code className="break-all font-mono text-xs text-muted">
+              {wo.branch}
+            </code>
+          </Section>
+        ) : null}
+      </div>
+    </aside>
+  );
+}
+
+function Section({
+  title,
+  children,
+}: {
+  title: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <section className="flex flex-col gap-1.5">
+      <h3 className="text-xs font-medium text-muted">{title}</h3>
+      {children}
+    </section>
+  );
+}
