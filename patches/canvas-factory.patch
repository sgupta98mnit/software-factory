+import React from "react";
+import { Link, NavLink, useNavigate, useParams } from "react-router";
+import { Bot, CircleCheck, CircleDashed, ListChecks } from "lucide-react";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import {
+  FactoryApi,
+  type ChangeDetail,
+  type Requirement,
+  type ValidationResult,
+} from "../api";
+import { useFactoryCopy } from "../copy";
+import {
+  useChangeDetail,
+  useFactoryHealth,
+  useSpecsOverview,
+  useValidateSpecs,
+  useWorkOrders,
+} from "../hooks";
+import {
+  FactoryError,
+  FactoryLoading,
+  FactoryPage,
+} from "../components/factory-page";
+import { FactoryMarkdown } from "../components/factory-markdown";
+import { StartAgentModal } from "../components/start-agent-modal";
+import { WorkOrderPlanModal } from "../components/work-order-plan-modal";
+
+type Tab = "requirements" | "proposal" | "design" | "tasks";
+const TABS: Tab[] = ["requirements", "proposal", "design", "tasks"];
+
+export default function FactoryRequirementsRoute() {
+  const copy = useFactoryCopy();
+  const { changeId } = useParams();
+  const navigate = useNavigate();
+  const overview = useSpecsOverview();
+  const health = useFactoryHealth();
+  const changes = overview.data?.changes.changes ?? [];
+  const specs = overview.data?.specs.specs ?? [];
+
+  // Open the first change when none is picked.
+  React.useEffect(() => {
+    if (!changeId && changes[0]) {
+      navigate(`/requirements/${changes[0].name}`, { replace: true });
+    }
+  }, [changeId, changes, navigate]);
+
+  return (
+    <FactoryPage
+      testId="factory-requirements"
+      title={copy.requirements.title}
+      subtitle={
+        health.data
+          ? copy.requirements.subtitle(health.data.workspace.name)
+          : undefined
+      }
+      error={overview.error}
+      onRetry={() => void overview.refetch()}
+      fill
+    >
