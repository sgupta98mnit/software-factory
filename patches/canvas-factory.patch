+  it("downloads terminal run evidence, prevents duplicate clicks and releases the object URL", async () => {
+    const user = userEvent.setup();
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const exported = {
+      packet: { schemaVersion: 1, run: { id: runDetail.id } },
+      digest: {
+        algorithm: "sha256",
+        canonicalization: "sf-canonical-json-v1",
+        value: "digest",
+      },
+    };
+    let requests = 0;
+    server.use(
+      http.get("*/sf-api/autopilot/runs/ap-1a2b3c4d", () =>
+        HttpResponse.json({ ...runDetail, state: "done" }),
+      ),
+      http.get("*/sf-api/autopilot/status", () =>
+        HttpResponse.json({ agentServer: { profiles: [] } }),
+      ),
+      http.post("*/sf-api/autopilot/runs/ap-1a2b3c4d/evidence", async () => {
+        requests += 1;
+        await pending;
+        return HttpResponse.json(exported);
+      }),
+    );
+    const createObjectURL = vi.fn((_blob: Blob) => "blob:evidence");
+    const revokeObjectURL = vi.fn();
+    // Keep URL's constructor and existing statics for router/fetch consumers.
+    class DownloadURL extends URL {
+      static createObjectURL = createObjectURL;
+      static revokeObjectURL = revokeObjectURL;
+    }
+    vi.stubGlobal("URL", DownloadURL);
+    const downloads: { href: string; filename: string }[] = [];
+    vi.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(function (
+      this: HTMLAnchorElement,
+    ) {
+      downloads.push({ href: this.href, filename: this.download });
+    });
+    renderWithProviders(
+      <MemoryRouter initialEntries={["/autopilot/runs/ap-1a2b3c4d"]}>
+        <Routes>
+          <Route
+            path="/autopilot/runs/:runId"
+            element={<AutopilotPipelineRoute />}
+          />
+        </Routes>
+      </MemoryRouter>,
+    );
+    await user.click(
+      await screen.findByRole("button", { name: "Download evidence" }),
+    );
+    const preparing = screen.getByRole("button", {
+      name: "Preparing evidence…",
+    });
+    expect(preparing).toBeDisabled();
+    await user.click(preparing);
+    release();
+    await waitFor(() =>
+      expect(downloads).toEqual([
+        { href: "blob:evidence", filename: "ap-1a2b3c4d-evidence.json" },
+      ]),
+    );
+    expect(requests).toBe(1);
+    expect(createObjectURL.mock.calls[0]?.[0]).toBeInstanceOf(Blob);
+    const contents = await new Promise<string>((resolve, reject) => {
+      const reader = new FileReader();
+      reader.onload = () => resolve(String(reader.result));
+      reader.onerror = reject;
+      reader.readAsText(createObjectURL.mock.calls[0]![0]);
+    });
+    expect(JSON.parse(contents)).toEqual(exported);
+    await waitFor(() =>
+      expect(revokeObjectURL).toHaveBeenCalledWith("blob:evidence"),
+    );
+    expect(
+      screen.getByRole("button", { name: "Download evidence" }),
+    ).toBeEnabled();
+  });
