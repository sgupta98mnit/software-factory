+type Stage = "spec" | "plan" | "build" | "verify" | "integrate" | "done";
+const STAGES: Stage[] = [
+  "spec",
+  "plan",
+  "build",
+  "verify",
+  "integrate",
+  "done",
+];
+const SPEC_STATES: RunState[] = [
+  "spec",
+  "critic",
+  "awaiting_spec_approval",
+  "awaiting_answers",
+];
+// Work orders that need attention, or were cancelled, sit outside the lanes; their cards say why.
+const WORK_ORDER_STAGE: Partial<Record<WorkOrderState, Stage>> = {
+  pending: "build",
+  building: "build",
+  verifying: "verify",
+  reviewing: "verify",
+  ready: "integrate",
+  awaiting_merge_approval: "integrate",
+  merging: "integrate",
+  merged: "done",
+  skipped: "done",
+};
+const WORK_ORDER_LANES: Stage[] = ["build", "verify", "integrate", "done"];
+
+function currentStage(run: RunDetail, counts: Record<Stage, number>): Stage {
+  if (run.state === "done") return "done";
+  if (SPEC_STATES.includes(run.state)) return "spec";
+  if (run.state === "awaiting_plan_approval") return "plan";
+  if (run.workOrders.length === 0) return "spec";
+  // Only work that needs attention left: it's still the build stage, not done.
+  return (
+    (["build", "verify", "integrate"] as const).find((s) => counts[s] > 0) ??
+    (isRunFinished(run.state) ? "done" : "build")
+  );
+}
+
+function StageLanes({ run }: { run: RunDetail }) {
+  const copy = useFactoryCopy();
+  const counts = Object.fromEntries(STAGES.map((s) => [s, 0])) as Record<
+    Stage,
+    number
+  >;
+  for (const wo of run.workOrders) {
+    const stage = WORK_ORDER_STAGE[wo.state];
+    if (stage) counts[stage] += 1;
+  }
+  const current = STAGES.indexOf(currentStage(run, counts));
+  // Where a paused, failed or cancelled run stopped isn't "now".
+  const stopped = run.state === "paused" || isRunFinished(run.state);
+
+  return (
+    <ol
+      aria-label={copy.pipeline.stagesLabel}
+      className="grid grid-cols-2 gap-2 min-[480px]:grid-cols-3 lg:grid-cols-6"
+    >
+      {STAGES.map((stage, index) => {
+        let status: "done" | "current" | "upcoming" = "upcoming";
+        if (index < current || (stage === "done" && run.state === "done")) {
+          status = "done";
+        } else if (index === current) status = "current";
+        const hasCount = WORK_ORDER_LANES.includes(stage);
+        let Icon = Circle;
+        if (status === "done") Icon = CircleCheck;
+        if (status === "current") Icon = CircleDot;
+        return (
+          <li
+            key={stage}
+            aria-current={status === "current" ? "step" : undefined}
+            className={cn(
+              "flex min-w-0 flex-col gap-1 rounded-xl border px-3 py-2",
+              status === "current"
+                ? "border-primary bg-surface-raised"
+                : "border-border-subtle bg-surface",
+            )}
+          >
+            <span className="flex items-center gap-1.5 text-sm font-medium text-foreground">
+              <Icon
+                className={cn(
+                  "size-4 shrink-0",
+                  status === "done" && "text-success",
+                  status === "current" && "text-primary",
+                  status === "upcoming" && "text-muted",
+                )}
+                aria-hidden
+              />
+              <span className="truncate">{copy.pipeline.stages[stage]}</span>
+              {hasCount ? (
+                <span className="ml-auto text-sm tabular-nums text-foreground">
+                  <span aria-hidden>{counts[stage]}</span>
+                  <span className="sr-only">
+                    {copy.pipeline.workOrderCount(counts[stage])}
