@@ -0,0 +1,518 @@
+/**
+ * Client for the Software Factory API (apps/server in the software-factory
+ * repo). It is not part of the OpenHands agent server: Vite proxies `/sf-api`
+ * to it (see `vite.config.ts`), so these are same-origin requests.
+ */
+
+export const FACTORY_API_BASE = "/sf-api";
+
+export interface FactoryHealth {
+  /** `agentPath` is the same folder as the agent server sees it (differs only in a Docker sandbox). */
+  workspace: { name: string; path: string; agentPath: string; exists: boolean };
+  user: string;
+  versions: { openspec: string; backlog: string };
+}
+
+export interface ChangeSummary {
+  name: string;
+  completedTasks: number;
+  totalTasks: number;
+  lastModified: string;
+  status: string;
+}
+
+export interface SpecsOverview {
+  changes: { changes: ChangeSummary[] };
+  specs: { specs: { id: string; requirementCount: number }[] };
+}
+
+export interface Requirement {
+  name?: string;
+  text: string;
+  scenarios: { name?: string; rawText: string }[];
+}
+
+export interface ChangeDetail {
+  id: string;
+  show: {
+    id: string;
+    title: string;
+    deltaCount: number;
+    deltas: {
+      spec: string;
+      operation: string;
+      description: string;
+      requirement?: Requirement;
+    }[];
+  };
+  status: {
+    isComplete?: boolean;
+    artifacts: { id: string; status: string }[];
+  };
+  files: {
+    proposal: string | null;
+    design: string | null;
+    tasks: string | null;
+    specs: { path: string; markdown: string }[];
+  };
+}
+
+export interface ValidationResult {
+  items: {
+    id: string;
+    type: string;
+    valid: boolean;
+    issues: { level: string; path: string; message: string }[];
+  }[];
+  summary: { totals: { items: number; passed: number; failed: number } };
+}
+
+export interface PlannedWorkOrder {
+  title: string;
+  description: string;
+  acceptanceCriteria: string[];
+  controls: string[];
+  labels: string[];
+  dependsOn: number | null;
+}
+
+export interface WorkOrderPlan {
+  change: string;
+  source: string;
+  workOrders: PlannedWorkOrder[];
+  existing: { id: string; title: string; status: string }[];
+}
+
+export interface WorkOrderConversation {
+  id: string;
+  agent: string;
+  by: string;
+  at: string;
+}
+
+export interface WorkOrder {
+  id: string;
+  title: string;
+  status: string;
+  assignee: string[];
+  labels: string[];
+  dependencies: string[];
+  priority?: string;
+  createdDate?: string;
+  updatedDate?: string;
+  description: string;
+  acceptanceCriteria: { index: number; text: string; done: boolean }[];
+  plan?: string;
+  notes?: string;
+  finalSummary?: string;
+  file: string;
+  approval?: { by: string; at: string };
+  doneWithoutApproval: boolean;
+  conversations: WorkOrderConversation[];
+}
+
+export interface WorkOrderList {
+  initialized: boolean;
+  statuses: string[];
+  finalStatus: string;
+  workOrders: WorkOrder[];
+}
+
+export interface AuditEvent {
+  seq: number;
+  at: string;
+  actor: string;
+  action: string;
+  subject: string;
+  data: Record<string, unknown>;
+  prevHash: string;
+  hash: string;
+}
+
+export interface AuditVerification {
+  ok: boolean;
+  checked: number;
+  brokenAt?: number;
+  reason?: string;
+}
+
+// Autopilot (apps/server/src/autopilot/routes.ts, mounted at /sf-api/autopilot).
+
+export type Autonomy = "suggest" | "supervised" | "autonomous";
+export type RunState =
+  | "spec"
+  | "critic"
+  | "awaiting_spec_approval"
+  | "awaiting_answers"
+  | "awaiting_plan_approval"
+  | "building"
+  | "done"
+  | "paused"
+  | "failed"
+  | "cancelled";
+export type WorkOrderState =
+  | "pending"
+  | "building"
+  | "verifying"
+  | "reviewing"
+  | "ready"
+  | "awaiting_merge_approval"
+  | "merging"
+  | "merged"
+  | "needs_attention"
+  | "skipped"
+  | "cancelled";
+export type AttemptRole =
+  | "spec"
+  | "critic"
+  | "builder"
+  | "reviewer"
+  | "validator";
+export type AttemptState =
+  | "starting"
+  | "running"
+  | "finished"
+  | "error"
+  | "stuck"
+  | "paused"
+  | "cancelled";
+export type InboxKind =
+  | "spec_approval"
+  | "plan_approval"
+  | "questions"
+  | "spec_failed"
+  | "merge_approval"
+  | "work_order_failed"
+  | "budget_reached"
+  | "run_paused"
+  | "error"
+  | "release";
+export type Severity = "critical" | "high" | "medium" | "low";
+
+export interface InboxOption {
+  id: string;
+  label: string;
+  tone?: "primary" | "danger" | "default";
+  needsNote?: boolean;
+}
+
+export interface Finding {
+  source: "gate" | "review" | "hidden" | "integration" | "critic" | "agent";
+  severity: Severity;
+  title: string;
+  detail: string;
+  file?: string | null;
+  criterion?: number | null;
+  scenario?: string | null;
+}
+
+export type ExecutionProvider = "local" | "container";
+
+/** Where an attempt ran (apps/server/src/autopilot/execution.ts). No secrets: credentials are names. */
+export interface ExecutionFacts {
+  provider: ExecutionProvider;
+  isolated: boolean;
+  container?: string;
+  image?: string;
+  imageId?: string | null;
+  network?: string;
+  user?: string | null;
+  limits?: { memory: string; cpus: number; pids: number };
+  credentials?: string[];
+  mounts?: string[];
+  released?: boolean;
+}
+
+/** What stops a run from executing the way the policy asks; `problems` refuse it. */
+export interface ExecutionPreflight {
+  provider: ExecutionProvider;
+  isolated: boolean;
+  required: boolean;
+  ok: boolean;
+  problems: string[];
+  notes: string[];
+  facts: ExecutionFacts;
+  checkedAt: string;
+}
+
+export interface RunCounts {
+  total: number;
+  merged: number;
+  active: number;
+  failed: number;
+  pending: number;
+}
+
+export interface RunSummary {
+  id: string;
+  goal: string;
+  change: string;
+  autonomy: Autonomy;
+  state: RunState;
+  pausedReason: string | null;
+  baseBranch: string;
+  integrationBranch: string;
+  costUsd: number;
+  budgetUsd: number | null;
+  policyHash: string | null;
+  /** How the run's pinned policy executes agents and gates. */
+  execution: { provider: ExecutionProvider; isolated: boolean };
+  /**
+   * Where its checks come from (null for runs from before pinning; worktree
+   * means the base had none to pin), its hidden tests and its scanner mode.
+   */
+  verification: {
+    pinned: "policy" | "base" | "worktree" | null;
+    gates: string[];
+    hiddenTests: "off" | "pending" | number;
+    scan: "off" | "advisory" | "required";
+  };
+  createdBy: string;
+  createdAt: string;
+  updatedAt: string;
+  counts: RunCounts;
+  openInbox: number;
+}
+
+export interface WorkOrderView {
+  id: string;
+  runId: string;
+  seq: number;
+  /** "WO-2" */
+  key: string;
+  title: string;
+  acceptance: string[];
+  controls: string[];
+  dependsOn: number[];
+  wave: number;
+  risk: "low" | "medium" | "high";
+  state: WorkOrderState;
+  branch: string | null;
+  costUsd: number;
+  /** Builder conversations so far. */
+  attempts: number;
+  /** Turns of the current builder conversation. */
+  round: number;
+  /** Latest builder conversation. */
+  conversationId: string | null;
+  findings: Finding[] | null;
+  mergedBy: string | null;
+  updatedAt: string;
+}
+
+export interface AttemptView {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  role: AttemptRole;
+  conversationId: string;
+  agentProfile: string | null;
+  state: AttemptState;
+  turns: number;
+  costUsd: number;
+  result: unknown;
+  /** Null for attempts from before isolated execution. */
+  execution: ExecutionFacts | null;
+  startedAt: string;
+  finishedAt: string | null;
+}
+
+export interface CheckView {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  stage: "spec" | "build" | "integrate";
+  name: string;
+  ok: boolean;
+  exitCode: number | null;
+  durationMs: number | null;
+  output: string;
+  /** Where a gate ran; null for the factory's own checks and older ones. */
+  runner: ExecutionProvider | null;
+  /** The commit it checked; null for checks from before commit binding. */
+  sha: string | null;
+  /** A scanner's version and database date, digests, counts, statuses. */
+  meta: Record<string, unknown> | null;
+  at: string;
+}
+
+export interface InboxItemView {
+  id: number;
+  runId: string;
+  workOrderId: string | null;
+  kind: InboxKind;
+  title: string;
+  body: string;
+  options: InboxOption[];
+  state: "open" | "decided" | "dismissed";
+  decision: string | null;
+  note: string | null;
+  decidedBy: string | null;
+  decidedAt: string | null;
+  createdAt: string;
+}
+
+export interface RunDetail extends RunSummary {
+  workOrders: WorkOrderView[];
+  attempts: AttemptView[];
+  checks: CheckView[];
+  inbox: InboxItemView[];
+  etaMs: number | null;
+}
+
+export interface AutopilotStatus {
+  agentServer: {
+    url: string;
+    reachable: boolean;
+    error: string | null;
+    profiles: {
+      id: string;
+      name: string;
+      kind: string;
+      server: string | null;
+    }[];
+    activeProfileId: string | null;
+  };
+  workspace: { path: string; isRepo: boolean; branch: string | null };
+  policy: { source: string; hash: string; error: string | null };
+  /** How a run started now would execute; `required` is SF_REQUIRE_ISOLATION. */
+  execution: {
+    provider: ExecutionProvider;
+    isolated: boolean;
+    required: boolean;
+    image: string | null;
+    network: string | null;
+    preflight: ExecutionPreflight | null;
+  };
+  /** What a run started now would get, and whether its scanner answers. */
+  verification: {
+    hiddenTests: boolean;
+    protectedPaths: string[];
+    scanner: {
+      mode: "off" | "advisory" | "required";
+      ok: boolean | null;
+      version: string | null;
+      dbUpdatedAt: string | null;
+      problem: string | null;
+    };
+  };
+  openInbox: number;
+  activeRuns: number;
+}
+
+export type RunAction = "pause" | "resume" | "cancel";
+export type InboxFilter = "open" | "decided" | "all";
+
+/** Versioned packet stays opaque in Canvas: download the server's full evidence. */
+export interface RunEvidence {
+  packet: { schemaVersion: 1; [key: string]: unknown };
+  digest: {
+    algorithm: "sha256";
+    canonicalization: "sf-canonical-json-v1";
+    value: string;
+  };
+}
+
+/** Thrown when the factory API can't be reached at all (server not running). */
+export class FactoryOfflineError extends Error {
+  constructor() {
+    super("The Software Factory API isn't running.");
+    this.name = "FactoryOfflineError";
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${FACTORY_API_BASE}${path}`, {
+      ...init,
+      headers: init?.body
+        ? { "Content-Type": "application/json", ...init.headers }
+        : init?.headers,
+    });
+  } catch {
+    throw new FactoryOfflineError();
+  }
+  // The dev proxy answers 502/504 (or Vite's HTML fallback) when nothing is listening.
+  const isJson = (response.headers.get("content-type") ?? "").includes(
+    "application/json",
+  );
+  if (!isJson && (response.status >= 500 || response.status === 404)) {
+    throw new FactoryOfflineError();
+  }
+  const data = isJson ? await response.json() : null;
+  if (!response.ok) {
+    throw new Error(
+      (data as { error?: string } | null)?.error ??
+        `${response.status} ${response.statusText}`,
+    );
+  }
+  return data as T;
+}
+
+const post = <T>(path: string, body: unknown = {}) =>
+  request<T>(path, { method: "POST", body: JSON.stringify(body) });
+
+export const FactoryApi = {
+  health: () => request<FactoryHealth>("/health"),
+  specs: () => request<SpecsOverview>("/specs"),
+  change: (id: string) =>
+    request<ChangeDetail>(`/specs/changes/${encodeURIComponent(id)}`),
+  validate: () => post<ValidationResult>("/specs/validate"),
+  changeBrief: (id: string, purpose: "review" | "plan") =>
+    request<{ text: string }>(
+      `/specs/changes/${encodeURIComponent(id)}/brief/${purpose}`,
+    ),
+  workOrderPlan: (id: string) =>
+    request<WorkOrderPlan>(
+      `/specs/changes/${encodeURIComponent(id)}/work-order-plan`,
+    ),
+  createWorkOrders: (id: string) =>
+    post<{ change: string; created: { id: string; title: string }[] }>(
+      `/specs/changes/${encodeURIComponent(id)}/work-orders`,
+    ),
+  workOrders: () => request<WorkOrderList>("/workorders"),
+  workOrderBrief: (id: string) =>
+    request<{ workOrder: string; text: string }>(
+      `/workorders/${encodeURIComponent(id)}/brief`,
+    ),
+  setStatus: (
+    id: string,
+    body: { status: string; approve?: boolean; note?: string },
+  ) => post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/status`, body),
+  linkConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/conversations`, {
+      conversationId,
+      agent,
+    }),
+  linkChangeConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(
+      `/specs/changes/${encodeURIComponent(id)}/conversations`,
+      { conversationId, agent },
+    ),
+  audit: () => request<AuditEvent[]>("/audit"),
+  verifyAudit: () => request<AuditVerification>("/audit/verify"),
+
+  autopilotStatus: () => request<AutopilotStatus>("/autopilot/status"),
+  checkExecution: () =>
+    post<ExecutionPreflight>("/autopilot/execution/preflight"),
+  runs: () => request<RunSummary[]>("/autopilot/runs"),
+  createRun: (body: {
+    goal: string;
+    autonomy?: Autonomy;
+    budgetUsd?: number;
+  }) => post<RunSummary>("/autopilot/runs", body),
+  run: (id: string) =>
+    request<RunDetail>(`/autopilot/runs/${encodeURIComponent(id)}`),
+  runEvidence: (id: string) =>
+    post<RunEvidence>(`/autopilot/runs/${encodeURIComponent(id)}/evidence`),
+  runAction: (id: string, action: RunAction, note?: string) =>
+    post<RunSummary>(`/autopilot/runs/${encodeURIComponent(id)}/${action}`, {
+      note,
+    }),
+  inbox: (state: InboxFilter) =>
+    request<InboxItemView[]>(`/autopilot/inbox?state=${state}`),
+  inboxCount: () => request<{ open: number }>("/autopilot/inbox/count"),
+  decide: (id: number, body: { choice: string; note?: string }) =>
+    post<InboxItemView>(`/autopilot/inbox/${id}/decide`, body),
+};
