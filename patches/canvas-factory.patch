+            {column.map((wo) => (
+              <WorkOrderCard
+                key={wo.id}
+                workOrder={wo}
+                list={list}
+                selected={wo.id === selectedId}
+                href={hrefFor(wo.id)}
+              />
+            ))}
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+function WorkOrderCard({
+  workOrder: wo,
+  list,
+  selected,
+  href,
+}: {
+  workOrder: WorkOrder;
+  list: WorkOrderList;
+  selected: boolean;
+  href: string;
+}) {
+  const copy = useFactoryCopy();
+  const done = wo.acceptanceCriteria.filter((ac) => ac.done).length;
+  const total = wo.acceptanceCriteria.length;
+  const waitingOn = wo.dependencies.filter(
+    (d) =>
+      list.workOrders.find((w) => w.id.toLowerCase() === d.toLowerCase())
+        ?.status !== list.finalStatus,
+  );
+  return (
+    <Link
+      to={href}
+      data-testid={`factory-work-order-${wo.id}`}
+      aria-current={selected ? "true" : undefined}
+      className={cn(
+        "flex flex-col gap-2 rounded-xl border bg-surface px-3 py-2.5 hover:bg-surface-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-focus",
+        selected ? "border-primary" : "border-border-subtle",
+      )}
+    >
+      <span className="flex items-baseline gap-2">
+        <span className="font-mono text-xs text-muted">{wo.id}</span>
+        <span className="min-w-0 flex-1 text-sm font-medium text-foreground">
+          {wo.title}
+        </span>
+      </span>
+      <span className="flex flex-wrap gap-1">
+        {wo.labels
+          .filter((l) => l.startsWith("control:"))
+          .map((l) => (
+            <LabelChip key={l} label={l} />
+          ))}
+      </span>
+      <span className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
+        {total > 0 ? (
+          <span
+            className="inline-flex items-center gap-1 tabular-nums"
+            title={copy.workOrders.criteriaLabel}
+          >
+            <CircleCheck className="size-3.5" aria-hidden />
+            {copy.workOrders.criteriaProgress(done, total)}
+          </span>
+        ) : null}
+        {wo.conversations.length ? (
+          <span className="inline-flex items-center gap-1">
+            <MessageSquare className="size-3.5" aria-hidden />
+            {copy.workOrders.conversations(wo.conversations.length)}
+          </span>
+        ) : null}
+        {waitingOn.length > 0 && wo.status !== list.finalStatus ? (
+          <span className="inline-flex items-center gap-1">
+            <GitBranch className="size-3.5" aria-hidden />
+            {copy.workOrders.waitingOn(waitingOn.join(", "))}
+          </span>
+        ) : null}
+        {wo.approval ? (
+          <span className="inline-flex items-center gap-1 text-success">
+            <ShieldCheck className="size-3.5" aria-hidden />
+            {copy.workOrders.approvedBy(actorName(wo.approval.by))}
+          </span>
+        ) : null}
+        {wo.doneWithoutApproval ? (
+          <span className="inline-flex items-center gap-1 text-warning">
+            <TriangleAlert className="size-3.5" aria-hidden />
+            {copy.workOrders.notApproved}
+          </span>
+        ) : null}
+      </span>
+    </Link>
+  );
+}
+
+function WorkOrderDetail({
+  workOrder: wo,
+  list,
+  hrefFor,
+  onClose,
+}: {
+  workOrder: WorkOrder;
+  list: WorkOrderList;
+  hrefFor: (id?: string) => string;
+  onClose: () => void;
+}) {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const setStatus = useSetWorkOrderStatus();
+  const [agentOpen, setAgentOpen] = React.useState(false);
+  const [approveOpen, setApproveOpen] = React.useState(false);
+  const { statuses, finalStatus } = list;
+  const index = statuses.indexOf(wo.status);
+  const isFinal = wo.status === finalStatus;
+  // Moves a person can make without approving: any non-final status other than the current one.
+  const moves = statuses.filter((s) => s !== wo.status && s !== finalStatus);
+  const reviewStatus = statuses.at(-2) ?? statuses[0];
+  const canApprove = (!isFinal && index > 0) || wo.doneWithoutApproval;
+  const openDependencies = wo.dependencies.filter(
+    (d) =>
+      list.workOrders.find((w) => w.id.toLowerCase() === d.toLowerCase())
+        ?.status !== finalStatus,
+  );
+
+  return (
+    <aside
+      data-testid="factory-work-order-detail"
+      aria-label={`${wo.id} ${wo.title}`}
+      className="flex w-104 shrink-0 flex-col overflow-y-auto border-l border-border-subtle bg-base-secondary custom-scrollbar"
+    >
+      <div className="flex items-center gap-3 border-b border-border-subtle px-5 py-3">
+        <span className="font-mono text-sm text-muted">{wo.id}</span>
+        <StatusPill status={wo.status} statuses={statuses} />
+        <button
+          type="button"
+          onClick={onClose}
+          aria-label={copy.workOrders.closeDetail}
+          className="ml-auto inline-flex size-8 items-center justify-center rounded-md text-muted hover:bg-interactive-hover hover:text-contrast"
+        >
+          <X className="size-4" aria-hidden />
+        </button>
+      </div>
+
+      <div className="flex flex-col gap-5 px-5 py-4">
+        <h2 className="text-base font-semibold text-foreground">{wo.title}</h2>
+
+        {wo.approval ? (
+          <p className="flex items-center gap-2 text-sm text-foreground">
+            <ShieldCheck className="size-4 text-success" aria-hidden />
+            {`${copy.workOrders.approvedBy(actorName(wo.approval.by))} · ${formatWhen(wo.approval.at, i18n.language)}`}
+          </p>
+        ) : null}
+        {wo.doneWithoutApproval ? (
+          <div
+            role="alert"
+            className="flex flex-col gap-2 rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
+          >
+            <p className="flex items-center gap-2 font-medium text-foreground">
+              <TriangleAlert className="size-4 text-warning" aria-hidden />
+              {copy.workOrders.notApproved}
+            </p>
+            <p className="text-muted">{copy.workOrders.notApprovedHelp}</p>
+          </div>
+        ) : null}
+
+        <div className="flex flex-wrap gap-2">
+          {/* Not started: the next step is an agent. Started: the next step is your approval. */}
+          {canApprove ? (
+            <BrandButton
+              testId="factory-approve"
+              type="button"
+              variant="primary"
+              onClick={() => setApproveOpen(true)}
+              startContent={<ShieldCheck className="size-4" aria-hidden />}
+            >
+              {copy.workOrders.approve}
+            </BrandButton>
+          ) : null}
+          {!isFinal ? (
+            <BrandButton
+              testId="factory-start-agent"
+              type="button"
+              variant={canApprove ? "secondary" : "primary"}
+              onClick={() => setAgentOpen(true)}
+              startContent={<Bot className="size-4" aria-hidden />}
+            >
+              {copy.workOrders.startAgent}
+            </BrandButton>
+          ) : null}
+          {moves.map((status) => (
+            <BrandButton
+              key={status}
+              type="button"
+              variant="tertiary"
+              onClick={() => setStatus.mutate({ id: wo.id, status })}
+              isDisabled={setStatus.isPending}
+            >
+              {isFinal && status === reviewStatus
+                ? copy.workOrders.reopen(status)
+                : copy.workOrders.moveTo(status)}
+            </BrandButton>
+          ))}
+        </div>
+        <FactoryError error={setStatus.error} />
+
+        {wo.description ? (
+          <DetailSection title={copy.workOrders.description}>
+            <FactoryMarkdown text={wo.description} />
+          </DetailSection>
+        ) : null}
+
+        {wo.acceptanceCriteria.length ? (
+          <DetailSection title={copy.workOrders.criteria}>
+            <ul className="flex flex-col gap-1.5">
+              {wo.acceptanceCriteria.map((ac) => (
+                <li key={ac.index} className="flex items-start gap-2 text-sm">
+                  {ac.done ? (
+                    <CircleCheck
+                      className="mt-0.5 size-4 shrink-0 text-success"
+                      aria-label={copy.requirements.artifactDone}
+                    />
+                  ) : (
+                    <Circle
+                      className="mt-0.5 size-4 shrink-0 text-muted"
+                      aria-hidden
+                    />
+                  )}
+                  <FactoryMarkdown text={ac.text} className="min-w-0" />
+                </li>
+              ))}
+            </ul>
+          </DetailSection>
+        ) : null}
+
+        {wo.finalSummary ? (
+          <DetailSection title={copy.workOrders.finalSummary}>
+            <FactoryMarkdown text={wo.finalSummary} />
+          </DetailSection>
+        ) : null}
+        {wo.notes ? (
+          <DetailSection title={copy.workOrders.notes}>
+            <FactoryMarkdown text={wo.notes} />
+          </DetailSection>
+        ) : null}
+        {wo.plan ? (
+          <DetailSection title={copy.workOrders.plan}>
+            <FactoryMarkdown text={wo.plan} />
+          </DetailSection>
+        ) : null}
+
+        <DetailSection title={copy.workOrders.agentConversations}>
+          {wo.conversations.length ? (
+            <ul className="flex flex-col gap-1">
+              {wo.conversations.map((c) => (
+                <li key={c.id} className="text-sm">
+                  <Link
+                    to={`/conversations/${c.id}`}
+                    className="inline-flex items-center gap-1.5 text-link hover:underline"
+                  >
+                    <MessageSquare className="size-3.5" aria-hidden />
+                    {c.agent || copy.workOrders.openConversation}
+                  </Link>{" "}
+                  <span className="text-muted">
+                    {`${actorName(c.by)} · ${formatWhen(c.at, i18n.language)}`}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <p className="text-sm text-muted">
+              {copy.workOrders.noConversations}
+            </p>
+          )}
+        </DetailSection>
+
+        {wo.dependencies.length ? (
+          <DetailSection title={copy.workOrders.dependencies}>
+            <ul className="flex flex-wrap gap-2">
+              {wo.dependencies.map((d) => (
+                <li key={d}>
+                  <Link
+                    to={hrefFor(d)}
+                    className="font-mono text-sm text-link hover:underline"
+                  >
+                    {d}
+                  </Link>
+                </li>
+              ))}
+            </ul>
+          </DetailSection>
+        ) : null}
+
+        {wo.labels.length ? (
+          <DetailSection title={copy.workOrders.labels}>
+            <div className="flex flex-wrap gap-1">
+              {wo.labels.map((l) => (
+                <LabelChip key={l} label={l} />
+              ))}
+            </div>
+          </DetailSection>
+        ) : null}
+
+        <DetailSection title={copy.workOrders.file}>
+          <code className="break-all font-mono text-xs text-muted">
+            {wo.file}
+          </code>
+        </DetailSection>
+
+        <Link
+          to={`/audit-log?q=${encodeURIComponent(wo.id)}`}
+          className="inline-flex items-center gap-1.5 text-sm text-link hover:underline"
+        >
+          <History className="size-4" aria-hidden />
+          {copy.workOrders.history}
+        </Link>
+      </div>
+
+      {agentOpen ? (
+        <StartAgentModal
+          subject={wo.id}
+          loadBrief={async () => (await FactoryApi.workOrderBrief(wo.id)).text}
+          onStarted={(conversationId, agent) =>
+            FactoryApi.linkConversation(wo.id, conversationId, agent).then(
+              () => undefined,
+            )
+          }
+          onClose={() => setAgentOpen(false)}
+        />
+      ) : null}
+      {approveOpen ? (
+        <ApproveModal
+          workOrder={wo}
+          finalStatus={finalStatus}
+          openDependencies={openDependencies}
+          onClose={() => setApproveOpen(false)}
+        />
+      ) : null}
+    </aside>
+  );
+}
+
+function DetailSection({
+  title,
+  children,
+}: {
+  title: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <section className="flex flex-col gap-1.5">
+      <h3 className="text-xs font-medium text-muted">{title}</h3>
+      {children}
+    </section>
+  );
+}
