index 0000000..7ab8bbf
--- /dev/null
+++ b/src/factory/api.ts
@@ -0,0 +1,218 @@
+/**
+ * Client for the Software Factory API (apps/server in the software-factory
+ * repo). It is not part of the OpenHands agent server: Vite proxies `/sf-api`
+ * to it (see `vite.config.ts`), so these are same-origin requests.
+ */
+
+export const FACTORY_API_BASE = "/sf-api";
+
+export interface FactoryHealth {
+  /** `agentPath` is the same folder as the agent server sees it (differs only in a Docker sandbox). */
+  workspace: { name: string; path: string; agentPath: string; exists: boolean };
+  user: string;
+  versions: { openspec: string; backlog: string };
+}
+
+export interface ChangeSummary {
+  name: string;
+  completedTasks: number;
+  totalTasks: number;
+  lastModified: string;
+  status: string;
+}
+
+export interface SpecsOverview {
+  changes: { changes: ChangeSummary[] };
+  specs: { specs: { id: string; requirementCount: number }[] };
+}
+
+export interface Requirement {
+  name?: string;
+  text: string;
+  scenarios: { name?: string; rawText: string }[];
+}
+
+export interface ChangeDetail {
+  id: string;
+  show: {
+    id: string;
+    title: string;
+    deltaCount: number;
+    deltas: {
+      spec: string;
+      operation: string;
+      description: string;
+      requirement?: Requirement;
+    }[];
+  };
+  status: {
+    isComplete?: boolean;
+    artifacts: { id: string; status: string }[];
+  };
+  files: {
+    proposal: string | null;
+    design: string | null;
+    tasks: string | null;
+    specs: { path: string; markdown: string }[];
+  };
+}
+
+export interface ValidationResult {
+  items: {
+    id: string;
+    type: string;
+    valid: boolean;
+    issues: { level: string; path: string; message: string }[];
+  }[];
+  summary: { totals: { items: number; passed: number; failed: number } };
+}
+
+export interface PlannedWorkOrder {
+  title: string;
+  description: string;
+  acceptanceCriteria: string[];
+  controls: string[];
+  labels: string[];
+  dependsOn: number | null;
+}
+
+export interface WorkOrderPlan {
+  change: string;
+  source: string;
+  workOrders: PlannedWorkOrder[];
+  existing: { id: string; title: string; status: string }[];
+}
+
+export interface WorkOrderConversation {
+  id: string;
+  agent: string;
+  by: string;
+  at: string;
+}
+
+export interface WorkOrder {
+  id: string;
+  title: string;
+  status: string;
+  assignee: string[];
+  labels: string[];
+  dependencies: string[];
+  priority?: string;
+  createdDate?: string;
+  updatedDate?: string;
+  description: string;
+  acceptanceCriteria: { index: number; text: string; done: boolean }[];
+  plan?: string;
+  notes?: string;
+  finalSummary?: string;
+  file: string;
+  approval?: { by: string; at: string };
+  doneWithoutApproval: boolean;
+  conversations: WorkOrderConversation[];
+}
+
+export interface WorkOrderList {
+  initialized: boolean;
+  statuses: string[];
+  finalStatus: string;
+  workOrders: WorkOrder[];
+}
+
+export interface AuditEvent {
+  seq: number;
+  at: string;
+  actor: string;
+  action: string;
+  subject: string;
+  data: Record<string, unknown>;
+  prevHash: string;
+  hash: string;
+}
+
+export interface AuditVerification {
+  ok: boolean;
+  checked: number;
+  brokenAt?: number;
+  reason?: string;
+}
+
+/** Thrown when the factory API can't be reached at all (server not running). */
+export class FactoryOfflineError extends Error {
+  constructor() {
+    super("The Software Factory API isn't running.");
+    this.name = "FactoryOfflineError";
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${FACTORY_API_BASE}${path}`, {
+      ...init,
+      headers: init?.body
+        ? { "Content-Type": "application/json", ...init.headers }
+        : init?.headers,
+    });
+  } catch {
+    throw new FactoryOfflineError();
+  }
+  // The dev proxy answers 502/504 (or Vite's HTML fallback) when nothing is listening.
+  const isJson = (response.headers.get("content-type") ?? "").includes(
+    "application/json",
+  );
+  if (!isJson && (response.status >= 500 || response.status === 404)) {
+    throw new FactoryOfflineError();
+  }
+  const data = isJson ? await response.json() : null;
+  if (!response.ok) {
+    throw new Error(
+      (data as { error?: string } | null)?.error ??
+        `${response.status} ${response.statusText}`,
+    );
+  }
+  return data as T;
+}
+
+const post = <T>(path: string, body: unknown = {}) =>
+  request<T>(path, { method: "POST", body: JSON.stringify(body) });
+
+export const FactoryApi = {
+  health: () => request<FactoryHealth>("/health"),
+  specs: () => request<SpecsOverview>("/specs"),
+  change: (id: string) =>
+    request<ChangeDetail>(`/specs/changes/${encodeURIComponent(id)}`),
+  validate: () => post<ValidationResult>("/specs/validate"),
+  changeBrief: (id: string, purpose: "review" | "plan") =>
+    request<{ text: string }>(
+      `/specs/changes/${encodeURIComponent(id)}/brief/${purpose}`,
+    ),
+  workOrderPlan: (id: string) =>
+    request<WorkOrderPlan>(
+      `/specs/changes/${encodeURIComponent(id)}/work-order-plan`,
+    ),
+  createWorkOrders: (id: string) =>
+    post<{ change: string; created: { id: string; title: string }[] }>(
+      `/specs/changes/${encodeURIComponent(id)}/work-orders`,
+    ),
+  workOrders: () => request<WorkOrderList>("/workorders"),
+  workOrderBrief: (id: string) =>
+    request<{ workOrder: string; text: string }>(
+      `/workorders/${encodeURIComponent(id)}/brief`,
+    ),
+  setStatus: (
+    id: string,
+    body: { status: string; approve?: boolean; note?: string },
+  ) => post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/status`, body),
+  linkConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(`/workorders/${encodeURIComponent(id)}/conversations`, {
+      conversationId,
+      agent,
+    }),
+  linkChangeConversation: (id: string, conversationId: string, agent: string) =>
+    post<{ ok: true }>(
+      `/specs/changes/${encodeURIComponent(id)}/conversations`,
+      { conversationId, agent },
+    ),
+  audit: () => request<AuditEvent[]>("/audit"),
+  verifyAudit: () => request<AuditVerification>("/audit/verify"),
+};
