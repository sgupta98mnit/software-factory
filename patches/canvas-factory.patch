+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Link, useSearchParams } from "react-router";
+import { ShieldAlert, ShieldCheck } from "lucide-react";
+import { useMutation } from "@tanstack/react-query";
+import { BrandButton } from "#/components/features/settings/brand-button";
+import { cn } from "#/utils/utils";
+import { FactoryApi, type AuditEvent } from "../api";
+import { useFactoryCopy } from "../copy";
+import { useAuditLog } from "../hooks";
+import {
+  FactoryError,
+  FactoryLoading,
+  FactoryPage,
+} from "../components/factory-page";
+import { actorName, formatWhen } from "../components/factory-badges";
+import { factoryFieldClassName } from "../components/start-agent-modal";
+
+const WORK_ORDER_ID = /^[a-z]+-\d+$/i;
+
+/** The few data fields worth showing inline for each kind of entry. */
+function summarize(event: AuditEvent): string {
+  const d = event.data;
+  const parts: string[] = [];
+  if (d.from !== undefined || d.to !== undefined) {
+    parts.push(`${String(d.from ?? "∅")} → ${String(d.to ?? "∅")}`);
+  } else if (typeof d.status === "string") {
+    parts.push(d.status);
+  }
+  if (Array.isArray(d.workOrders)) parts.push(d.workOrders.join(", "));
+  if (typeof d.agent === "string" && d.agent) parts.push(d.agent);
+  if (typeof d.note === "string") parts.push(`“${d.note}”`);
+  if (typeof d.file === "string") parts.push(d.file);
+  if (typeof d.workspace === "string") parts.push(d.workspace);
+  return parts.join(" · ");
+}
+
+function actionClassName(action: string) {
+  if (action === "work_order.approved") return "font-medium text-success";
+  if (action === "work_order.done_without_approval") {
+    return "font-medium text-warning";
+  }
+  return "text-foreground";
+}
+
+export default function FactoryAuditLogRoute() {
+  const copy = useFactoryCopy();
+  const { i18n } = useTranslation("openhands");
+  const [searchParams, setSearchParams] = useSearchParams();
+  const filter = searchParams.get("q") ?? "";
+  const audit = useAuditLog();
+  const verify = useMutation({
+    mutationFn: FactoryApi.verifyAudit,
+    meta: { disableToast: true },
+  });
+
+  const events = React.useMemo(() => {
+    const all = audit.data ?? [];
+    const q = filter.trim().toLowerCase();
+    if (!q) return all;
+    return all.filter((e) =>
+      [e.subject, e.actor, e.action, copy.audit.actions[e.action] ?? ""]
+        .join(" ")
+        .toLowerCase()
+        .includes(q),
+    );
+  }, [audit.data, filter, copy]);
+
+  const setFilter = (value: string) => {
+    const next = new URLSearchParams(searchParams);
+    if (value) next.set("q", value);
+    else next.delete("q");
+    setSearchParams(next, { replace: true });
+  };
+
+  return (
+    <FactoryPage
+      testId="factory-audit-log"
+      title={copy.audit.title}
+      subtitle={copy.audit.subtitle}
+      error={audit.error}
+      onRetry={() => void audit.refetch()}
+      actions={
+        <BrandButton
+          testId="factory-verify-chain"
+          type="button"
+          variant="secondary"
+          onClick={() => verify.mutate()}
+          isDisabled={verify.isPending}
+          startContent={<ShieldCheck className="size-4" aria-hidden />}
+        >
+          {verify.isPending ? copy.audit.verifying : copy.audit.verify}
+        </BrandButton>
+      }
+    >
+      <div className="flex flex-col gap-4 px-6 py-5">
+        {verify.data ? (
+          <p
+            role="status"
+            data-testid="factory-verify-result"
+            className={cn(
+              "flex items-center gap-2 rounded-lg border px-3 py-2 text-sm",
+              verify.data.ok
+                ? "border-border-subtle text-foreground"
+                : "border-feedback-error text-feedback-error",
+            )}
+          >
+            {verify.data.ok ? (
+              <ShieldCheck className="size-4 text-success" aria-hidden />
+            ) : (
+              <ShieldAlert className="size-4" aria-hidden />
+            )}
+            {verify.data.ok
+              ? copy.audit.intact(verify.data.checked)
+              : copy.audit.broken(
+                  verify.data.brokenAt ?? 0,
+                  verify.data.reason ?? "",
+                )}
+          </p>
+        ) : null}
+        <FactoryError error={verify.error} />
+
+        <label className="flex max-w-md flex-col gap-1.5 text-sm text-muted">
+          {copy.audit.filterLabel}
+          <input
+            type="search"
+            data-testid="factory-audit-filter"
+            className={factoryFieldClassName}
+            placeholder={copy.audit.filterPlaceholder}
+            value={filter}
+            onChange={(e) => setFilter(e.target.value)}
+          />
+        </label>
+
+        {audit.isLoading ? <FactoryLoading /> : null}
+        {audit.data && events.length === 0 ? (
+          <p className="text-sm text-muted">{copy.audit.empty}</p>
+        ) : null}
+
+        {events.length > 0 ? (
+          <div className="overflow-x-auto rounded-xl border border-border-subtle">
+            <table className="w-full text-left text-sm">
+              <thead className="bg-surface text-xs text-muted">
+                <tr>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.seq}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.time}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.actor}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.action}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.subject}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.details}
+                  </th>
+                  <th scope="col" className="px-3 py-2 font-medium">
+                    {copy.audit.columns.hash}
+                  </th>
+                </tr>
+              </thead>
+              <tbody className="divide-y divide-border-subtle">
+                {events.map((e) => (
+                  <tr key={e.seq} className="align-top">
+                    <td className="px-3 py-2 font-mono text-xs tabular-nums text-muted">
+                      {e.seq}
+                    </td>
+                    <td className="whitespace-nowrap px-3 py-2 text-muted">
+                      <time dateTime={e.at}>
+                        {formatWhen(e.at, i18n.language)}
+                      </time>
+                    </td>
+                    <td className="whitespace-nowrap px-3 py-2 text-foreground">
+                      {actorName(e.actor)}
+                    </td>
+                    <td className={cn("px-3 py-2", actionClassName(e.action))}>
+                      {copy.audit.actions[e.action] ?? e.action}
+                      {e.action === "work_order.conversation_started" ||
+                      e.action === "change.conversation_started" ? (
+                        <>
+                          {" "}
+                          <Link
+                            to={`/conversations/${String(e.data.conversationId)}`}
+                            className="text-link hover:underline"
+                          >
+                            {copy.workOrders.openConversation}
+                          </Link>
+                        </>
+                      ) : null}
+                    </td>
+                    <td className="whitespace-nowrap px-3 py-2 font-mono text-xs">
+                      {WORK_ORDER_ID.test(e.subject) ? (
+                        <Link
+                          to={`/work-orders/${e.subject}`}
+                          className="text-link hover:underline"
+                        >
+                          {e.subject}
+                        </Link>
+                      ) : (
+                        <span className="text-muted">{e.subject}</span>
+                      )}
+                    </td>
+                    <td className="max-w-sm break-words px-3 py-2 text-xs text-muted">
+                      {summarize(e)}
+                    </td>
+                    <td
+                      className="px-3 py-2 font-mono text-xs text-muted"
+                      title={e.hash}
+                    >
+                      {e.hash.slice(0, 10)}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        ) : null}
+      </div>
+    </FactoryPage>
+  );
+}
