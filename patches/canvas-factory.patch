+function serveInbox() {
+  const decisions: unknown[] = [];
+  server.use(
+    http.get("*/sf-api/autopilot/inbox/count", () =>
+      HttpResponse.json({ open: 2 }),
+    ),
+    http.get("*/sf-api/autopilot/inbox", () => HttpResponse.json([item])),
+    http.get("*/sf-api/autopilot/runs", () => HttpResponse.json([])),
+    http.post("*/sf-api/autopilot/inbox/7/decide", async ({ request }) => {
+      decisions.push(await request.json());
+      return HttpResponse.json({ ...item, state: "decided" });
+    }),
+  );
+  return decisions;
+}
